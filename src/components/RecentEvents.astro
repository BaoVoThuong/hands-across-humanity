---
/**
 * Dated proof that the work is happening, read from the same events sheet as
 * the Events page. Only what the sheet records is shown — date, title, venue,
 * place — so nothing here can claim more than the record does.
 */
import { formatDate, type EventRow } from '../lib/events';

interface Props {
  events: EventRow[];
}

const { events } = Astro.props;
const where = (e: EventRow) =>
  [e.venue, e.city && e.state ? `${e.city}, ${e.state}` : e.city].filter(Boolean).join(' · ');
---

{events.length > 0 && (
  <ul class="recent-events" role="list">
    {events.map((e: EventRow) => (
      <li class="recent-events__item">
        {/* A calendar tile for scanning; the full date below is what is read out. */}
        <span class="recent-events__cal" aria-hidden="true">
          <span class="recent-events__cal-month">{formatDate(e.date).month}</span>
          <span class="recent-events__cal-day">{formatDate(e.date).day}</span>
        </span>
        <span class="recent-events__info">
          <time class="recent-events__date" datetime={e.date}>{formatDate(e.date).full}</time>
          <span class="recent-events__title">{e.title}</span>
          {where(e) && <span class="recent-events__where">{where(e)}</span>}
        </span>
      </li>
    ))}
  </ul>
)}
