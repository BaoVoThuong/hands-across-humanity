---
/**
 * The "at a glance" row of an inner-page hero. Each hero variant places it
 * somewhere different (on the photo, beside it, floating over it, or inside
 * the copy column) — see .page-intro--* in src/styles/polish.css.
 */
export type SignalIcon =
  | 'people' | 'box' | 'handshake' | 'book' | 'heart' | 'home'
  | 'network' | 'pin' | 'calendar' | 'camera';

export interface HeroSignal {
  title: string;
  text: string;
  icon?: SignalIcon;
}

interface Props {
  signals: HeroSignal[];
  class?: string;
}

const { signals, class: className } = Astro.props;

// 24×24 stroke icons, drawn to match the site's 2px line weight.
const ICONS: Record<SignalIcon, string> = {
  people: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><circle cx="17" cy="9.5" r="2.5"/><path d="M15.5 14.6a4.5 4.5 0 0 1 5 4.9"/>',
  box: '<path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>',
  handshake: '<path d="m3 11 4-4 3 1 2-1 3 1 4 3"/><path d="m3 11 6 6a1.5 1.5 0 0 0 2.1 0l.4-.4m-4.3-2.3 2.6 2.6m-.8-4.8 3.3 3.3a1.5 1.5 0 0 0 2.1-2.1L13 10.4"/><path d="M21 10l-2.5 2.5"/>',
  book: '<path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5"/>',
  heart: '<path d="M12 20s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 7.3 4.3 4.3 0 0 1 19.5 10c0 5.6-7.5 10-7.5 10z"/>',
  home: '<path d="m3.5 11 8.5-7 8.5 7"/><path d="M6 9.5V20h12V9.5"/><path d="M10 20v-5h4v5"/>',
  network: '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="18" r="2.2"/><circle cx="19" cy="18" r="2.2"/><path d="M10.9 7 6.1 16m6.9-9 4.9 9M7.2 18h9.6"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
  camera: '<path d="M4 8h3l1.6-2.5h6.8L17 8h3v11H4z"/><circle cx="12" cy="13.2" r="3.4"/>',
};
---

{signals.length > 0 && (
  <ul class:list={['page-intro__signals', className]} aria-label="At a glance" role="list">
    {signals.map((signal: HeroSignal) => (
      <li class="page-intro__signal reveal">
        {signal.icon && (
          <span class="page-intro__signal-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={ICONS[signal.icon as SignalIcon]} />
          </span>
        )}
        <span class="page-intro__signal-copy">
          <span class="page-intro__signal-title">{signal.title}</span>
          <span class="page-intro__signal-text">{signal.text}</span>
        </span>
      </li>
    ))}
  </ul>
)}
