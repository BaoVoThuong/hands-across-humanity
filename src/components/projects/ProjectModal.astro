---
---

<div class="modal-overlay" id="project-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-dialog">
    <div class="modal-header">
      <div>
        <div class="modal-audit-verification">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Community support details</span>
        </div>
        <h3 id="modal-title" style="margin-top: 0.35rem;">Project Details</h3>
        <p id="modal-location" style="font-size: 0.8125rem; color: var(--primary); font-weight: 600; display: flex; align-items: center; gap: 0.35rem;">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span id="modal-location-text">Location</span>
        </p>
      </div>
        <button type="button" class="modal-close-btn" id="modal-close" aria-label="Close project details dialog">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="modal-body">
      <div>
        <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--slate-500);">Community partner</p>
        <p id="modal-partner" style="font-weight: 600; color: var(--slate-800); margin-top: 0.25rem;">Partner</p>
      </div>
      <div>
        <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--slate-500);">Project overview</p>
        <p id="modal-details" style="font-size: 0.9375rem; color: var(--slate-700); margin-top: 0.25rem; line-height: 1.6;">Scope details...</p>
      </div>
      <div style="background: var(--surface-alt); padding: 1rem; border-radius: var(--radius-md); border: 1px solid var(--border);">
        <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--slate-500);">Support details</p>
        <p id="modal-impact" style="font-weight: 600; color: var(--slate-900); margin-top: 0.25rem;">Impact</p>
        <p id="modal-funding" style="font-size: 0.875rem; color: var(--slate-600); margin-top: 0.5rem;">Support progress...</p>
      </div>
      <div style="display: flex; gap: 1rem; justify-content: flex-end;">
        <button type="button" class="btn btn--ghost" id="modal-dismiss">Return to projects</button>
        <a href="#donate" class="btn btn--primary" id="modal-donate-cta">Support this work <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</div>

<script>
  // Project Detail Modal Script (Hardened A11y & Focus Lock)
  const modalOverlay = document.getElementById('project-modal');
  const openModalBtns = document.querySelectorAll<HTMLElement>('.open-modal-btn');
  const closeModalBtn = document.getElementById('modal-close');
  const dismissModalBtn = document.getElementById('modal-dismiss');
  const modalDonateCta = document.getElementById('modal-donate-cta');

  const modalTitle = document.getElementById('modal-title');
  const modalPartner = document.getElementById('modal-partner');
  const modalDetails = document.getElementById('modal-details');
  const modalImpact = document.getElementById('modal-impact');
  const modalFunding = document.getElementById('modal-funding');

  let lastActiveTrigger: HTMLElement | null = null;

  const closeModal = () => {
    if (!modalOverlay) return;
    modalOverlay.classList.remove('is-open');
    modalOverlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (lastActiveTrigger && typeof lastActiveTrigger.focus === 'function') {
      lastActiveTrigger.focus();
    }
  };

  openModalBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!modalOverlay) return;
      lastActiveTrigger = btn;
      
      const title = btn.getAttribute('data-title') || '';
      const location = btn.getAttribute('data-location') || '';
      const partner = btn.getAttribute('data-partner') || '';
      const details = btn.getAttribute('data-details') || '';
      const impact = btn.getAttribute('data-impact') || '';
      const raised = btn.getAttribute('data-raised') || '';
      const goal = btn.getAttribute('data-goal') || '';
      const progress = btn.getAttribute('data-progress') || '';

      const modalLocationText = document.getElementById('modal-location-text');
      if (modalTitle) modalTitle.textContent = title;
      if (modalLocationText) modalLocationText.textContent = location;
      if (modalPartner) modalPartner.textContent = partner;
      if (modalDetails) modalDetails.textContent = details;
      if (modalImpact) modalImpact.textContent = `Impact: ${impact}`;
      if (modalFunding) modalFunding.textContent = `Support status: ${raised} raised of ${goal} (${progress}% completed)`;

      modalOverlay.classList.add('is-open');
      modalOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      
      requestAnimationFrame(() => {
        closeModalBtn?.focus();
      });
    });
  });

  closeModalBtn?.addEventListener('click', closeModal);
  dismissModalBtn?.addEventListener('click', closeModal);
  modalDonateCta?.addEventListener('click', closeModal);

  modalOverlay?.addEventListener('click', (e) => {
    if (e.target === modalOverlay) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (!modalOverlay?.classList.contains('is-open')) return;

    if (e.key === 'Escape') {
      closeModal();
      return;
    }

    if (e.key === 'Tab') {
      const focusables = modalOverlay.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
      if (focusables.length === 0) return;

      const firstEl = focusables[0];
      const lastEl = focusables[focusables.length - 1];

      if (e.shiftKey && document.activeElement === firstEl) {
        e.preventDefault();
        lastEl.focus();
      } else if (!e.shiftKey && document.activeElement === lastEl) {
        e.preventDefault();
        firstEl.focus();
      }
    }
  });
</script>
