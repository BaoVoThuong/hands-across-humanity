---
import { Picture } from 'astro:assets';

export interface ProjectImage {
  src: ImageMetadata;
  alt: string;
}

export interface ProjectData {
  id: string;
  title: string;
  category: string;
  location: string;
  images: ProjectImage[];
  progress: number;
  raised: string;
  goal: string;
  impact: string;
  auditPartner: string;
  details: string;
}

interface Props {
  project: ProjectData;
  index: number;
}

const { project, index } = Astro.props;
---

<div class="project-card" data-category={project.category} data-index={index}>
  <div class="project-card__media">
    <div class="project-card__carousel" data-carousel>
      {project.images.map((img, imgIdx) => (
        <div class={`carousel__slide ${imgIdx === 0 ? 'is-active' : ''}`} data-index={imgIdx}>
          <Picture
            src={img.src}
            widths={[400, 600, 800]}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={75}
            alt={img.alt}
            loading="lazy"
          />
        </div>
      ))}
      {project.images.length > 1 && (
        <>
          <button type="button" class="carousel__arrow carousel__arrow--prev" aria-label="Previous photo">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button type="button" class="carousel__arrow carousel__arrow--next" aria-label="Next photo">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <div class="carousel__dots" role="tablist" aria-label="Project field photos">
            {project.images.map((_, dotIdx) => (
              <button type="button" class={`carousel__dot ${dotIdx === 0 ? 'is-active' : ''}`} data-index={dotIdx} aria-label={`View photo ${dotIdx + 1}`}></button>
            ))}
          </div>
        </>
      )}
    </div>
  </div>
  <div class="project-card__body">
    <div class="project-card__content">
      <div class="project-card__meta-header">
        <span class="project-card__category" data-category={project.category}>{project.category}</span>
        <span class="project-card__meta-dot" aria-hidden="true">•</span>
        <span class="project-card__location" title={project.location}>
          <svg class="icon-location" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="project-card__location-text">{project.location}</span>
        </span>
      </div>
      <h3>{project.title}</h3>
      <p class="project-card__impact">{project.impact}</p>
    </div>
    <div class="project-card__footer">
      <div class="project-card__funding-meta">
        <span>Raised: {project.raised}</span>
        <span>Goal: {project.goal} ({project.progress}%)</span>
      </div>
      <div class="project-card__progress-track">
        <div class="project-card__progress-bar" style={`width: ${project.progress}%`}></div>
      </div>
      <div class="project-card__actions">
        <a href="#donate" class="btn btn--primary">Support →</a>
        <button
          type="button"
          class="btn btn--ghost open-modal-btn"
          data-title={project.title}
          data-category={project.category}
          data-location={project.location}
          data-impact={project.impact}
          data-partner={project.auditPartner}
          data-details={project.details}
          data-raised={project.raised}
          data-goal={project.goal}
          data-progress={project.progress}
        >
          Details & support
        </button>
      </div>
    </div>
  </div>
</div>
