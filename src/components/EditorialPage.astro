---
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Panel from '../components/Panel.astro';

interface RailItem { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  activePage: string;
  eyebrow: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  nextHref: string;
  nextLabel: string;
  quote?: string;
  sections: RailItem[];
  total: number;
}

const {
  title, description, activePage, eyebrow, lead,
  image, imageAlt, caption, nextHref, nextLabel, quote, sections, total
} = Astro.props;

const onThisPage = sections.slice(1);
const firstSection = onThisPage[0];
const heroSignals = [
  {
    title: 'Local leadership',
    text: 'People closest to the work help decide what is safe, possible and still needed.',
  },
  {
    title: 'Practical support',
    text: 'Clean water, shelter, medical care and safe learning spaces make the next day possible.',
  },
  {
    title: 'Staying power',
    text: 'Recovery and self-reliance remain part of the work after the headline changes.',
  },
];
---

<SiteLayout
  title={`${title} | Hands Across Humanity`}
  description={description}
  activePage={activePage}
>
  <main id="main">
    <!-- Page Hero -->
    <Panel id="top" ground="paper" index={1} total={total} label={eyebrow} labelledby="page-title" nextId={firstSection?.id} nextLabel={firstSection?.label} hero={true}>
      <div class="page-hero__grid">
        <div class="page-hero__copy">
          <p class="page-hero__kicker reveal" style="--i:1;">{eyebrow}</p>
          <h1 class="reveal page-hero__title" style="--i:2;" id="page-title">{title}</h1>
          <p class="lead reveal page-hero__lead" style="--i:3;">{lead}</p>

          <div class="btn-row reveal page-hero__actions" style="--i:4;">
            {firstSection && (
              <a class="btn btn--primary" href={`#${firstSection.id}`}>
                {firstSection.label}<span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            )}
            <a class="btn btn--secondary" href="/#donate">Support Our Mission</a>
          </div>

          {onThisPage.length > 0 && (
            <nav class="reveal page-hero__subnav" style="--i:5;" aria-label="On this page navigation">
              <p class="page-hero__subnav-title">On this page</p>
              <div class="page-hero__subnav-items">
                {onThisPage.map((section: RailItem) => (
                  <a href={`#${section.id}`} class="page-hero__nav-link">
                    {section.label}
                  </a>
                ))}
              </div>
            </nav>
          )}
        </div>

        <figure class="page-hero__figure reveal" style="--i:5;">
          <div class="page-hero__media">
            <Picture
              src={image}
              widths={[600, 900, 1200]}
              sizes="(min-width: 940px) 50vw, 92vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={75}
              alt={imageAlt}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="page-hero__caption">
            <span class="page-hero__caption-num">FIG 01</span>
            <span class="page-hero__caption-sep" aria-hidden="true">|</span>
            <span class="page-hero__caption-text">{caption}</span>
          </figcaption>
        </figure>
      </div>

      <div class="page-hero__signals reveal" style="--i:6;" aria-label="How we work">
        {heroSignals.map((signal) => (
          <div class="page-hero__signal">
            <p class="page-hero__signal-title">{signal.title}</p>
            <p class="page-hero__signal-text">{signal.text}</p>
          </div>
        ))}
      </div>
    </Panel>

    <slot />

    <!-- Bottom Page Navigation / Authentic Journal Transition -->
    <section class="chapter-transition chapter-transition--warm" id="next-chapter">
      <div class="container-narrow">
        <blockquote class="chapter-transition__quote">
          {quote || "“Help reaches people through people who are already there.”"}
        </blockquote>
        
        <div class="chapter-transition__footer">
          <span class="chapter-transition__meta">Next Chapter</span>
          <h2 class="chapter-transition__title">{nextLabel}</h2>
          <a class="btn btn--primary chapter-transition__btn" href={nextHref}>
            Read Chapter <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <script>
    function setupSubnavObserver() {
      const links = document.querySelectorAll<HTMLAnchorElement>('.page-hero__nav-link');
      if (!links.length) return;

      const sectionMap = new Map<Element, HTMLAnchorElement>();
      links.forEach(link => {
        const hash = link.getAttribute('href');
        if (hash && hash.startsWith('#')) {
          const target = document.querySelector(hash);
          if (target) sectionMap.set(target, link);
        }
      });

      if (!sectionMap.size) return;

      // Remove any initial active class if we are near the top of the page
      function checkActive() {
        if (window.scrollY < 200) {
          links.forEach(l => l.classList.remove('is-active'));
        }
      }
      checkActive();

      const observer = new IntersectionObserver((entries) => {
        if (window.scrollY < 200) {
          links.forEach(l => l.classList.remove('is-active'));
          return;
        }
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            links.forEach(l => l.classList.remove('is-active'));
            const activeLink = sectionMap.get(entry.target);
            if (activeLink) activeLink.classList.add('is-active');
          }
        });
      }, {
        rootMargin: '-30% 0px -50% 0px',
        threshold: 0
      });

      sectionMap.forEach((_, section) => observer.observe(section));
      window.addEventListener('scroll', checkActive, { passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupSubnavObserver);
    } else {
      setupSubnavObserver();
    }
    document.addEventListener('astro:page-load', setupSubnavObserver);
  </script>
</SiteLayout>
