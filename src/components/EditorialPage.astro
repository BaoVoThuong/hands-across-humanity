---
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Panel from '../components/Panel.astro';

interface RailItem { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  activePage: string;
  eyebrow: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  nextHref: string;
  nextLabel: string;
  quote?: string;
  sections: RailItem[];
  total: number;
}

const {
  title, description, activePage, eyebrow, lead,
  image, imageAlt, caption, nextHref, nextLabel, quote, sections, total
} = Astro.props;

const onThisPage = sections.slice(1);
const firstSection = onThisPage[0];
const heroSignals = [
  {
    title: 'Local leadership',
    text: 'People closest to the work help decide what is safe, possible and still needed.',
  },
  {
    title: 'Practical support',
    text: 'Health, hygiene, household, and education essentials make a difficult day more manageable.',
  },
  {
    title: 'Staying power',
    text: 'Local relationships keep support grounded after the urgent moment has passed.',
  },
];
---

<SiteLayout
  title={`${title} | Hands Across Humanity`}
  description={description}
  activePage={activePage}
>
  <main id="main">
    <!-- Page Hero -->
    <Panel id="top" ground="paper" index={1} total={total} label={eyebrow} labelledby="page-title" nextId={firstSection?.id} nextLabel={firstSection?.label} hero={true}>
      <div class="page-hero__grid page-hero__grid--field">
        <div class="page-hero__copy">
          <p class="page-hero__kicker reveal" style="--i:1;">{eyebrow}</p>
          <h1 class="reveal page-hero__title" style="--i:2;" id="page-title">{title}</h1>
          <p class="lead reveal page-hero__lead" style="--i:3;">{lead}</p>

          <div class="btn-row reveal page-hero__actions" style="--i:4;">
            {firstSection && (
              <a class="btn btn--primary" href={`#${firstSection.id}`}>
                {firstSection.label}<span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            )}
            <a class="btn btn--secondary" href="/#donate">Support Our Mission</a>
          </div>

        </div>

        <figure class="page-hero__figure page-hero__figure--field reveal" style="--i:5;">
          <div class="page-hero__media">
            <Picture
              src={image}
              widths={[600, 900, 1200]}
              sizes="(min-width: 940px) 50vw, 92vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={75}
              alt={imageAlt}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="page-hero__caption">
            <span class="page-hero__caption-text">{caption}</span>
          </figcaption>
        </figure>
      </div>

      <div class="page-hero__signals reveal" style="--i:6;" aria-label="How we work">
        {heroSignals.map((signal) => (
          <div class="page-hero__signal">
            <p class="page-hero__signal-title">{signal.title}</p>
            <p class="page-hero__signal-text">{signal.text}</p>
          </div>
        ))}
      </div>
    </Panel>

    <slot />

    <!-- Bottom page navigation -->
    <section class="chapter-transition chapter-transition--warm" id="next-chapter">
      <div class="container-narrow">
        <blockquote class="chapter-transition__quote">
          {quote || "“Help reaches people through people who are already there.”"}
        </blockquote>
        
        <div class="chapter-transition__footer">
          <span class="chapter-transition__meta">Next Chapter</span>
          <h2 class="chapter-transition__title">{nextLabel}</h2>
          <a class="btn btn--primary chapter-transition__btn" href={nextHref}>
            Read Chapter <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

  </main>

</SiteLayout>
