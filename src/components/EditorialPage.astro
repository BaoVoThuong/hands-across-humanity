---
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import DeferredPicture from '../components/DeferredPicture.astro';
import HeroSignals, { type HeroSignal } from '../components/HeroSignals.astro';
import { pageOf, nextPage } from '../lib/pages';

interface RailItem { id: string; label: string; }
interface GalleryItem { src: ImageMetadata; alt: string; }
/**
 * Each inner page opens differently, so the four pages stop reading as one
 * template with the words swapped:
 *   immersive — the photo fills the screen, words sit on a dark scrim (Mission)
 *   split     — words on white beside a tall photo (Work)
 *   statement — a centred headline over a wide cinematic photo (Vision)
 *   mosaic    — words beside a three-photo collage, needs `gallery` (Events)
 */
type HeroVariant = 'immersive' | 'split' | 'statement' | 'mosaic';
interface Props {
  title: string;
  description: string;
  activePage: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  heroSignals?: HeroSignal[];
  heroVariant?: HeroVariant;
  /** Two supporting photos for the mosaic hero. */
  gallery?: GalleryItem[];
  sections: RailItem[];
  total: number;
}

const {
  title, description, activePage, lead,
  image, imageAlt, caption,
  heroSignals = [
    {
      title: 'Local leadership',
      text: 'People closest to the work help decide what is safe, possible and still needed.',
    },
    {
      title: 'Practical support',
      text: 'Health, hygiene, household, and education essentials make a difficult day more manageable.',
    },
    {
      title: 'Staying power',
      text: 'Local relationships keep support grounded after the urgent moment has passed.',
    },
  ],
  heroVariant = 'split',
  gallery = [],
  sections,
}: Props = Astro.props;

const variant: HeroVariant = heroVariant === 'mosaic' && gallery.length < 2 ? 'split' : heroVariant;
const signalsInCopy = variant === 'split';
const heroSizes = {
  immersive: '100vw',
  split: '(min-width: 900px) 58vw, 100vw',
  statement: '(min-width: 1400px) 82rem, 94vw',
  mosaic: '(min-width: 900px) 34vw, 94vw',
}[variant];

/* The chain used to be retyped on every page, so it drifted: Mission pointed
   forward twice under two names, Events had no way back, and Vision offered
   the same link with the same words in two places. Both ends now come from
   the reading order in one place, and cannot disagree with the nav. */
const here = pageOf(activePage);
const next = nextPage(activePage);

const onThisPage = sections.slice(1);
const firstSection = onThisPage[0];
---

<SiteLayout
  title={here?.documentTitle ?? title}
  description={description}
  activePage={activePage}
>
  <main id="main">
    <!-- Page hero: one shared structure, arranged per variant in polish.css -->
    <section class:list={['page-intro', `page-intro--${variant}`]} id="top" aria-labelledby="page-title">
      <div class="page-intro__stage">
        <div class="page-intro__copy">
          <h1 class="page-intro__title reveal" style="--i:2;" id="page-title">{title}</h1>
          <p class="page-intro__lead reveal" style="--i:3;">{lead}</p>
          <div class="page-intro__actions reveal" style="--i:4;">
            {firstSection && (
              <a class="btn btn--primary" href={`#${firstSection.id}`}>
                {firstSection.label}<span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            )}
            <a class="btn btn--secondary" href={next.href}>{next.cta}</a>
          </div>
          {/* On Work the signals fill the words' column, so it is no shorter than
              the photo; elsewhere they run in a row under the hero. */}
          {signalsInCopy && <HeroSignals signals={heroSignals} />}
        </div>

        <figure class="page-intro__figure">
          <div class="page-intro__media">
            <Picture
              src={image}
              widths={variant === 'mosaic' ? [500, 800, 1100] : [800, 1200, 1600, 2048]}
              sizes={heroSizes}
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={72}
              alt={imageAlt}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="page-intro__caption">{caption}</figcaption>
        </figure>

        {variant === 'mosaic' && (
          <div class="page-intro__mosaic">
            {gallery.slice(0, 2).map((item) => (
              <div class="page-intro__tile">
                <DeferredPicture src={item.src} alt={item.alt} widths={[400, 700]} sizes="(min-width: 900px) 22vw, 46vw" />
              </div>
            ))}
          </div>
        )}
      </div>

      {!signalsInCopy && <HeroSignals signals={heroSignals} />}
    </section>

    <slot />

    <!-- Bottom page navigation: one quiet row, not another coloured band -->
    <nav class="next-page" aria-label="Next page">
      <a class="next-page__link container" href={next.href}>
        <span class="next-page__meta">Up next</span>
        <span class="next-page__title">{next.cta}</span>
        <span class="next-page__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </span>
      </a>
    </nav>

  </main>

</SiteLayout>
