---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Panel from '../components/Panel.astro';

interface RailItem { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  activePage: string;
  eyebrow: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  nextHref: string;
  nextLabel: string;
  quote?: string;
  sections: RailItem[];
  total: number;
}

const {
  title, description, activePage, eyebrow, lead,
  image, imageAlt, caption, nextHref, nextLabel, quote, sections, total
} = Astro.props;

const onThisPage = sections.slice(1);
const firstSection = onThisPage[0];
---

<SiteLayout
  title={`${title} | Hands Across Humanity`}
  description={description}
  activePage={activePage}
>
  <main id="main">
    <!-- Page Hero -->
    <Panel id="top" ground="paper" index={1} total={total} label={eyebrow} labelledby="page-title" nextId={firstSection?.id} nextLabel={firstSection?.label} hero={true}>
      <div class="page-hero__grid">
        <div class="page-hero__copy">
          <h1 class="reveal page-hero__title" style="--i:1;" id="page-title">{title}</h1>
          <p class="lead reveal page-hero__lead" style="--i:2;">{lead}</p>

          <div class="btn-row reveal page-hero__actions" style="--i:3;">
            {firstSection && (
              <a class="btn btn--primary" href={`#${firstSection.id}`}>
                {firstSection.label}<span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            )}
            <a class="btn btn--secondary" href="/#donate">Support Our Mission</a>
          </div>

          {onThisPage.length > 0 && (
            <nav class="reveal page-hero__subnav" style="--i:4;" aria-label="On this page navigation">
              <p class="page-hero__subnav-title">On this page</p>
              <div class="page-hero__subnav-items">
                {onThisPage.map((section, i) => (
                  <a href={`#${section.id}`} class="page-hero__nav-link">
                    <span class="page-hero__nav-num">0{i + 2}</span> {section.label}
                  </a>
                ))}
              </div>
            </nav>
          )}
        </div>

        <figure class="page-hero__figure reveal" style="--i:5;">
          <div class="page-hero__media">
            <Picture
              src={image}
              widths={[600, 900, 1200]}
              sizes="(min-width: 940px) 50vw, 92vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={75}
              alt={imageAlt}
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="page-hero__caption">
            <span class="page-hero__caption-num">FIG 01</span>
            <span class="page-hero__caption-sep" aria-hidden="true">|</span>
            <span class="page-hero__caption-text">{caption}</span>
          </figcaption>
        </figure>
      </div>
    </Panel>

    <slot />

    <!-- Bottom Page Navigation / Authentic Journal Transition -->
    <section class="chapter-transition chapter-transition--dark" id="next-chapter">
      <div class="container-narrow">
        <blockquote class="chapter-transition__quote">
          {quote || "“Help reaches people through people who are already there.”"}
        </blockquote>
        
        <div class="chapter-transition__footer">
          <span class="chapter-transition__meta">Next Chapter</span>
          <h2 class="chapter-transition__title">{nextLabel}</h2>
          <a class="btn btn--primary chapter-transition__btn" href={nextHref}>
            Read Chapter <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

  </main>
</SiteLayout>
