---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Panel from '../components/Panel.astro';

interface RailItem { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  activePage: string;
  eyebrow: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  nextHref: string;
  nextLabel: string;
  sections: RailItem[];
  total: number;
}


const {
  title, description, activePage, eyebrow, lead,
  image, imageAlt, caption, nextHref, nextLabel, sections, total
} = Astro.props;

const onThisPage = sections.slice(1);
const firstSection = onThisPage[0];

---

<SiteLayout
  title={`${title} | Hands Across Humanity`}
  description={description}
  activePage={activePage}
  sections={sections}
>
  <main id="main">
    <!-- Page hero -->
    <Panel id="top" ground="paper" index={1} total={total} label={eyebrow} labelledby="page-title" nextId={firstSection?.id} nextLabel={firstSection?.label}>
      <div class="page-hero__grid">
        <div class="page-hero__copy">
          <p class="eyebrow reveal">{eyebrow}</p>
          <h1 class="reveal" style="--i:1" id="page-title">{title}</h1>
          <p class="lead reveal" style="--i:2">{lead}</p>

          <div class="btn-row reveal" style="--i:3">
            {firstSection && (
              <a class="btn btn--donate" href={`#${firstSection.id}`}>
                {firstSection.label}<span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            )}
            <a class="btn btn--ghost" href="/#donate">Donate</a>
          </div>

          <nav class="toc reveal" style="--i:4" aria-label="On this page">
            <p class="toc__label">On this page</p>
            <ol>
              {onThisPage.map((section, i) => (
                <li>
                  <a href={`#${section.id}`}><span>{String(i + 2).padStart(2, '0')}</span>{section.label}</a>
                </li>
              ))}
            </ol>
          </nav>
        </div>

        <figure class="page-hero__media reveal" style="--i:5">
          <Picture
            src={image}
            widths={[600, 900, 1200, 1400]}
            sizes="(min-width: 940px) 52vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={62}
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>{caption}</figcaption>
        </figure>
      </div>
    </Panel>

    <slot />

    <!-- Next -->
  </main>
</SiteLayout>
