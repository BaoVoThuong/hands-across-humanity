---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Panel from '../components/Panel.astro';

interface RailItem { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  activePage: string;
  eyebrow: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  nextHref: string;
  nextLabel: string;
  sections: RailItem[];
  total: number;
}

const {
  title, description, activePage, eyebrow, lead,
  image, imageAlt, caption, nextHref, nextLabel, sections, total
} = Astro.props;

const onThisPage = sections.slice(1);
const firstSection = onThisPage[0];
---

<SiteLayout
  title={`${title} | Hands Across Humanity`}
  description={description}
  activePage={activePage}
>
  <main id="main">
    <!-- Page Hero -->
    <Panel id="top" ground="paper" index={1} total={total} label={eyebrow} labelledby="page-title" nextId={firstSection?.id} nextLabel={firstSection?.label}>
      <div class="page-hero__grid">
        <div class="page-hero__copy">
          <span class="badge badge--primary reveal">{eyebrow}</span>
          <h1 class="reveal" style="--i:1; margin-top: 0.5rem;" id="page-title">{title}</h1>
          <p class="lead reveal" style="--i:2">{lead}</p>

          <div class="btn-row reveal" style="--i:3; margin-top: 1.25rem;">
            {firstSection && (
              <a class="btn btn--primary" href={`#${firstSection.id}`}>
                {firstSection.label}<span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            )}
            <a class="btn btn--secondary" href="/#donate">Support Our Mission</a>
          </div>

          {onThisPage.length > 0 && (
            <nav class="reveal" style="--i:4; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border);" aria-label="On this page navigation">
              <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--slate-500); margin-bottom: 0.5rem;">On this page</p>
              <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
                {onThisPage.map((section, i) => (
                  <a href={`#${section.id}`} class="badge badge--dark" style="background: var(--surface); color: var(--slate-700); text-transform: none; font-size: 0.8125rem; border: 1px solid var(--border);">
                    <span style="color: var(--primary); font-weight: 700;">0{i + 2}</span> {section.label}
                  </a>
                ))}
              </div>
            </nav>
          )}
        </div>

        <figure class="page-hero__media reveal" style="--i:5; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);">
          <Picture
            src={image}
            widths={[600, 900, 1200]}
            sizes="(min-width: 940px) 50vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={75}
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption style="padding: 0.75rem 1rem; font-size: 0.8125rem; color: var(--slate-600); background: var(--surface-alt); border-top: 1px solid var(--border);">{caption}</figcaption>
        </figure>
      </div>
    </Panel>

    <slot />

    <!-- Bottom Page Navigation -->
    <section class="section section--dark" style="text-align: center;">
      <div class="container-narrow">
        <span class="badge badge--dark">Next Chapter</span>
        <h2 style="color: #FFFFFF; margin-block: 0.75rem 1.5rem;">Continue Reading</h2>
        <a class="btn btn--primary" href={nextHref} style="font-size: 1.125rem; padding-inline: 2rem;">
          {nextLabel}<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

  </main>
</SiteLayout>
