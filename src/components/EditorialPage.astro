---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import Panel from '../components/Panel.astro';

interface RailItem { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  activePage: string;
  eyebrow: string;
  lead: string;
  image: ImageMetadata;
  imageAlt: string;
  caption: string;
  nextHref: string;
  nextLabel: string;
  sections: RailItem[];
  total: number;
}

const {
  title, description, activePage, eyebrow, lead,
  image, imageAlt, caption, nextHref, nextLabel, sections, total
} = Astro.props;

const onThisPage = sections.slice(1);
const firstSection = onThisPage[0];
---

<SiteLayout
  title={`${title} | Hands Across Humanity`}
  description={description}
  activePage={activePage}
>
  <main id="main">
    <!-- Page Hero -->
    <Panel id="top" ground="paper" index={1} total={total} label={eyebrow} labelledby="page-title" nextId={firstSection?.id} nextLabel={firstSection?.label} hero={true}>
      <div class="page-hero__grid">
        <div class="page-hero__copy">
          <h1 class="reveal page-hero__title" style="--i:1;" id="page-title">{title}</h1>
          <p class="lead reveal page-hero__lead" style="--i:2;">{lead}</p>

          <div class="btn-row reveal page-hero__actions" style="--i:3;">
            {firstSection && (
              <a class="btn btn--primary" href={`#${firstSection.id}`}>
                {firstSection.label}<span class="btn__arrow" aria-hidden="true">↓</span>
              </a>
            )}
            <a class="btn btn--secondary" href="/#donate">Support Our Mission</a>
          </div>

          {onThisPage.length > 0 && (
            <nav class="reveal page-hero__subnav" style="--i:4;" aria-label="On this page navigation">
              <p class="page-hero__subnav-title">On this page</p>
              <div class="page-hero__subnav-items">
                {onThisPage.map((section, i) => (
                  <a href={`#${section.id}`} class="page-hero__nav-link">
                    <span class="page-hero__nav-num">0{i + 2}</span> {section.label}
                  </a>
                ))}
              </div>
            </nav>
          )}
        </div>

        <figure class="page-hero__media reveal" style="--i:5;">
          <Picture
            src={image}
            widths={[600, 900, 1200]}
            sizes="(min-width: 940px) 50vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={75}
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="page-hero__caption">{caption}</figcaption>
        </figure>
      </div>
    </Panel>

    <slot />

    <!-- Bottom Page Navigation -->
    <section class="section section--dark" style="text-align: center; border-top: 1px solid var(--border-warm); background: linear-gradient(180deg, var(--slate-900) 0%, #090D16 100%);">
      <div class="container-narrow">
        <span class="badge badge--dark" style="border-color: rgba(255, 255, 255, 0.25);">Next Chapter</span>
        <h2 style="color: #FFFFFF; margin-block: 0.75rem 1.5rem;">Continue Reading</h2>
        <a class="btn btn--primary" href={nextHref} style="font-size: 1.125rem; padding-inline: 2rem;">
          {nextLabel}<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </section>

  </main>
</SiteLayout>
