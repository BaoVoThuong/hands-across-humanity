---
/**
 * Sign-up form. Posts to an Apps Script endpoint that appends to the
 * `attendance` tab.
 *
 * Without an endpoint configured the form does not render at all and the
 * contact fallback is shown instead. A form that cannot submit is worse than
 * no form: it collects someone's details and drops them.
 */
const endpoint = import.meta.env.PUBLIC_ATTENDANCE_ENDPOINT ?? '';
const contactEmail = 'info@handsacrosshumanity.org';
---

<dialog class="join-dialog" id="join-dialog" aria-labelledby="join-title">
  <form method="dialog" class="join-dialog__close-form">
    <button class="join-dialog__close" value="cancel" aria-label="Close">&times;</button>
  </form>

  <h2 class="join-dialog__title" id="join-title">Join us at this event</h2>
  <p class="join-dialog__event" data-join-summary></p>
  <p class="join-dialog__note">
    Hosted by another organisation — telling us you are coming helps us plan.
  </p>

  {endpoint ? (
    <form class="join-form" data-join-form novalidate>
      <input type="hidden" name="event_title" data-field-title />
      <input type="hidden" name="event_date" data-field-date />

      {/* Honeypot: hidden from sight and from assistive technology. */}
      <div class="join-form__trap" aria-hidden="true">
        <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="join-form__row join-form__row--3">
        <label class="join-field">
          <span>Your name <b aria-hidden="true">*</b></span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="join-field">
          <span>Email <b aria-hidden="true">*</b></span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="join-field">
          <span>Phone</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
      </div>

      <div class="join-form__row join-form__row--3">
        <label class="join-field">
          <span>Organisation</span>
          <input type="text" name="organization" autocomplete="organization"
            placeholder="Optional" />
        </label>
        <label class="join-field">
          <span>Coming as</span>
          <span class="join-select" data-join-select>
            <select name="org_type" class="join-select__native" tabindex="-1" aria-hidden="true">
              <option value="individual">An individual</option>
              <option value="business">A business</option>
              <option value="faith organisation">A faith organisation</option>
              <option value="nonprofit">A nonprofit</option>
              <option value="school">A school</option>
              <option value="other">Other</option>
            </select>
            <button
              type="button"
              class="join-select__trigger"
              data-select-trigger
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="join-org-type-options"
            >
              <span data-select-value>An individual</span>
              <span class="join-select__chevron" aria-hidden="true"></span>
            </button>
            <span
              class="join-select__menu"
              id="join-org-type-options"
              data-select-menu
              role="listbox"
              hidden
            >
              <button type="button" role="option" data-select-option data-value="individual" aria-selected="true">An individual</button>
              <button type="button" role="option" data-select-option data-value="business" aria-selected="false">A business</button>
              <button type="button" role="option" data-select-option data-value="faith organisation" aria-selected="false">A faith organisation</button>
              <button type="button" role="option" data-select-option data-value="nonprofit" aria-selected="false">A nonprofit</button>
              <button type="button" role="option" data-select-option data-value="school" aria-selected="false">A school</button>
              <button type="button" role="option" data-select-option data-value="other" aria-selected="false">Other</button>
            </span>
          </span>
        </label>
        <label class="join-field">
          <span>How many people</span>
          <input type="number" name="people" min="1" max="50" value="1" />
        </label>
      </div>

      <fieldset class="join-field join-field--checks">
        <legend>How would you like to help?</legend>
        <div>
          <label><input type="checkbox" name="help" value="contribute goods" /> Contribute goods</label>
          <label><input type="checkbox" name="help" value="volunteer on the day" /> Volunteer on the day</label>
          <label><input type="checkbox" name="help" value="just attending" /> Just attending</label>
        </div>
      </fieldset>

      <label class="join-field">
        <span>Anything we should know</span>
        <textarea name="notes" rows="1"></textarea>
      </label>

      <p class="join-form__privacy">
        Used only to plan this event. We do not share it with anyone else.
      </p>

      <p class="join-form__error" data-join-error hidden role="alert"></p>

      <div class="join-form__actions">
        <button type="submit" class="btn btn--primary" data-join-submit>Send</button>
        <button type="button" class="btn btn--ghost" data-join-cancel>Cancel</button>
      </div>
    </form>
  ) : (
    <p class="join-dialog__fallback">
      Sign-ups are not connected yet. Email <a href={`mailto:${contactEmail}`}>{contactEmail}</a> and we will add you.
    </p>
  )}

  <div class="join-dialog__done" data-join-done hidden>
    <p class="join-dialog__done-title">Thank you — we have your details.</p>
    <p>We will be in touch before the event.</p>
    <button type="button" class="btn btn--ghost" data-join-cancel>Close</button>
  </div>
</dialog>

<script define:vars={{ endpoint }}>
  const dialog = document.getElementById('join-dialog');
  if (dialog) {
    const form = dialog.querySelector('[data-join-form]');
    const done = dialog.querySelector('[data-join-done]');
    const errorEl = dialog.querySelector('[data-join-error]');
    const summary = dialog.querySelector('[data-join-summary]');
    const customSelect = form?.querySelector('[data-join-select]');
    const nativeSelect = customSelect?.querySelector('[name="org_type"]');
    const selectTrigger = customSelect?.querySelector('[data-select-trigger]');
    const selectValue = customSelect?.querySelector('[data-select-value]');
    const selectMenu = customSelect?.querySelector('[data-select-menu]');
    const selectOptions = [...(customSelect?.querySelectorAll('[data-select-option]') || [])];
    let openedAt = 0;

    const closeSelect = (returnFocus = false) => {
      if (!selectMenu || !selectTrigger) return;
      selectMenu.hidden = true;
      selectTrigger.setAttribute('aria-expanded', 'false');
      if (returnFocus) selectTrigger.focus();
    };

    const syncSelect = () => {
      if (!nativeSelect || !selectValue) return;
      const selected = nativeSelect.options[nativeSelect.selectedIndex];
      if (selected) selectValue.textContent = selected.textContent;
      selectOptions.forEach((option) => {
        option.setAttribute('aria-selected', option.getAttribute('data-value') === nativeSelect.value ? 'true' : 'false');
      });
    };

    const openSelect = () => {
      if (!selectMenu || !selectTrigger) return;
      selectMenu.hidden = false;
      selectTrigger.setAttribute('aria-expanded', 'true');
      const activeOption = selectOptions.find((option) => option.getAttribute('data-value') === nativeSelect?.value);
      activeOption?.focus();
    };

    const chooseSelectOption = (option) => {
      const value = option.getAttribute('data-value');
      if (!nativeSelect || !value) return;
      nativeSelect.value = value;
      nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
      syncSelect();
      closeSelect(true);
    };

    selectTrigger?.addEventListener('click', () => {
      if (selectMenu?.hidden) openSelect();
      else closeSelect(true);
    });

    selectTrigger?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openSelect();
      }
    });

    selectOptions.forEach((option, index) => {
      option.tabIndex = -1;
      option.addEventListener('click', () => chooseSelectOption(option));
      option.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          event.preventDefault();
          closeSelect(true);
        } else if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const offset = event.key === 'ArrowDown' ? 1 : -1;
          selectOptions[(index + offset + selectOptions.length) % selectOptions.length]?.focus();
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          selectOptions[event.key === 'Home' ? 0 : selectOptions.length - 1]?.focus();
        } else if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          chooseSelectOption(option);
        }
      });
    });

    document.addEventListener('click', (event) => {
      if (customSelect && !customSelect.contains(event.target)) closeSelect();
    });

    nativeSelect?.addEventListener('change', syncSelect);
    syncSelect();

    document.querySelectorAll('[data-join-event]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-join-event') || '';
        const date = btn.getAttribute('data-join-date') || '';
        if (summary) summary.textContent = title;
        if (form) {
          form.reset();
          syncSelect();
          closeSelect();
          form.hidden = false;
          form.querySelector('[data-field-title]').value = title;
          form.querySelector('[data-field-date]').value = date;
        }
        if (done) done.hidden = true;
        if (errorEl) errorEl.hidden = true;
        openedAt = Date.now();
        dialog.showModal();
      });
    });

    dialog.querySelectorAll('[data-join-cancel]').forEach((b) =>
      b.addEventListener('click', () => dialog.close())
    );

    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const submit = form.querySelector('[data-join-submit]');
      const data = Object.fromEntries(new FormData(form).entries());
      data.help = [...form.querySelectorAll('input[name="help"]:checked')].map((c) => c.value);
      data.elapsed = Date.now() - openedAt;

      if (!data.name || !data.email) {
        errorEl.textContent = 'Please add your name and email.';
        errorEl.hidden = false;
        return;
      }

      submit.disabled = true;
      const label = submit.textContent;
      submit.textContent = 'Sending…';
      errorEl.hidden = true;

      try {
        // text/plain keeps this a simple request, so the browser skips the
        // preflight that Apps Script cannot answer.
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(data)
        });
        const out = await res.json().catch(() => ({ ok: res.ok }));
        if (!out.ok) throw new Error(out.message || 'Could not send.');
        form.hidden = true;
        done.hidden = false;
      } catch (err) {
        // Keep every value the person typed; never discard a filled form.
        errorEl.textContent =
          'That did not send. Please try again, or email ' + 'info@handsacrosshumanity.org' + '.';
        errorEl.hidden = false;
      } finally {
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>
