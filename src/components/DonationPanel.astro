---
import { Image } from 'astro:assets';
import logoMark from '../assets/images/logo-mark-teal-navy.jpg';
import { CONTACT_EMAIL } from '../lib/pages';
import { GIVING_IS_LIVE, MAX_GIFT_USD, MIN_GIFT_USD, STRIPE_PUBLISHABLE_KEY } from '../lib/giving';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const fallbackHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Donation inquiry')}`;
const isConfigured = GIVING_IS_LIVE;

const amounts = [25, 50, 100];
---

<section
  class:list={['donation-panel', { 'donation-panel--compact': compact }]}
  data-donation-panel
  data-live={isConfigured ? 'true' : undefined}
  data-min={MIN_GIFT_USD}
  data-max={MAX_GIFT_USD}
  data-contact={CONTACT_EMAIL}
  data-stripe-key={isConfigured ? STRIPE_PUBLISHABLE_KEY || undefined : undefined}
  aria-labelledby="donation-panel-title"
>
  <div class="donation-panel__controls">
    <div class="donation-panel__heading">
      <h2 id="donation-panel-title">Choose a gift with a clear purpose.</h2>
      <p class="donation-panel__lead">Start with the kind of local support that matters to you, then choose a one-time or monthly gift.</p>
    </div>

    <fieldset class="donation-focus">
      <legend>What matters to you? <span>(optional)</span></legend>
      <div class="donation-focus__choices" role="group" aria-label="Giving preference">
        <button class="donation-focus__choice" type="button" data-focus="education" aria-pressed="false">Education &amp; family</button>
        <button class="donation-focus__choice" type="button" data-focus="health" aria-pressed="false">Health &amp; household</button>
        <button class="donation-focus__choice" type="button" data-focus="community" aria-pressed="false">Community care</button>
      </div>
    </fieldset>

    <fieldset class="donation-frequency">
      <legend>Giving frequency</legend>
      <div class="donation-choice-group" role="group" aria-label="Giving frequency">
        <button class="donation-choice is-selected" type="button" data-frequency="one-time" aria-pressed="true">
          One-time gift
        </button>
        <button class="donation-choice" type="button" data-frequency="monthly" aria-pressed="false">
          Monthly partner
        </button>
      </div>
    </fieldset>

    <fieldset class="donation-amounts-fieldset">
      <legend>Select amount <span>(USD)</span></legend>
      <div class="donation-amounts" role="group" aria-label="Donation amount">
        {amounts.map((amount, index) => (
          <button
            class:list={['donation-amount', { 'is-selected': index === 1 }]}
            type="button"
            data-amount={amount}
            aria-pressed={index === 1 ? 'true' : 'false'}
          >${amount}</button>
        ))}
      </div>
      <label class="donation-custom" for="donation-custom-amount">
        <span class="donation-custom__currency" aria-hidden="true">$</span>
        <span class="visually-hidden">Custom donation amount in US dollars</span>
        <input id="donation-custom-amount" type="number" min={MIN_GIFT_USD} max={MAX_GIFT_USD} step="1" inputmode="decimal" placeholder="Or enter a custom amount" />
      </label>
    </fieldset>
  </div>

  <aside class="donation-panel__summary" aria-label="Donation summary">
    <p class="donation-panel__summary-label">Your gift can strengthen</p>
    <p class="donation-panel__summary-focus" data-donation-focus-name>Community support</p>
    <p class="donation-panel__summary-amount"><span data-donation-summary-amount>$50</span> <span class="donation-panel__summary-cadence" data-donation-summary-cadence>/ one time</span></p>
    <p class="donation-panel__summary-message" data-donation-message aria-live="polite">Your gift helps strengthen the local network of goods, volunteers, and partners.</p>

    <ul class="donation-panel__benefits">
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.2 4.2L19 6.5" /></svg>
        <span>Useful goods, volunteer preparation, and local partner coordination.</span>
      </li>
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4.2 4.2L19 6.5" /></svg>
        <span>A giving preference that tells us which part of the work matters to you.</span>
      </li>
    </ul>

    <div class="donation-panel__handoff">
      {isConfigured ? (
        <button class="btn btn--primary donation-panel__cta" type="button" data-donation-checkout>
          Continue to secure checkout
          <span class="btn__arrow" aria-hidden="true">→</span>
        </button>
      ) : (
        <a
          class="btn btn--primary donation-panel__cta"
          data-donation-mailto
          href={fallbackHref}
          aria-label="Ask our giving team by email"
        >
          Ask our giving team
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      )}
      <p class="donation-panel__handoff-note" data-donation-note aria-live="polite">
        {isConfigured
          ? 'Secure payment by Stripe, right on this page. Card details go straight to Stripe and are never stored here.'
          : 'Secure online giving is being connected. Our team can answer questions about a gift by email.'}
      </p>
    </div>
  </aside>

  {isConfigured && STRIPE_PUBLISHABLE_KEY && (
    <Fragment>
      <link rel="preconnect" href="https://js.stripe.com" />
      <link rel="preconnect" href="https://api.stripe.com" />
    </Fragment>
  )}
  {isConfigured && (
    <dialog class="donation-checkout" data-donation-dialog data-state="loading" aria-labelledby="donation-checkout-title">
      <button class="donation-checkout__close" type="button" data-checkout-close aria-label="Close checkout">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>

      <div class="donation-checkout__frame">
        <aside class="donation-checkout__aside" aria-label="Your gift">
          <div class="donation-checkout__brand">
            <span class="brand__logo-container donation-checkout__logo">
              <Image src={logoMark} alt="" width={48} height={38} class="brand__logo-img" />
            </span>
            <span>Hands Across Humanity</span>
          </div>

          <div class="donation-checkout__gift">
            <p class="donation-checkout__eyebrow">Your gift</p>
            <p class="donation-checkout__amount">
              <span data-checkout-amount>$50</span>
              <span class="donation-checkout__cadence" data-checkout-cadence>one time</span>
            </p>
            <p class="donation-checkout__focus" data-checkout-focus>Community support</p>
            <p class="donation-checkout__message" data-checkout-message></p>
          </div>

          <ul class="donation-checkout__assurances">
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>
              <span>Secure payment processed by Stripe</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
              <span>An emailed receipt for your records</span>
            </li>
            <li data-checkout-monthly-only hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" /><path d="M18 3v4h-4M6 21v-4h4" /></svg>
              <span>Change or cancel your monthly gift anytime</span>
            </li>
          </ul>

          <p class="donation-checkout__fineprint">Card details go straight to Stripe and are never stored by this website.</p>
        </aside>

        <section class="donation-checkout__main" aria-labelledby="donation-checkout-title">
          <h2 class="donation-checkout__title" id="donation-checkout-title">Payment details</h2>
          <div class="donation-checkout__scroll">
            <div class="donation-checkout__skeleton" aria-hidden="true">
              <span class="donation-checkout__bone donation-checkout__bone--button"></span>
              <span class="donation-checkout__bone donation-checkout__bone--label"></span>
              <span class="donation-checkout__bone"></span>
              <span class="donation-checkout__bone donation-checkout__bone--label"></span>
              <span class="donation-checkout__bone donation-checkout__bone--tall"></span>
              <span class="donation-checkout__bone donation-checkout__bone--label"></span>
              <span class="donation-checkout__bone"></span>
            </div>
            <p class="visually-hidden" data-checkout-loading role="status">Loading secure payment form…</p>
            <div class="donation-checkout__error" data-checkout-error role="alert" hidden>
              <p data-checkout-error-text></p>
              <button class="btn btn--primary" type="button" data-checkout-retry>Try again</button>
            </div>
            <div class="donation-checkout__mount" data-checkout-mount></div>
          </div>
        </section>
      </div>
    </dialog>
  )}
</section>

<script>
  // Static, not a dynamic import(): a lazily fetched chunk can fail mid-session
  // (Vite re-optimising deps in dev, or a redeploy replacing chunk hashes while
  // a page is open). The "pure" entry does not load Stripe.js until
  // loadStripe() is called on checkout, so this costs nothing up front.
  import { loadStripe } from '@stripe/stripe-js/pure';

  const formatAmount = (amount: number) => new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: 'USD',
    maximumFractionDigits: amount % 1 === 0 ? 0 : 2,
  }).format(amount);

  document.querySelectorAll<HTMLElement>('[data-donation-panel]').forEach((panel) => {
    const frequencyButtons = panel.querySelectorAll<HTMLButtonElement>('[data-frequency]');
    const focusButtons = panel.querySelectorAll<HTMLButtonElement>('[data-focus]');
    const amountButtons = panel.querySelectorAll<HTMLButtonElement>('[data-amount]');
    const customInput = panel.querySelector<HTMLInputElement>('#donation-custom-amount');
    const summaryAmount = panel.querySelector<HTMLElement>('[data-donation-summary-amount]');
    const summaryCadence = panel.querySelector<HTMLElement>('[data-donation-summary-cadence]');
    const summaryFocusName = panel.querySelector<HTMLElement>('[data-donation-focus-name]');
    const summaryMessage = panel.querySelector<HTMLElement>('[data-donation-message]');
    const mailtoLink = panel.querySelector<HTMLAnchorElement>('[data-donation-mailto]');
    const checkoutButton = panel.querySelector<HTMLButtonElement>('[data-donation-checkout]');
    const note = panel.querySelector<HTMLElement>('[data-donation-note]');
    const defaultNote = note?.textContent?.trim() || '';
    const minGift = Number(panel.dataset.min) || 1;
    const maxGift = Number(panel.dataset.max) || 10000;

    const query = new URLSearchParams(window.location.search);
    const permittedFocuses = new Set(['education', 'health', 'community', 'general']);
    const focusContent: Record<string, { name: string; oneTime: string; monthly: string }> = {
      general: {
        name: 'Community support',
        oneTime: 'Your gift helps strengthen the local network of goods, volunteers, and partners.',
        monthly: 'A monthly gift helps keep practical community support ready as needs change.',
      },
      education: {
        name: 'Education & family',
        oneTime: 'Your gift helps strengthen school and family essentials for local distribution.',
        monthly: 'A monthly gift helps keep education and family essentials ready as needs change.',
      },
      health: {
        name: 'Health & household',
        oneTime: 'Your gift helps strengthen everyday health, hygiene, and household support.',
        monthly: 'A monthly gift helps keep practical health and household support ready over time.',
      },
      community: {
        name: 'Community care',
        oneTime: 'Your gift helps strengthen local distribution and the relationships that make it possible.',
        monthly: 'A monthly gift helps keep local distribution and partner coordination ready as needs change.',
      },
    };

    let frequency = query.get('frequency') === 'monthly' ? 'monthly' : 'one-time';
    let focus = permittedFocuses.has(query.get('focus') || '') ? query.get('focus')! : 'general';
    let amount = 50;

    // Coming back from a cancelled Stripe Checkout: restore the amount too.
    const returnedAmount = Number(query.get('amount'));
    if (Number.isFinite(returnedAmount) && returnedAmount > 0) {
      const preset = [...amountButtons].find((button) => Number(button.dataset.amount) === returnedAmount);
      amountButtons.forEach((button) => {
        const selected = button === preset;
        button.setAttribute('aria-pressed', String(selected));
        button.classList.toggle('is-selected', selected);
      });
      if (preset) amount = returnedAmount;
      else if (customInput) customInput.value = String(returnedAmount);
    }

    const update = () => {
      const customAmount = Number(customInput?.value);
      if (customInput?.value && Number.isFinite(customAmount) && customAmount > 0) {
        amount = customAmount;
        amountButtons.forEach((button) => {
          button.setAttribute('aria-pressed', 'false');
          button.classList.remove('is-selected');
        });
      } else if (![...amountButtons].some((button) => button.getAttribute('aria-pressed') === 'true')) {
        // The custom field was cleared: fall back to the default preset rather
        // than keeping a typed amount that is no longer on screen.
        amount = 50;
        amountButtons.forEach((button) => {
          const selected = Number(button.dataset.amount) === amount;
          button.setAttribute('aria-pressed', String(selected));
          button.classList.toggle('is-selected', selected);
        });
      }

      if (summaryAmount) summaryAmount.textContent = formatAmount(amount);
      if (summaryCadence) summaryCadence.textContent = frequency === 'monthly' ? '/ month' : '/ one time';
      if (summaryFocusName) summaryFocusName.textContent = focusContent[focus].name;
      if (summaryMessage) {
        summaryMessage.textContent = frequency === 'monthly'
          ? focusContent[focus].monthly
          : focusContent[focus].oneTime;
      }

      frequencyButtons.forEach((item) => {
        const selected = item.dataset.frequency === frequency;
        item.setAttribute('aria-pressed', String(selected));
        item.classList.toggle('is-selected', selected);
      });
      focusButtons.forEach((item) => {
        const selected = item.dataset.focus === focus;
        item.setAttribute('aria-pressed', String(selected));
        item.classList.toggle('is-selected', selected);
      });

      if (mailtoLink) {
        // Until online giving is live the button opens an email. Carry the
        // choices into it so the visitor does not have to type them again.
        const mailto = new URL(mailtoLink.getAttribute('href') || '', window.location.href);
        const lines = [
          'Hello,',
          '',
          `I would like to give ${formatAmount(amount)} ${frequency === 'monthly' ? 'each month' : 'once'}`
            + (focus === 'general' ? '.' : ` toward ${focusContent[focus].name}.`),
          'Please let me know how to complete the gift.',
        ];
        mailto.search = `?subject=${encodeURIComponent('Donation inquiry')}&body=${encodeURIComponent(lines.join('\n'))}`;
        mailtoLink.href = mailto.toString();
      }
    };

    frequencyButtons.forEach((button) => {
      button.addEventListener('click', () => {
        frequency = button.dataset.frequency || 'one-time';
        update();
      });
    });

    focusButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextFocus = button.dataset.focus || 'general';
        if (!permittedFocuses.has(nextFocus)) return;
        // The preference is optional, so a second press clears it.
        focus = focus === nextFocus ? 'general' : nextFocus;
        update();
      });
    });

    amountButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const nextAmount = Number(button.dataset.amount);
        if (!Number.isFinite(nextAmount)) return;
        amount = nextAmount;
        if (customInput) customInput.value = '';
        amountButtons.forEach((item) => {
          const selected = item === button;
          item.setAttribute('aria-pressed', String(selected));
          item.classList.toggle('is-selected', selected);
        });
        update();
      });
    });

    customInput?.addEventListener('input', () => {
      update();
      if (note && note.dataset.state === 'error') setNote(defaultNote);
    });

    const setNote = (text: string, state?: 'error') => {
      if (!note) return;
      note.textContent = text;
      if (state) note.dataset.state = state;
      else delete note.dataset.state;
    };

    // ---- Embedded Stripe Checkout, opened in a dialog on this page ----
    const dialog = panel.querySelector<HTMLDialogElement>('[data-donation-dialog]');
    const mountEl = dialog?.querySelector<HTMLElement>('[data-checkout-mount]');
    const loadingEl = dialog?.querySelector<HTMLElement>('[data-checkout-loading]');
    const errorEl = dialog?.querySelector<HTMLElement>('[data-checkout-error]');
    const errorText = dialog?.querySelector<HTMLElement>('[data-checkout-error-text]');
    const giftAmount = dialog?.querySelector<HTMLElement>('[data-checkout-amount]');
    const giftCadence = dialog?.querySelector<HTMLElement>('[data-checkout-cadence]');
    const giftFocus = dialog?.querySelector<HTMLElement>('[data-checkout-focus]');
    const giftMessage = dialog?.querySelector<HTMLElement>('[data-checkout-message]');
    const monthlyOnly = dialog?.querySelectorAll<HTMLElement>('[data-checkout-monthly-only]') ?? [];
    const publishableKey = panel.dataset.stripeKey || '';
    const contact = panel.dataset.contact || 'our team';
    let embedded: { destroy(): void } | null = null;
    // Bumped on every open and close, so a slow request that finishes after
    // the dialog was closed (or reopened) cannot mount into it.
    let attempt = 0;

    /** loading → skeleton; ready → Stripe's form; error → message + retry. */
    const setState = (state: 'loading' | 'ready' | 'error', message = '') => {
      if (!dialog) return;
      dialog.dataset.state = state;
      if (loadingEl) loadingEl.textContent = state === 'loading' ? 'Loading secure payment form…' : '';
      if (errorEl) errorEl.hidden = state !== 'error';
      if (errorText) errorText.textContent = message;
    };

    // The page behind is held still by CSS (html:has(.donation-checkout[open])
    // in polish.css). Pinning the body with position: fixed, as before, forced a
    // full re-layout and a scroll jump on every open and close.

    // Stripe.js is fetched once, as early as the visitor shows intent (hover or
    // focus on the button), so it is usually ready before they click.
    let stripePromise: ReturnType<typeof loadStripe> | null = null;
    const getStripe = () => {
      stripePromise ??= loadStripe(publishableKey).catch((error) => {
        stripePromise = null;
        throw error;
      });
      return stripePromise;
    };
    if (publishableKey && checkoutButton) {
      const warm = () => { void getStripe().catch(() => {}); };
      checkoutButton.addEventListener('pointerenter', warm, { once: true });
      checkoutButton.addEventListener('focus', warm, { once: true });
      checkoutButton.addEventListener('touchstart', warm, { once: true, passive: true });
    }

    const unmount = () => {
      attempt += 1;
      embedded?.destroy();
      embedded = null;
      mountEl?.replaceChildren();
    };

    /**
     * Stripe's form loads its iframe, then animates its own height for about
     * half a second as it lays out. Showing it before that is the "lag". So
     * wait for the frame to load, for its height to start changing, and then
     * for it to hold still for a moment. If it never changes, show it anyway.
     */
    const whenFormSettles = (container: HTMLElement, done: () => void) => {
      const watch = (frame: HTMLIFrameElement) => {
        frame.addEventListener('load', () => {
          let first = true;
          let quiet = 0;
          const finish = () => { observer.disconnect(); done(); };
          const observer = new ResizeObserver(() => {
            if (first) { first = false; return; } // the initial report is not a change
            window.clearTimeout(quiet);
            quiet = window.setTimeout(finish, 250);
          });
          observer.observe(frame);
          quiet = window.setTimeout(finish, 1500); // no resize at all: it is already laid out
        }, { once: true });
      };
      const existing = container.querySelector('iframe');
      if (existing) return watch(existing);
      const added = new MutationObserver(() => {
        const frame = container.querySelector('iframe');
        if (frame) { added.disconnect(); watch(frame); }
      });
      added.observe(container, { childList: true, subtree: true });
    };

    const mountCheckout = async () => {
      if (!dialog || !mountEl) return;
      unmount();
      const current = attempt;
      setState('loading');

      // Keep the skeleton until the form has actually drawn, then fade it in;
      // showing the iframe as soon as it was mounted flashed a blank frame that
      // then jumped in height. The timer is a backstop if no signal arrives.
      let revealed = false;
      const reveal = () => {
        if (revealed || current !== attempt) return;
        revealed = true;
        setState('ready');
      };
      const backstop = window.setTimeout(reveal, 6000);

      try {
        // The session and Stripe.js load side by side instead of one after the other.
        const stripeLoading = publishableKey ? getStripe() : null;
        stripeLoading?.catch(() => {});
        const response = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, frequency, focus }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) {
          throw new Error(typeof data.error === 'string' ? data.error : 'Secure checkout could not be opened.');
        }
        if (current !== attempt) return;

        if (typeof data.mockUrl === 'string') {
          // STRIPE_MOCK on the dev server: a local stand-in for Stripe's form.
          const frame = document.createElement('iframe');
          frame.className = 'donation-checkout__mock';
          frame.title = 'Test payment form';
          frame.addEventListener('load', reveal, { once: true });
          frame.src = data.mockUrl;
          mountEl.append(frame);
          return;
        }

        if (typeof data.clientSecret !== 'string' || !stripeLoading) {
          throw new Error('Secure checkout could not be opened.');
        }
        const stripe = await stripeLoading;
        if (!stripe) throw new Error('The secure payment form could not load.');
        if (current !== attempt) return;
        const checkout = await stripe.createEmbeddedCheckoutPage({
          clientSecret: data.clientSecret,
          onAnalyticsEvent: (event) => {
            if (event.eventType === 'checkoutRendered') reveal();
          },
        });
        if (current !== attempt) {
          checkout.destroy();
          return;
        }
        embedded = checkout;
        whenFormSettles(mountEl, reveal);
        checkout.mount(mountEl);
      } catch (error) {
        window.clearTimeout(backstop);
        if (current !== attempt) return;
        const message = error instanceof Error ? error.message : 'Secure checkout could not be opened.';
        setState('error', `${message} Please try again, or email ${contact}.`);
      }
    };

    dialog?.querySelector('[data-checkout-close]')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('[data-checkout-retry]')?.addEventListener('click', () => mountCheckout());
    dialog?.addEventListener('close', () => {
      unmount();
      setNote('Checkout closed. Nothing was charged — your choices are still here.');
      checkoutButton?.focus();
    });

    checkoutButton?.addEventListener('click', () => {
      if (amount < minGift || amount > maxGift) {
        setNote(`Please choose an amount between ${formatAmount(minGift)} and ${formatAmount(maxGift)}.`, 'error');
        customInput?.focus();
        return;
      }
      if (!dialog) return;

      setNote(defaultNote);
      const monthly = frequency === 'monthly';
      if (giftAmount) giftAmount.textContent = formatAmount(amount);
      if (giftCadence) giftCadence.textContent = monthly ? 'per month' : 'one time';
      if (giftFocus) giftFocus.textContent = focusContent[focus].name;
      if (giftMessage) giftMessage.textContent = monthly ? focusContent[focus].monthly : focusContent[focus].oneTime;
      monthlyOnly.forEach((el) => { el.hidden = !monthly; });

      dialog.showModal();
      mountCheckout();
    });

    update();
  });
</script>
