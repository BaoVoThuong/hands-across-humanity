---
const operatingPrinciples = [
  {
    title: 'Gather',
    text: 'Businesses, neighbors, and community groups bring useful goods together.'
  },
  {
    title: 'Prepare',
    text: 'Volunteers sort and organize items for a clear community need.'
  },
  {
    title: 'Share',
    text: 'Local partners place practical support where it is needed.'
  }
];
---

<section class="impact-band" id="impact" aria-labelledby="impact-band-title">
  <div class="container impact-band__inner">
    <div class="impact-band__intro reveal">
      <h2 id="impact-band-title">How a donation moves.</h2>
      <p>A clear process turns available goods into support people can use.</p>
    </div>

    <div class="impact-band__principles" role="list">
      {operatingPrinciples.map((principle, i) => (
        <div class="impact-band__principle reveal" role="listitem" style={`--i:${i + 1}`}>
          <strong>{principle.title}</strong>
          <span>{principle.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
