---
const operatingPrinciples = [
  {
    title: 'Gather',
    text: 'Bring useful donations together from businesses, neighbors, and community groups.'
  },
  {
    title: 'Prepare',
    text: 'Sort and organize essential goods so they are ready for the right community need.'
  },
  {
    title: 'Share',
    text: 'Distribute practical support through trusted local partners and community events.'
  }
];
---

<section class="impact-band" id="impact" aria-labelledby="impact-band-title">
  <div class="container impact-band__inner">
    <div class="impact-band__intro reveal">
      <h2 id="impact-band-title">From giving to practical support.</h2>
      <p>A clear process helps useful donations reach people with care, dignity, and purpose.</p>
    </div>

    <div class="impact-band__principles" role="list">
      {operatingPrinciples.map((principle, i) => (
        <div class="impact-band__principle reveal" role="listitem" style={`--i:${i + 1}`}>
          <strong>{principle.title}</strong>
          <span>{principle.text}</span>
        </div>
      ))}
    </div>
  </div>
</section>
