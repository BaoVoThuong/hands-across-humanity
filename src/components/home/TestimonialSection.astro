---
import { Picture } from 'astro:assets';

export interface TestimonialItem {
  quote: string;
  name: string;
  role: string;
  initials?: string;
  accentColor?: string;
  avatar?: ImageMetadata;
}

interface Props {
  title?: string;
  lead?: string;
  testimonials: TestimonialItem[];
}

const {
  title = "Trusted by Field Leaders & Foundations",
  lead = "Hear from local directors and foundation leaders partnering with Hands Across Humanity.",
  testimonials
} = Astro.props;
---

<section class="section section--sand" id="proof">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <h2>{title}</h2>
      <p class="lead">{lead}</p>
    </div>

    <div class="testimonial-grid">
      {testimonials.map((t, i) => (
        <div class="testimonial-card reveal" style={`--i:${i + 1}`}>
          <p class="testimonial-card__quote">{t.quote}</p>
          <div class="testimonial-card__author">
            {t.avatar ? (
              <Picture
                src={t.avatar}
                widths={[100]}
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                quality={70}
                alt={t.name}
                class="testimonial-card__avatar"
              />
            ) : (
              <div class="testimonial-card__monogram" style={`background: ${t.accentColor};`}>
                {t.initials}
              </div>
            )}
            <div class="testimonial-card__info">
              <p>{t.name}</p>
              <p>{t.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
