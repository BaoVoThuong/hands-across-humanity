---
interface Props {
  title?: string;
  kicker?: string;
  lead?: string;
}

const {
  title = "See How Far Your Gift Goes",
  kicker = "Real-World Impact Breakdown",
  lead = "Select your contribution to see the tangible, ground-level change created in real communities."
} = Astro.props;
---

<section class="section section--paper" id="calculator">
  <div class="container">
    <div class="calc-container reveal">
      <div class="calc-input-panel">
        <div class="calc-header">
          <p class="eyebrow">Direct Allocation Engine</p>
          <h2 id="calc-title" class="calc-title">{title}</h2>
          <p class="calc-lead">{lead}</p>
        </div>
        
        <!-- Frequency Selector -->
        <div class="calc-freq-group">
          <label class="calc-label">Giving Frequency</label>
          <div class="calc-toggle" role="group" aria-label="Donation frequency">
            <button type="button" class="calc-toggle__btn is-active" id="calc-monthly" data-freq="monthly" aria-pressed="true">Monthly Partner</button>
            <button type="button" class="calc-toggle__btn" id="calc-once" data-freq="once" aria-pressed="false">One-Time Gift</button>
          </div>
        </div>

        <!-- Presets & Custom Amount Grid -->
        <div class="calc-amount-group">
          <div class="calc-amount-header">
            <label class="calc-label">Select Amount (USD)</label>
            <span class="calc-guarantee-tag">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              <span><strong>94%</strong> directly to field initiatives</span>
            </span>
          </div>

          <div class="calc-presets-grid" role="group" aria-label="Select donation amount">
            <button type="button" class="calc-preset-btn" data-amt="25">$25</button>
            <button type="button" class="calc-preset-btn is-active" data-amt="50">$50</button>
            <button type="button" class="calc-preset-btn" data-amt="100">$100</button>
            <button type="button" class="calc-preset-btn" data-amt="250">$250</button>
            <button type="button" class="calc-preset-btn" data-amt="500">$500</button>
          </div>

          <!-- Custom Amount Input -->
          <div class="calc-custom-box">
            <span class="calc-custom-symbol">$</span>
            <input type="number" id="calc-custom-input" class="calc-custom-input" placeholder="Or enter custom amount in USD" min="5" max="50000" step="5" aria-label="Custom donation amount in dollars" />
          </div>
        </div>
      </div>

      <!-- Result Card -->
      <div class="calc-result-panel">
        <div class="calc-result-header">
          <span class="calc-result-tag">Estimated Direct Impact</span>
          <div class="calc-result-price-wrap">
            <span id="calc-metric-num" class="calc-result-price">$50 / mo</span>
          </div>
        </div>

        <ul class="calc-impact-list">
          <li class="calc-impact-item">
            <span class="calc-impact-icon" aria-hidden="true">✓</span>
            <span id="calc-metric-unit" class="calc-impact-text">Provides <strong>100 days of clean drinking water</strong> for 2 rural families.</span>
          </li>
          <li class="calc-impact-item">
            <span class="calc-impact-icon" aria-hidden="true">✓</span>
            <span id="calc-text" class="calc-impact-text">Delivers emergency water purification tablets & essential school supplies.</span>
          </li>
        </ul>

        <div class="calc-result-footer">
          <a id="calc-cta-btn" href="#donate" class="btn btn--primary calc-submit-btn">
            Fund This Impact <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <p class="calc-tax-note">Audited & Dispatched to Registered Local Partners</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // High-Trust Editorial Impact Calculator Script
  const monthlyBtn = document.getElementById('calc-monthly');
  const onceBtn = document.getElementById('calc-once');
  const presetBtns = document.querySelectorAll<HTMLElement>('.calc-preset-btn');
  const customInput = document.getElementById('calc-custom-input') as HTMLInputElement | null;
  const metricNum = document.getElementById('calc-metric-num');
  const metricUnit = document.getElementById('calc-metric-unit');
  const outputText = document.getElementById('calc-text');
  const ctaBtn = document.getElementById('calc-cta-btn');

  let isMonthly = true;
  let currentAmt = 50;

  function getDynamicImpact(amount: number) {
    const fams = Math.max(1, Math.floor(amount / 25));
    const kids = Math.max(1, Math.floor(amount / 50));
    const waterMeters = Math.max(2, Math.floor(amount * 0.2));
    return {
      num: `$${amount}${isMonthly ? ' / mo' : ' one-time'}`,
      unit: `Supplies <strong>${fams} ${fams > 1 ? 'families' : 'family'}</strong> with emergency food & clean water kits.`,
      desc: `Keeps <strong>${kids} ${kids > 1 ? 'children' : 'child'}</strong> enrolled in school & funds <strong>${waterMeters}m</strong> water piping.`
    };
  }

  const updateOutput = () => {
    if (!outputText || !metricNum || !metricUnit) return;

    const { num, unit, desc } = getDynamicImpact(currentAmt);
    metricNum.textContent = num;
    metricUnit.innerHTML = unit;
    outputText.innerHTML = desc;

    if (ctaBtn) {
      const arrowSpan = document.createElement('span');
      arrowSpan.className = 'btn__arrow';
      arrowSpan.setAttribute('aria-hidden', 'true');
      arrowSpan.textContent = '→';
      
      ctaBtn.textContent = `Commit $${currentAmt}${isMonthly ? ' / month' : ' one-time'} `;
      ctaBtn.appendChild(arrowSpan);
      ctaBtn.setAttribute('href', `/#donate?amount=${currentAmt}&type=${isMonthly ? 'monthly' : 'once'}`);
    }
  };

  monthlyBtn?.addEventListener('click', () => {
    isMonthly = true;
    monthlyBtn.classList.add('is-active');
    monthlyBtn.setAttribute('aria-pressed', 'true');
    onceBtn?.classList.remove('is-active');
    onceBtn?.setAttribute('aria-pressed', 'false');
    updateOutput();
  });

  onceBtn?.addEventListener('click', () => {
    isMonthly = false;
    onceBtn.classList.add('is-active');
    onceBtn.setAttribute('aria-pressed', 'true');
    monthlyBtn?.classList.remove('is-active');
    monthlyBtn?.setAttribute('aria-pressed', 'false');
    updateOutput();
  });

  presetBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      presetBtns.forEach((b) => {
        b.classList.remove('is-active');
      });
      if (customInput) customInput.value = '';

      const target = e.currentTarget as HTMLElement | null;
      if (target) {
        target.classList.add('is-active');
        currentAmt = parseInt(target.getAttribute('data-amt') || '50', 10);
        updateOutput();
      }
    });
  });

  customInput?.addEventListener('input', () => {
    const rawVal = customInput.value.trim();
    const val = parseInt(rawVal, 10);

    if (!isNaN(val) && val >= 5) {
      presetBtns.forEach((b) => {
        b.classList.remove('is-active');
      });
      currentAmt = val;
      updateOutput();
    }
  });
</script>

