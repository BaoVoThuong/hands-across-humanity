---
export interface ProcessStep {
  num: string;
  title: string;
  text: string;
}

interface Props {
  title?: string;
  lead?: string;
  steps: ProcessStep[];
}

const {
  title = "Our Direct Funding Model",
  lead = "We route capital directly to vetted local community partners, ensuring zero middleman friction and complete financial transparency.",
  steps
} = Astro.props;
---

<section class="section section--paper" id="process">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <h2>{title}</h2>
      <div class="section-head__divider" aria-hidden="true"></div>
      <p class="lead">{lead}</p>
    </div>

    <div class="process-pipeline reveal">
      <div class="process-pipeline__track" aria-hidden="true"></div>
      <div class="process-grid">
        {steps.map((step, i) => {
          const isAudit = i === steps.length - 1;
          return (
            <div class={`process-step ${isAudit ? 'process-step--audit' : ''}`} style={`--i:${i + 1}`}>
              <div>
                <div class="process-step__header">
                  <div class="process-step__num">{step.num}</div>
                  <div class="process-step__node" aria-hidden="true"></div>
                </div>
                <div class="process-step__divider" aria-hidden="true"></div>
                <h3 class="process-step__title">{step.title}</h3>
                <p class="process-step__text">{step.text}</p>
              </div>
              {isAudit && (
                <button
                  type="button"
                  class="audit-trigger-btn"
                  id="open-audit-standards"
                  aria-expanded="false"
                  aria-controls="audit-standards-modal"
                >
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                  <span>Inspect Audit Proof →</span>
                </button>
              )}
            </div>
          );
        })}
      </div>
    </div>

    <!-- Trust & Verification Bar -->
    <div class="process-guarantee-bar reveal" style="--i:5">
      <div class="process-guarantee-item">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>94% Direct Field Allocation</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span>Zero Middleman Markups</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="var(--slate-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        <span>Audited Quarterly Financial Logs</span>
      </div>
    </div>
  </div>

  <!-- Audit & Financial Transparency Inspector Modal -->
  <div class="modal-overlay" id="audit-standards-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="audit-modal-title">
    <div class="modal-dialog">
      <div class="modal-header">
        <div>
          <div class="modal-audit-verification">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            <span>Verified Financial Protocol</span>
          </div>
          <h3 id="audit-modal-title" style="margin-top: 0.35rem;">Financial Allocation & Audit Protocol</h3>
        </div>
        <button type="button" class="modal-close-btn" id="close-audit-modal" aria-label="Close audit details">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="modal-body">
        <div style="background: var(--surface-alt); padding: 1.25rem; border-radius: var(--radius-md); border: 1px solid var(--border-warm);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span style="font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--slate-600);">Direct Capital Flow Breakdown</span>
            <span style="font-size: 0.875rem; font-weight: 700; color: var(--emerald);">94.0% Direct Field Allocation</span>
          </div>
          <div style="height: 10px; background: var(--border); border-radius: 9999px; overflow: hidden; display: flex;">
            <div style="width: 94%; background: var(--emerald);" title="94% Direct Field Programs"></div>
            <div style="width: 6%; background: var(--primary);" title="6% Audit & Processing"></div>
          </div>
          <div style="display: flex; gap: 1.5rem; margin-top: 0.75rem; font-size: 0.8125rem;">
            <div style="display: flex; align-items: center; gap: 0.35rem;">
              <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--emerald);"></span>
              <span style="color: var(--slate-700); font-weight: 500;">94% Field Materials & Construction</span>
            </div>
            <div style="display: flex; align-items: center; gap: 0.35rem;">
              <span style="width: 8px; height: 8px; border-radius: 50%; background: var(--primary);"></span>
              <span style="color: var(--slate-700); font-weight: 500;">6% Financial Compliance & Banking</span>
            </div>
          </div>
        </div>

        <div>
          <p style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--slate-500);">3-Tier Audit Verification</p>
          <ul style="margin-top: 0.5rem; padding-left: 1.25rem; font-size: 0.875rem; color: var(--slate-700); line-height: 1.6;">
            <li><strong>Bank Wire Logs:</strong> Wire receipts published within 48 hours of field transfer.</li>
            <li><strong>Independent Field Boards:</strong> Audited by accredited regional boards (e.g. East Africa Water Board).</li>
            <li><strong>GPS & Photo Timestamp:</strong> Photo documentation captured at site foundation, build, and completion.</li>
          </ul>
        </div>

        <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 0.5rem;">
          <button type="button" class="btn btn--ghost" id="dismiss-audit-modal">Close Window</button>
          <a href="#donate" class="btn btn--primary" id="audit-donate-cta">Support Direct Funding →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const auditTriggerBtn = document.getElementById('open-audit-standards');
  const auditModalOverlay = document.getElementById('audit-standards-modal');
  const closeAuditModalBtn = document.getElementById('close-audit-modal');
  const dismissAuditModalBtn = document.getElementById('dismiss-audit-modal');
  const auditDonateCta = document.getElementById('audit-donate-cta');

  const openAuditModal = () => {
    if (!auditModalOverlay) return;
    auditModalOverlay.classList.add('is-open');
    auditModalOverlay.setAttribute('aria-hidden', 'false');
    if (auditTriggerBtn) auditTriggerBtn.setAttribute('aria-expanded', 'true');
    closeAuditModalBtn?.focus();
  };

  const closeAuditModal = () => {
    if (!auditModalOverlay) return;
    auditModalOverlay.classList.remove('is-open');
    auditModalOverlay.setAttribute('aria-hidden', 'true');
    if (auditTriggerBtn) {
      auditTriggerBtn.setAttribute('aria-expanded', 'false');
      auditTriggerBtn.focus();
    }
  };

  auditTriggerBtn?.addEventListener('click', openAuditModal);
  closeAuditModalBtn?.addEventListener('click', closeAuditModal);
  dismissAuditModalBtn?.addEventListener('click', closeAuditModal);
  auditDonateCta?.addEventListener('click', closeAuditModal);

  auditModalOverlay?.addEventListener('click', (e) => {
    if (e.target === auditModalOverlay) closeAuditModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && auditModalOverlay?.classList.contains('is-open')) {
      closeAuditModal();
    }
  });
</script>
