---
import DonationPanel from '../DonationPanel.astro';
---

<section class="donation-section" id="give" aria-label="Support practical local work">
  <div class="container">
    <header class="donation-section__heading">
      <div>
        <h2 id="give-title">Support the work.</h2>
      </div>
      <p class="donation-section__heading-copy">Choose the kind of support that matters to you, then give once or help keep the work ready every month.</p>
    </header>
    <DonationPanel compact />
  </div>
</section>
