---
import { nextPage } from '../../lib/pages';

/* About ends the way every other page does: one link to the next page in the
   reading order. It used to restate the field-notes promise and offer a second
   button, directly under the giving panel it was competing with. */
const next = nextPage('about-us');
---

<section class="section closing-cta-section" id="next-steps">
  <div class="container-narrow closing-cta-content">
    <span class="closing-cta-kicker reveal" style="--i:1">Up next</span>
    <h2 class="closing-cta-title reveal" style="--i:2">{next.cta}</h2>

    <div class="btn-row closing-cta-actions reveal" style="--i:3">
      <a class="btn btn--primary closing-cta-btn-primary" href={next.href} id="closing-next-btn">
        Continue to {next.name}<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .closing-cta-section {
    padding-block: var(--transition-padding, clamp(2rem, 4vh, 3rem));
    background-color: var(--transition-warm);
    color: var(--slate-900);
    border-top: 1px solid var(--transition-border);
    border-bottom: 1px solid var(--transition-border);
    position: relative;
  }

  .closing-cta-content {
    text-align: center;
  }

  .closing-cta-kicker {
    display: inline-block;
    font-size: var(--fs-micro, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .closing-cta-title {
    margin-block: 0 var(--space-4, 1rem);
    color: var(--slate-900);
  }

  .closing-cta-actions {
    justify-content: center;
    margin-top: var(--space-7, 2rem);
    gap: var(--space-4, 1rem);
  }

  .closing-cta-btn-primary {
    font-size: 1.0625rem;
    min-height: 3.35rem;
    padding-inline: 2.25rem;
  }

  @media (max-width: 640px) {
    .closing-cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
