---
interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  donateUrl?: string;
  governanceUrl?: string;
}

const {
  kicker = "Direct Humanitarian Action",
  title = "Empower a Community with Direct, Audited Aid.",
  lead = "Join over 8,400 regular monthly partners transforming lives through clean water, safe schools, and emergency recovery.",
  donateUrl = "#calculator",
  governanceUrl = "/who-we-are/"
} = Astro.props;
---

<section class="section section--dark closing-cta-section" id="donate">
  <div class="container-narrow closing-cta-content">
    <span class="closing-cta-kicker reveal" style="--i:1">{kicker}</span>
    <h2 class="closing-cta-title reveal" style="--i:2">{title}</h2>
    <p class="closing-cta-lead reveal" style="--i:3">{lead}</p>

    <div class="btn-row closing-cta-actions reveal" style="--i:4">
      <a class="btn btn--primary closing-cta-btn-primary" href={donateUrl} id="closing-donate-btn">
        Make a Donation Now<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost closing-cta-btn-secondary" href={governanceUrl}>
        Learn About Governance
      </a>
    </div>

    <div class="closing-cta-trust reveal" style="--i:5">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      <span>Secure 256-Bit Encrypted Payment · 100% Tax Deductible 501(c)(3)</span>
    </div>
  </div>
</section>

<style>
  .closing-cta-section {
    padding-block: var(--space-9, 4.5rem);
    background-color: var(--slate-900);
    position: relative;
  }

  .closing-cta-content {
    text-align: center;
  }

  .closing-cta-kicker {
    display: inline-block;
    font-size: var(--fs-micro, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary, #C84B2C);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .closing-cta-title {
    margin-block: 0 var(--space-4, 1rem);
    color: var(--fg-on-dark, #F8FAFC);
  }

  .closing-cta-lead {
    margin-inline: auto;
    max-width: 42rem;
    color: #CBD5E1; /* Slate 300 - High contrast reading */
    font-size: var(--fs-lead, 1.15rem);
    line-height: 1.6;
  }

  .closing-cta-actions {
    justify-content: center;
    margin-top: var(--space-7, 2rem);
    gap: var(--space-4, 1rem);
  }

  .closing-cta-btn-primary {
    font-size: 1.0625rem;
    min-height: 3.35rem;
    padding-inline: 2.25rem;
  }

  .closing-cta-btn-secondary {
    font-size: 1rem;
    min-height: 3.35rem;
    color: var(--fg-on-dark, #F8FAFC);
    border-color: rgba(255, 255, 255, 0.35);
  }
  .closing-cta-btn-secondary:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.65);
  }

  .closing-cta-trust {
    font-size: var(--fs-small, 0.875rem);
    color: var(--slate-400, #94A3B8);
    margin-top: var(--space-6, 1.75rem);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
  }

  .closing-cta-trust svg {
    color: var(--emerald, #059669);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .closing-cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>

<script>
  function setupDonateAnchorScroll() {
    const btn = document.getElementById('closing-donate-btn');
    if (!btn) return;

    btn.addEventListener('click', (e) => {
      const href = btn.getAttribute('href');
      if (href && href.startsWith('#')) {
        const target = document.querySelector(href);
        if (target) {
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          
          const calcCard = target.querySelector('.calculator-card') || target;
          (calcCard as HTMLElement).focus?.();
        }
      }
    });
  }

  setupDonateAnchorScroll();
  document.addEventListener('astro:page-load', setupDonateAnchorScroll);
</script>

