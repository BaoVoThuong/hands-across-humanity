---
interface Props {
  title?: string;
  lead?: string;
  donateUrl?: string;
  governanceUrl?: string;
}

const {
  title = "Empower a Community with Direct, Audited Aid.",
  lead = "Join over 8,400 regular monthly partners transforming lives through clean water, safe schools, and emergency recovery.",
  donateUrl = "#calculator",
  governanceUrl = "/who-we-are/"
} = Astro.props;
---

<section class="section section--dark" id="donate">
  <div class="container-narrow" style="text-align: center;">
    <h2 class="reveal" style="--i:1; margin-block: 0.5rem 1rem;">{title}</h2>
    <p class="lead reveal" style="--i:2; margin-inline: auto; color: var(--slate-300);">{lead}</p>

    <div class="btn-row reveal" style="--i:3; justify-content: center; margin-top: 2rem;">
      <a class="btn btn--primary" href={donateUrl} style="font-size: 1.125rem; min-height: 3.5rem; padding-inline: 2.5rem;">
        Make a Donation Now<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost" href={governanceUrl}>
        Learn About Governance
      </a>
    </div>

    <p style="font-size: 0.875rem; color: var(--slate-400); margin-top: 1.5rem; display: flex; align-items: center; justify-content: center; gap: 0.35rem;">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span>Secure 256-Bit Encrypted Payment · 100% Tax Deductible 501(c)(3)</span>
    </p>
  </div>
</section>
