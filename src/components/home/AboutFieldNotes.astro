---
import DeferredPicture from '../DeferredPicture.astro';
import RecentEvents from '../RecentEvents.astro';
import { getEvents } from '../../lib/events';
import {
  backpackStockpile,
  communitySupportWide,
  childrenOutreach,
  waterDelivery,
  reliefStation,
  supplyTableIndoor,
} from '../../assets/images/eps';

/* This section used to retell the process band above it in different words.
   It now does the job the band cannot: show that the work happens. Captions say
   what each photograph shows and nothing more — the event, place and date
   behind each one are not recorded anywhere on the site, so they are not guessed.

   The client asked for more photographs on this page, so a five-photo mosaic
   opens the section. Every photo here is a 2048px master and none repeats on
   this page; some also appear on Mission and Work. */
const { past } = await getEvents();
const recent = past.slice(0, 2);

const mosaic = [
  {
    image: communitySupportWide,
    alt: 'A wide view of a busy indoor hall with tables of donated goods and community members.',
    caption: 'A busy hall of donated goods',
  },
  {
    image: childrenOutreach,
    alt: 'Volunteers and schoolchildren holding school-supply kits, taken as a selfie.',
    caption: 'School kits with students',
  },
  {
    image: waterDelivery,
    alt: 'Three volunteers wheeling stacked cases of bottled water on a hand truck.',
    caption: 'Cases of water on the move',
  },
  {
    image: reliefStation,
    alt: 'Volunteers and community members, some in grey robes, at a table of goods under a pavilion.',
    caption: 'Neighbors at one table',
  },
  {
    image: supplyTableIndoor,
    alt: 'Health products and flyers on a round indoor table, with two volunteers behind it.',
    caption: 'Supplies set out at an event',
  },
];

const anchorStory = {
  image: backpackStockpile,
  alt: 'Two volunteers beside a large stack of new backpacks.',
  label: 'School kits, ready to share',
  caption: 'A wall of new backpacks gathered by volunteers.',
};

---

<section class="about-field-notes section section--sand" id="field-notes" aria-labelledby="field-notes-title">
  <div class="container">
    <div class="about-field-notes__intro reveal">
      <h2 id="field-notes-title">The work, in pictures.</h2>
      <p class="lead">Neighbors, volunteers, businesses, and local leaders at events we take part in.</p>
    </div>

    <ul class="about-mosaic" aria-label="Photographs from community events">
      {mosaic.map((photo, i) => (
        <li class:list={['about-mosaic__item', 'reveal', { 'about-mosaic__item--lead': i === 0 }]} style={`--i:${i + 1}`}>
          <figure>
            <DeferredPicture
              src={photo.image}
              widths={i === 0 ? [600, 900, 1300] : [400, 600, 800]}
              sizes={i === 0 ? '(min-width: 760px) 50vw, 100vw' : '(min-width: 760px) 25vw, 50vw'}
              quality={82}
              alt={photo.alt}
            />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="about-field-notes__anchor">
      <figure class="about-field-notes__anchor-media reveal" style="--i:1;">
        <DeferredPicture
          src={anchorStory.image}
          widths={[700, 1000, 1400]}
          sizes="(min-width: 960px) 58vw, 100vw"
          quality={85}
          alt={anchorStory.alt}
        />
        <figcaption>
          <span>{anchorStory.label}</span>
          <span>{anchorStory.caption}</span>
        </figcaption>
      </figure>

      <div class="about-field-notes__anchor-copy reveal" style="--i:2;">
        {recent.length > 0 ? (
          <Fragment>
            <h3>Recent events</h3>
            <RecentEvents events={recent} />
          </Fragment>
        ) : (
          <h3>Community events, alongside local partners.</h3>
        )}
        <a class="about-field-notes__link" href="/events/#field-record">See all events <span aria-hidden="true">→</span></a>
      </div>
    </div>

  </div>
</section>

<style>
  /* One large frame and four smaller ones. On phones the large frame runs full
     width and the rest sit two by two, so every photo stays on screen without
     a sideways scroll to discover. */
  .about-mosaic {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.2vw, 0.9rem);
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    padding: 0;
    list-style: none;
  }

  .about-mosaic__item {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--photo-mat, var(--surface-alt));
    box-shadow: var(--shadow-sm, 0 1px 3px rgba(15, 23, 42, 0.08));
  }

  .about-mosaic__item--lead {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }

  .about-mosaic figure {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .about-mosaic :global(picture),
  .about-mosaic :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .about-mosaic :global(img) {
    object-fit: cover;
    transition: transform 600ms var(--ease-out, ease);
  }

  .about-mosaic__item:hover :global(img) {
    transform: scale(1.03);
  }

  .about-mosaic figcaption {
    position: absolute;
    inset: auto 0 0;
    padding: 2rem 0.75rem 0.6rem;
    background: linear-gradient(to top, rgba(4, 14, 30, 0.78), rgba(4, 14, 30, 0));
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  @media (min-width: 760px) {
    .about-mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      aspect-ratio: 2.4 / 1;
    }

    .about-mosaic__item,
    .about-mosaic__item--lead {
      aspect-ratio: auto;
    }

    .about-mosaic__item--lead {
      grid-column: 1 / span 2;
      grid-row: 1 / span 2;
    }

    .about-mosaic figcaption {
      padding: 2.5rem 1rem 0.8rem;
      font-size: 0.875rem;
    }

    .about-mosaic__item--lead figcaption {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-mosaic :global(img) { transition: none; }
    .about-mosaic__item:hover :global(img) { transform: none; }
  }
</style>
