---
import { Picture } from 'astro:assets';
import {
  partnerCommunity,
  field03,
  field04,
  childrenOutreach,
  field07,
} from '../../assets/images/eps';

const anchorStory = {
  image: partnerCommunity,
  alt: 'Community partners gathered with prepared goods and family support.',
  label: 'Community in action',
  caption: 'People, goods, and local knowledge coming together.',
};

const fieldNotes = [
  {
    image: field03,
    alt: 'Volunteers taking part in a community distribution event with local residents.',
    title: 'Listen first',
    text: 'Local people and partners help identify what will be useful.',
  },
  {
    image: field04,
    alt: 'Volunteers preparing health and household supplies at a community donation table.',
    title: 'Prepare useful goods',
    text: 'Health, hygiene, household, and education items are organized for the moment.',
  },
  {
    image: childrenOutreach,
    alt: 'Volunteers sharing educational kits with children and families.',
    title: 'Share with dignity',
    text: 'Every handoff keeps children, families, older adults, and veterans at the center.',
  },
  {
    image: field07,
    alt: 'Community partners gathered during a local support activity.',
    title: 'Keep it local',
    text: 'Volunteers and partners help useful support reach the people and places closest to the need.',
  },
];
---

<section class="about-field-notes section section--sand" id="field-notes" aria-labelledby="field-notes-title">
  <div class="container">
    <div class="about-field-notes__intro reveal">
      <h2 id="field-notes-title">People make the support possible.</h2>
      <p class="lead">Neighbors, volunteers, businesses, and local leaders bring the work to life through real community activities.</p>
    </div>

    <div class="about-field-notes__anchor">
      <figure class="about-field-notes__anchor-media reveal" style="--i:1;">
        <Picture
          src={anchorStory.image}
          widths={[700, 1000, 1400]}
          sizes="(min-width: 960px) 58vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          quality={85}
          alt={anchorStory.alt}
          loading="lazy"
        />
        <figcaption>
          <span>{anchorStory.label}</span>
          <span>{anchorStory.caption}</span>
        </figcaption>
      </figure>

      <div class="about-field-notes__anchor-copy reveal" style="--i:2;">
        <h3>Support works best when people build it together.</h3>
        <p>A business can provide goods. Volunteers can prepare them. Local partners can help place them where they matter.</p>
        <a class="about-field-notes__link" href="/who-we-are/">Meet the network <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="about-field-notes__grid" aria-label="How our work shows up">
      {fieldNotes.map((note, index) => (
        <article class="about-field-notes__note reveal" style={`--i:${index + 3}`}>
          <div class="about-field-notes__note-media">
            <Picture
              src={note.image}
              widths={[400, 700]}
              sizes="(min-width: 960px) 22vw, 50vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={82}
              alt={note.alt}
              loading="lazy"
            />
          </div>
          <div class="about-field-notes__note-copy">
            <h3>{note.title}</h3>
            <p>{note.text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
