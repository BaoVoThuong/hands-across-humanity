---
import { Picture } from 'astro:assets';
import h1 from '../../assets/images/h1.jpg';
import h10 from '../../assets/images/h10.jpg';
import h12 from '../../assets/images/h12.jpg';
import h13 from '../../assets/images/h13.jpg';
import h14 from '../../assets/images/h14.jpg';

interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  donateUrl?: string;
  exploreUrl?: string;
}

const {
  kicker = "Grassroots Relief Network",
  title = "Direct, Transparent Aid Led by Local Communities.",
  lead = "We bridge global resources directly to ground-level humanitarian leaders - funding school supplies, community medical care, emergency food relief, and family support.",
  donateUrl = "#donate",
  exploreUrl = "#projects"
} = Astro.props;

const slides = [
  {
    image: h12,
    alt: "Dedicated volunteers standing together behind community outreach table showing heart hand gestures.",
    lead: "Community Outreach · Local Volunteers",
    title: "Community Connection Center: Dedicated volunteer teams connecting families directly with essential care."
  },
  {
    image: h1,
    alt: "Volunteers presenting Backpack Booster school supply kits to young students in school uniforms.",
    lead: "Youth Education · School Supply Drive",
    title: "School Backpack Project: Equipping primary students with essential learning supplies and backpacks."
  },
  {
    image: h10,
    alt: "Table arranged with health supplements, vitamins, first aid, and wellness care packages.",
    lead: "Health & Wellness · Medical Support",
    title: "Community Health Station: Distributing essential vitamins, first aid supplies, and wellness care items."
  },
  {
    image: h14,
    alt: "Three volunteers wheeling a heavy cart loaded with boxes of fresh pears and food items.",
    lead: "Food Security · Direct Relief",
    title: "Fresh Produce Distribution: Delivering fresh fruit boxes and food packages directly to families in need."
  },
  {
    image: h13,
    alt: "Large community group of volunteers and families holding holiday gift bags and packages.",
    lead: "Family Care · Holiday Gift Drive",
    title: "Community Gift Initiative: Spreading hope and holiday cheer through thousands of family care packages."
  }
];
---

<section class="hero-v2" id="hero">
  <div class="container">
    <div class="hero-v2__grid">
      <div class="hero-v2__copy">
        <div class="hero-v2__kicker reveal" style="--i:1">
          <span class="hero-v2__kicker-text">{kicker}</span>
        </div>

        <h1 class="hero-v2__title reveal" style="--i:2">{title}</h1>
        <p class="hero-v2__lead reveal" style="--i:3">{lead}</p>

        <div class="btn-row reveal" style="--i:4">
          <a class="btn btn--primary btn--lg" href={donateUrl}>
            Fund Direct Field Relief<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--ghost btn--lg" href={exploreUrl}>
            Explore Active Field Projects
          </a>
        </div>


      </div>

      <div class="hero-v2__media-col reveal" style="--i:3">
        <div class="hero-carousel" id="hero-carousel" aria-label="Field dispatch photo showcase" role="region">
          {/* Progress bar indicator */}
          <div class="hero-carousel__progress-track" aria-hidden="true">
            <div class="hero-carousel__progress-bar" id="hero-carousel-progress"></div>
          </div>

          {/* Slides stack */}
          <div class="hero-carousel__slides">
            {slides.map((slide, index) => (
              <div
                class={`hero-carousel__slide ${index === 0 ? 'is-active' : ''}`}
                data-slide-index={index}
                aria-hidden={index === 0 ? "false" : "true"}
              >
                <Picture
                  src={slide.image}
                  widths={[600, 900, 1200]}
                  sizes="(min-width: 960px) 55vw, 100vw"
                  formats={['avif', 'webp']}
                  fallbackFormat="jpeg"
                  quality={85}
                  alt={slide.alt}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                />
              </div>
            ))}
          </div>

          {/* Navigation Arrows (Visible on hover) */}
          <button class="hero-carousel__arrow hero-carousel__arrow--prev" id="hero-carousel-prev" aria-label="View previous field photo slide" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="hero-carousel__arrow hero-carousel__arrow--next" id="hero-carousel-next" aria-label="View next field photo slide" type="button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>

          {/* Indicator dots */}
          <div class="hero-carousel__indicators">
            {slides.map((_, index) => (
              <button
                class={`hero-carousel__dot ${index === 0 ? 'is-active' : ''}`}
                data-goto-slide={index}
                aria-label={`Go to slide ${index + 1}`}
                type="button"
              ></button>
            ))}
          </div>

          {/* Dynamic Caption */}
          <div class="hero-v2__caption">
            <div class="hero-v2__caption-header">
              <span class="hero-v2__caption-dot" aria-hidden="true"></span>
              <span class="hero-v2__caption-lead" id="hero-carousel-lead">{slides[0].lead}</span>
              <span class="hero-carousel__counter" id="hero-carousel-counter">1 / {slides.length}</span>
            </div>
            <p class="hero-v2__caption-text" id="hero-carousel-text">{slides[0].title}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const DURATION = 5000;
  const carousel = document.getElementById('hero-carousel');
  if (carousel) {
    const slides = carousel.querySelectorAll('.hero-carousel__slide');
    const progressBar = document.getElementById('hero-carousel-progress');
    const prevBtn = document.getElementById('hero-carousel-prev');
    const nextBtn = document.getElementById('hero-carousel-next');
    const dots = carousel.querySelectorAll('.hero-carousel__dot');
    const leadEl = document.getElementById('hero-carousel-lead');
    const textEl = document.getElementById('hero-carousel-text');
    const counterEl = document.getElementById('hero-carousel-counter');

    const slideData = [
      {
        lead: "Kitui County, Kenya · Clean Water",
        text: "Solar Water Well #42: Pure drinking water flow established for 1,400 families."
      },
      {
        lead: "Turkana District · Solar Filtration",
        text: "Solar-Powered Station: Delivering 5,000 liters of safe water daily."
      },
      {
        lead: "Kibera, Nairobi · School Infrastructure",
        text: "Classroom Reconstruction: Weatherproof roofing completed for 6 primary classrooms."
      },
      {
        lead: "Rift Valley, Kenya · Agricultural Cooperative",
        text: "Women's Farming Collective: Empowering 320 local families with irrigation & tools."
      },
      {
        lead: "Baringo Region · Education Grant",
        text: "Primary Learning Grant: Distributing textbooks & solar power to 500 students."
      }
    ];

    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let isHovered = false;

    function startProgressBar() {
      if (!progressBar) return;
      progressBar.style.transition = 'none';
      progressBar.style.width = '0%';
      // Trigger reflow to restart CSS transition
      void progressBar.offsetWidth;
      progressBar.style.transition = `width ${DURATION}ms linear`;
      progressBar.style.width = '100%';
    }

    function goToSlide(index: number) {
      if (index === currentIndex) return;
      slides[currentIndex]?.classList.remove('is-active');
      slides[currentIndex]?.setAttribute('aria-hidden', 'true');
      dots[currentIndex]?.classList.remove('is-active');

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex]?.classList.add('is-active');
      slides[currentIndex]?.setAttribute('aria-hidden', 'false');
      dots[currentIndex]?.classList.add('is-active');

      if (leadEl && slideData[currentIndex]) leadEl.textContent = slideData[currentIndex].lead;
      if (textEl && slideData[currentIndex]) textEl.textContent = slideData[currentIndex].text;
      if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${slides.length}`;

      restartTimer();
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startTimer() {
      stopTimer();
      startProgressBar();
      timer = setInterval(() => {
        if (!isHovered) {
          nextSlide();
        }
      }, DURATION);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function restartTimer() {
      stopTimer();
      startTimer();
    }

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      prevSlide();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      nextSlide();
    });

    dots.forEach((dot, idx) => {
      dot.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(idx);
      });
    });

    carousel.addEventListener('mouseenter', () => {
      isHovered = true;
    });

    carousel.addEventListener('mouseleave', () => {
      isHovered = false;
    });

    carousel.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        nextSlide();
      }
    });

    // Touch swipe gesture handling for mobile devices
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].clientX;
    }, { passive: true });

    carousel.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].clientX;
      const swipeDistance = touchEndX - touchStartX;
      if (Math.abs(swipeDistance) > 40) {
        if (swipeDistance < 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
    }, { passive: true });

    startTimer();
  }
</script>


