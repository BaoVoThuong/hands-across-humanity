---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/images/hero-connection.png';

interface Props {
  title?: string;
  lead?: string;
  donateUrl?: string;
  exploreUrl?: string;
}

const {
  title = "Direct, Transparent Aid Led by Local Communities.",
  lead = "We bridge global resources directly to ground-level humanitarian leaders—funding clean water systems, school construction, emergency relief, and community self-reliance.",
  donateUrl = "#donate",
  exploreUrl = "#projects"
} = Astro.props;
---

<section class="hero-v2" id="hero">
  <div class="container">
    <div class="hero-v2__grid">
      <div class="hero-v2__copy">
        <h1 class="hero-v2__title reveal" style="--i:1">{title}</h1>
        <p class="lead reveal" style="--i:2">{lead}</p>

        <div class="btn-row reveal" style="--i:3; margin-top: 1.75rem;">
          <a class="btn btn--primary" href={donateUrl}>
            Donate Now<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--secondary" href={exploreUrl}>
            Explore Field Projects
          </a>
        </div>

        <div class="hero-v2__proof reveal" style="--i:4">
          <div class="proof-stat">
            <span class="proof-stat__num">94%</span>
            <span class="proof-stat__label">Direct Program Allocation</span>
          </div>
          <div class="proof-stat">
            <span class="proof-stat__num">$0</span>
            <span class="proof-stat__label">Middleman Fees</span>
          </div>
          <div class="proof-stat">
            <span class="proof-stat__num">100%</span>
            <span class="proof-stat__label">Audited Receipts</span>
          </div>
        </div>
      </div>

      <div class="hero-v2__media reveal" style="--i:4">
        <Picture
          src={heroImage}
          widths={[600, 900, 1200]}
          sizes="(min-width: 960px) 50vw, 100vw"
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          quality={75}
          alt="Community members collaborating hand to hand near a transport vehicle."
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero-v2__dispatch-card">
          <span class="dispatch-card__tag">Verified Dispatch</span>
          <p class="dispatch-card__text">
            <strong>Kitui County Well #42:</strong> Clean water flow established for 1,400 local families.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
