---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  title?: string;
  faqs: FaqItem[];
}

const {
  title = "Everything You Need to Know",
  faqs
} = Astro.props;
---

<section class="section section--paper" id="faq">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <h2>{title}</h2>
    </div>

    <div class="faq-list reveal" style="--i:2">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary class="faq-summary">{faq.q}</summary>
          <div class="faq-content">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
