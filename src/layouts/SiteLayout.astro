---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/public-sans';
import '../styles/global.css';

interface RailItem { id: string; label: string; }
interface Props {
  title: string;
  description: string;
  activePage?: string;
  sections?: RailItem[];
}

const { title, description, activePage = '', sections = [] } = Astro.props;

const navItems = [
  { href: '/mission/', label: 'Mission', key: 'mission' },
  { href: '/what-we-do/', label: 'What We Do', key: 'what-we-do' },
  { href: '/vision/', label: 'Vision', key: 'vision' },
  { href: '/who-we-are/', label: 'Who We Are', key: 'who-we-are' }
];

// Placeholder until the client confirms a donation platform. Kept in one place
// so every Donate control on the site points at the same target.
const donateHref = '/#donate';
---

<!doctype html>
<html lang="en" class="snap">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hands Across Humanity" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['NGO', 'Organization'],
      name: 'Hands Across Humanity',
      description
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <header class="site-header" data-header>
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
            <path d="M10 28.5c3.8-3.5 7.3-4.2 10.5-2.1l4.3 2.8c1.4.9 3.2.5 4.1-.9l5.9-9.1c1-1.6 3.1-2 4.6-.9 1.3.9 1.7 2.7 1 4.1l-5.5 11.2c-1.8 3.7-5.7 6-9.8 5.8-4.9-.2-8.3-2.2-11.5-5.1L10 30.8a1.5 1.5 0 0 1 0-2.3Z" />
            <path d="M25.7 28.7 20 20.2c-1-1.5-.6-3.5.9-4.5 1.3-.9 3-.7 4.1.4l5.4 5.7" />
            <path d="m30.4 23.1-4.2-8.5c-.8-1.6-.1-3.5 1.5-4.3 1.5-.7 3.3-.1 4.1 1.3l3.8 7.2" />
          </svg>
          <span class="brand__name">Hands Across <span>Humanity</span></span>
        </a>

        <nav class="desktop-nav" aria-label="Main">
          {navItems.map((item) => (
            <a
              class:list={{ 'is-active': activePage === item.key }}
              href={item.href}
              aria-current={activePage === item.key ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <a class="btn btn--donate btn--header" href={donateHref}>
            Donate<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <button class="menu-toggle" type="button" aria-controls="primary-menu" aria-expanded="false" aria-label="Open main menu">
            <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
          </button>
        </div>
      </div>
      <div class="site-header__progress" data-progress aria-hidden="true"></div>
    </header>

    <div class="mobile-menu" id="primary-menu" hidden>
      <button class="mobile-menu__backdrop" type="button" tabindex="-1" aria-label="Close main menu"></button>
      <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Main menu">
        <nav aria-label="Main">
          <a class:list={{ 'is-active': activePage === '' }} href="/">Home</a>
          {navItems.map((item) => (
            <a
              class:list={{ 'is-active': activePage === item.key }}
              href={item.href}
              aria-current={activePage === item.key ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>
        <div class="mobile-menu__cta">
          <a class="btn btn--donate" href={donateHref}>Donate<span class="btn__arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>


    <slot />

    <footer class="site-footer" id="footer">
      <div class="container">
        <div class="footer-top">
          <div class="footer-brand">
            <a class="brand brand--footer" href="/">
              <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                <path d="M10 28.5c3.8-3.5 7.3-4.2 10.5-2.1l4.3 2.8c1.4.9 3.2.5 4.1-.9l5.9-9.1c1-1.6 3.1-2 4.6-.9 1.3.9 1.7 2.7 1 4.1l-5.5 11.2c-1.8 3.7-5.7 6-9.8 5.8-4.9-.2-8.3-2.2-11.5-5.1L10 30.8a1.5 1.5 0 0 1 0-2.3Z" />
                <path d="M25.7 28.7 20 20.2c-1-1.5-.6-3.5.9-4.5 1.3-.9 3-.7 4.1.4l5.4 5.7" />
                <path d="m30.4 23.1-4.2-8.5c-.8-1.6-.1-3.5 1.5-4.3 1.5-.7 3.3-.1 4.1 1.3l3.8 7.2" />
              </svg>
              <span class="brand__name">Hands Across <span>Humanity</span></span>
            </a>
            <p>Help that goes sideways — from people who can, to people who need it, through people who are already there.</p>
            <a class="btn btn--donate" href={donateHref}>Donate<span class="btn__arrow" aria-hidden="true">→</span></a>
          </div>
          <nav class="footer-nav" aria-label="Footer">
            <div>
              <p class="footer-label">Explore</p>
              <a href="/">Home</a>
              {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
            </div>
            <div>
              <p class="footer-label">Launch notes</p>
              <p class="footer-note">Illustrative placeholder images are used in this first build. Replace them with consent-cleared documentary photographs before launch.</p>
            </div>
          </nav>
        </div>
        <div class="footer-bottom">
          <p>Illustrative imagery must be replaced before launch.</p>
          <p>&copy; {new Date().getFullYear()} Hands Across Humanity.</p>
        </div>
      </div>
    </footer>

    <script>
      // ---------- Mobile menu ----------
      const toggle = document.querySelector('.menu-toggle');
      const menu = document.querySelector('#primary-menu');
      const backdrop = menu?.querySelector('.mobile-menu__backdrop');
      const menuLinks = [...(menu?.querySelectorAll('a') ?? [])];
      const main = document.querySelector('main');
      const footer = document.querySelector('footer');
      let lastFocused = null;

      const setInert = (value) => {
        [main, footer].forEach((el) => {
          if (!el) return;
          if (value) el.setAttribute('inert', '');
          else el.removeAttribute('inert');
        });
      };

      const closeMenu = () => {
        if (!menu || !toggle) return;
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open main menu');
        document.documentElement.classList.remove('menu-open');
        setInert(false);
        lastFocused?.focus();
        lastFocused = null;
      };

      const openMenu = () => {
        if (!menu || !toggle) return;
        lastFocused = document.activeElement;
        menu.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Close main menu');
        document.documentElement.classList.add('menu-open');
        setInert(true);
        menuLinks[0]?.focus();
      };

      toggle?.addEventListener('click', () =>
        toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()
      );
      backdrop?.addEventListener('click', closeMenu);
      menuLinks.forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => {
        if (toggle?.getAttribute('aria-expanded') !== 'true') return;
        if (event.key === 'Escape') { closeMenu(); return; }
        if (event.key === 'Tab' && menuLinks.length) {
          const first = menuLinks[0];
          const last = menuLinks[menuLinks.length - 1];
          if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
          else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
        }
      });

      // ---------- Header state + scroll progress ----------
      const header = document.querySelector('[data-header]');
      const progress = document.querySelector('[data-progress]');
      let ticking = false;

      const onScroll = () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 8);
        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          progress.style.setProperty('--progress', max > 0 ? String(Math.min(window.scrollY / max, 1)) : '0');
        }
        ticking = false;
      };
      const requestScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(onScroll);
      };
      onScroll();
      window.addEventListener('scroll', requestScroll, { passive: true });
      window.addEventListener('resize', requestScroll, { passive: true });

      // ---------- Reveal + section spy ----------
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      const revealItems = [...document.querySelectorAll('.reveal')];

      if (reduce.matches) {
        revealItems.forEach((el) => el.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        revealItems.forEach((el) => revealObserver.observe(el));
      }

    </script>
  </body>
</html>
