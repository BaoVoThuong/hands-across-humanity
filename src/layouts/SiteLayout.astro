---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/public-sans';
import '../styles/global.css';
import BackToTop from '../components/ui/BackToTop.astro';
import logoImage from '../assets/images/Logo.svg';

interface Props {
  title: string;
  description: string;
  activePage?: string;
}

const { title, description, activePage = '' } = Astro.props;

const navItems = [
  { href: '/mission/', label: 'Mission', key: 'mission' },
  { href: '/what-we-do/', label: 'What We Do', key: 'what-we-do' },
  { href: '/vision/', label: 'Vision', key: 'vision' },
  { href: '/who-we-are/', label: 'Who We Are', key: 'who-we-are' }
];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hands Across Humanity" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': ['NGO', 'Organization'],
      name: 'Hands Across Humanity',
      description
    })} />
  </head>
  <body class:list={{ 'site-body--editorial': Boolean(activePage) }}>
    <!--
    THESIS: High-impact commercial humanitarian platform with elevated visual hierarchy, structured proof points, interactive impact controls, rich project cards, and clean typography.
    OWN-WORLD: Palette: White ground (#FFFFFF), brand navy (#12284C), signal blue (#0060AE), deep indigo donate fill (#160042), gold accent (#F8B33D). Typography: Montserrat + Public Sans.
    STORY: Visitors instantly grasp the mission, explore active field projects, view field stories & proof points, and follow the work through prominent CTAs.
    FIRST VIEWPORT: Split hero with bold headline, action CTAs, real-time live field badge overlay, and stats bar.
    FORM: Form 4 candidate, seed bd589f42.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->

    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Header / Masthead -->
    <header class="site-header" data-header>
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label="Hands Across Humanity About Us">
          <div class="brand__logo-container">
            <img src={logoImage.src} alt="" width="36" height="32" class="brand__logo-img" />
          </div>
          <span class="brand__name">Hands Across <span>Humanity</span></span>
        </a>

        <nav class="desktop-nav" aria-label="Main navigation">
          <a class:list={{ 'is-active': activePage === '' }} href="/">About Us</a>
          {navItems.map((item) => (
            <a
              class:list={{ 'is-active': activePage === item.key }}
              href={item.href}
              aria-current={activePage === item.key ? 'page' : undefined}
            >{item.label}</a>
          ))}
        </nav>

        <div class="header-actions">
          <button class="menu-toggle" type="button" aria-controls="primary-menu" aria-expanded="false" aria-label="Open main menu">
            <span class="menu-toggle__icon" aria-hidden="true"><i></i><i></i></span>
          </button>
        </div>
      </div>
      <div class="site-header__progress" data-progress aria-hidden="true"></div>
    </header>

    <!-- Mobile Drawer Navigation -->
    <div class="mobile-menu" id="primary-menu" hidden>
      <button class="mobile-menu__backdrop" type="button" tabindex="-1" aria-label="Close menu"></button>
      <div class="mobile-menu__panel" role="dialog" aria-modal="true" aria-label="Main menu">
        <nav aria-label="Mobile Navigation">
          <a class:list={{ 'is-active': activePage === '' }} href="/">About Us</a>
          {navItems.map((item) => (
            <a
              class:list={{ 'is-active': activePage === item.key }}
              href={item.href}
            >{item.label}</a>
          ))}
        </nav>
      </div>
    </div>

    <!-- Main Content Slot -->
    <slot />

    <!-- Return to Top Button -->
    <BackToTop />

    <!-- Site Footer -->
    <footer class="site-footer" id="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-col" style="max-width: 32ch;">
            <a class="brand" href="/" style="margin-bottom: 0.5rem;" aria-label="Hands Across Humanity About Us">
              <div class="brand__logo-container">
                <img src={logoImage.src} alt="" width="36" height="32" class="brand__logo-img" />
              </div>
              <span class="brand__name" style="color: #FFFFFF;">Hands Across <span style="color: #E09B78;">Humanity</span></span>
            </a>
            <p style="color: #94A3B8; font-size: 0.9375rem;">We connect practical donations with trusted community partners so support can be shared with dignity.</p>
          </div>

          <div class="footer-col">
            <h4>Organization</h4>
            <a href="/">About Us</a>
            <a href="/mission/">Our Mission</a>
            <a href="/what-we-do/">What We Do</a>
            <a href="/vision/">Vision & Values</a>
            <a href="/who-we-are/">Who We Are</a>
          </div>

          <div class="footer-col">
            <h4>Ways to help</h4>
            <a href="/#donate">Give useful goods</a>
            <a href="/mission/">Volunteer</a>
            <a href="/vision/">Partner with us</a>
            <a href="/what-we-do/">See our work</a>
          </div>

          <div class="footer-col">
            <h4>Stay Connected</h4>
            <p style="color: #94A3B8; font-size: 0.875rem;">Receive occasional updates about community support and ways to help.</p>
            <form class="footer-newsletter" onsubmit="event.preventDefault(); alert('Thank you for staying connected with Hands Across Humanity.');">
              <input type="email" placeholder="Enter your email address" required aria-label="Email address for field updates" />
              <button type="submit" class="btn btn--primary" style="min-height: auto; padding: 0.6rem 1.25rem;">Subscribe</button>
            </form>
          </div>
        </div>

        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Hands Across Humanity. Registered 501(c)(3) Public Charity.</p>
          <p>Community updates · Clear accountability · Privacy Policy</p>
        </div>
      </div>
    </footer>

    <script>
      // Navigation Toggle Script
      const toggle = document.querySelector('.menu-toggle');
      const menu = document.querySelector('#primary-menu') as HTMLElement | null;
      const backdrop = menu?.querySelector('.mobile-menu__backdrop');

      const closeMenu = () => {
        if (!menu || !toggle) return;
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('menu-open');
      };

      const openMenu = () => {
        if (!menu || !toggle) return;
        menu.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('menu-open');
      };

      toggle?.addEventListener('click', () =>
        toggle.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()
      );
      backdrop?.addEventListener('click', closeMenu);

      // Scroll Progress Indicator
      const header = document.querySelector('[data-header]');
      const progress = document.querySelector('[data-progress]') as HTMLElement | null;
      
      window.addEventListener('scroll', () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 10);
        if (progress) {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          progress.style.setProperty('--progress', String(ratio));
        }
      }, { passive: true });

      // Reveal Animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Precision Smooth Anchor Scrolling Handler
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a[href*="#"]');
        if (!link) return;

        const href = link.getAttribute('href');
        if (!href) return;

        // Parse link destination
        let targetId = '';
        if (href.startsWith('#')) {
          targetId = href;
        } else if (href.includes('#')) {
          const parts = href.split('#');
          if (parts[0] === '' || parts[0] === '/' || parts[0] === window.location.pathname) {
            targetId = '#' + parts[1];
          }
        }

        if (!targetId || targetId === '#') return;

        const targetEl = document.querySelector(targetId);
        if (targetEl) {
          e.preventDefault();
          closeMenu();

          const headerEl = document.querySelector('[data-header]');
          const headerH = headerEl ? headerEl.getBoundingClientRect().height : 76;
          const targetTop = targetEl.getBoundingClientRect().top + window.scrollY - headerH - 8;

          window.scrollTo({
            top: Math.max(0, targetTop),
            behavior: 'smooth'
          });

          if (history.pushState) {
            history.pushState(null, '', targetId);
          }
        }
      });
    </script>
  </body>
</html>
