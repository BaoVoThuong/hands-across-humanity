---
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import DonationMoment from '../components/DonationMoment.astro';
import { partnerCommunity } from '../assets/images/eps';

/* Vision states the local base before the ambition. It used to open on "a
   nation", while the only place the site names is Houston and every dated event
   is in the Houston area. Monthly giving now closes the page, after the case for
   staying close to people has been made rather than before it. */

const sections = [
  { id: 'top', label: 'Vision' },
  { id: 'principles', label: 'Partners' },
  { id: 'belief', label: 'Staying local' },
];

const heroSignals = [
  {
    title: 'Connected communities',
    text: 'People and partners ready to respond before hardship grows.',
  },
  {
    title: 'Shared resources',
    text: 'Surplus goods become practical support for a real need.',
  },
  {
    title: 'Local reach',
    text: 'A wider network grows from Houston outward.',
  },
];
---

<EditorialPage
  activePage="vision"
  title="No one should face a hard moment alone."
  lead="It starts in the Houston area: coordinated support that reaches people before a difficult moment becomes prolonged hardship."
  description="Hands Across Humanity is growing a network of businesses, houses of worship, nonprofits, and neighbors that turns spare goods into dependable local support, starting in the Houston area."
  image={partnerCommunity}
  imageAlt="Community partners and families gathered with prepared support packages."
  caption="Partners sharing prepared goods with families and communities."
  heroSignals={heroSignals}
  sections={sections}
  total={3}
>
  <!-- 02: Partners -->
  <Panel id="principles" ground="sand" index={2} total={3} label="Partners" labelledby="vision-principles-title" nextId="belief" nextLabel="Staying local">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <h2 class="reveal" style="--i:1" id="vision-principles-title">Build a wider circle of support.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Each kind of partner brings something different to the same work.</p>
    </div>
    <div class="principles principles--editorial">
      <article class="principle-item reveal" style="--i:3">
        <header class="principle-item__head">
          <span class="principle-item__num">01</span>
          <span class="principle-item__kicker">Broad coalition</span>
        </header>
        <h3 class="principle-item__title">Work across boundaries</h3>
        <p class="principle-item__body">Businesses, houses of worship, nonprofits, volunteers, and local stakeholders each bring a different way to help.</p>
      </article>

      <article class="principle-item reveal" style="--i:4">
        <header class="principle-item__head">
          <span class="principle-item__num">02</span>
          <span class="principle-item__kicker">Useful resources</span>
        </header>
        <h3 class="principle-item__title">Turn availability into support</h3>
        <p class="principle-item__body">We help useful products move from businesses and contributors to people who can use them when needs are urgent.</p>
      </article>

      <article class="principle-item reveal" style="--i:5">
        <header class="principle-item__head">
          <span class="principle-item__num">03</span>
          <span class="principle-item__kicker">Shared impact</span>
        </header>
        <h3 class="principle-item__title">Grow local capacity</h3>
        <p class="principle-item__body">Coordinated, non-discriminatory action helps partners reach further together.</p>
      </article>
    </div>
  </Panel>

  <!-- 03: Staying local -->
  <Panel id="belief" ground="paper" index={3} total={3} label="Staying local" labelledby="belief-title">
    <div class="panel-head">
      <h2 class="reveal" style="--i:1" id="belief-title">Support should stay close to the people it serves.</h2>
    </div>

    <div class="modest-flow reveal" style="--i:2">
      <div class="modest-step">
        <span class="modest-step__num">01</span>
        <h3 class="modest-step__title">Start with people</h3>
        <p class="modest-step__desc">Practical aid for people facing a difficult moment, shared with dignity.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">02</span>
        <h3 class="modest-step__title">Build trust locally</h3>
        <p class="modest-step__desc">Bring local leaders, faith communities, volunteers, and businesses into a response people can recognize and trust.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">03</span>
        <h3 class="modest-step__title">Grow the network</h3>
        <p class="modest-step__desc">Bring more partners into the network as trust builds.</p>
      </div>
    </div>
  </Panel>

  <!-- Monthly giving belongs here: it is the long-term ask on the long-term page. -->
  <DonationMoment
    title="Become a monthly partner in the work."
    text="Monthly gifts help keep practical support ready as local needs change and the network grows."
    ctaLabel="Explore monthly giving"
    href="/donate/?frequency=monthly&focus=community"
  />
</EditorialPage>
