---
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import { partnerCommunity } from '../assets/images/eps';

const sections = [
  { id: 'top', label: 'Vision' },
  { id: 'principles', label: 'Coalition' },
  { id: 'belief', label: 'Reach' }
];
---

<EditorialPage
  activePage="vision"
  eyebrow="Our vision"
  title="A nation where no one faces crisis alone."
  lead="We believe coordinated support should reach people in need before a difficult moment becomes prolonged hardship."
  description="We envision strong, scalable partnerships between businesses of every size, houses of worship, nonprofits, and local stakeholders that turn surplus resources into practical support."
  image={partnerCommunity}
  imageAlt="Community partners and families gathered with prepared support packages."
  caption="Partners sharing prepared goods with families and communities."
  nextHref="/who-we-are/"
  nextLabel="Meet the people behind the work"
  sections={sections}
  total={3}
>
  <!-- 02: Coalition & Principles -->
  <Panel id="principles" ground="sand" index={2} total={3} label="Coalition" labelledby="vision-principles-title" nextId="belief" nextLabel="Reach">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">A wider circle of care</p>
        <h2 class="reveal" style="--i:1" id="vision-principles-title">Make every donation count.</h2>
      </div>
      <p class="lead reveal" style="--i:2">We build strong partnerships that bridge the gap between available resources and urgent community needs.</p>
    </div>
    <div class="principles principles--editorial">
      <article class="principle-item reveal" style="--i:3">
        <header class="principle-item__head">
          <span class="principle-item__num">01</span>
          <span class="principle-item__kicker">Broad coalition</span>
        </header>
        <h3 class="principle-item__title">Work across boundaries</h3>
        <p class="principle-item__body">Businesses, houses of worship, nonprofits, volunteers, and local stakeholders each bring a different way to help.</p>
      </article>

      <article class="principle-item reveal" style="--i:4">
        <header class="principle-item__head">
          <span class="principle-item__num">02</span>
          <span class="principle-item__kicker">Useful resources</span>
        </header>
        <h3 class="principle-item__title">Turn surplus into support</h3>
        <p class="principle-item__body">We help useful products move from businesses and donors to people who can use them when needs are urgent.</p>
      </article>

      <article class="principle-item reveal" style="--i:5">
        <header class="principle-item__head">
          <span class="principle-item__num">03</span>
          <span class="principle-item__kicker">Shared impact</span>
        </header>
        <h3 class="principle-item__title">Multiply care</h3>
        <p class="principle-item__body">Non-discriminatory action helps many partners extend practical support further than any one organization could alone.</p>
      </article>
    </div>
  </Panel>

  <!-- 03: Reach & Bridges -->
  <Panel id="belief" ground="paper" index={3} total={3} label="Reach" labelledby="belief-title" ctaHref="/who-we-are/" ctaLabel="Meet the people">
    <div class="panel-head">
      <p class="eyebrow reveal">Bridges of support</p>
      <h2 class="reveal" style="--i:1" id="belief-title">Support should stay close to the people it serves.</h2>
    </div>

    <!-- 3-Step Modest Action Flow -->
    <div class="modest-flow reveal" style="--i:2">
      <div class="modest-step">
        <span class="modest-step__num">01</span>
        <h3 class="modest-step__title">Protect people</h3>
        <p class="modest-step__desc">Coordinate practical aid for children, families, veterans, older adults, and communities facing a difficult moment.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">02</span>
        <h3 class="modest-step__title">Build trust locally</h3>
        <p class="modest-step__desc">Bring local leaders, faith communities, volunteers, and businesses into a response people can recognize and trust.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">03</span>
        <h3 class="modest-step__title">Multiply impact</h3>
        <p class="modest-step__desc">Build bridges of practical support that can grow from Houston to communities facing urgent need.</p>
      </div>
    </div>

    <div class="columns columns--wide prose reveal" style="--i:3; margin-top: var(--space-6);">
      <p>From Houston outward, Hands Across Humanity builds practical connections that protect vulnerable people and strengthen communities.</p>
      <p>We show how efficient, non-discriminatory action can unite diverse partners and multiply impact far beyond what any single organization could achieve alone.</p>
    </div>

    <blockquote class="editorial-quote reveal" style="--i:4; margin-top: var(--space-7);">
      <p class="editorial-quote__text">“Efficient, non-discriminatory action can multiply impact far beyond any single organization.”</p>
      <cite class="editorial-quote__cite">Hands Across Humanity vision statement</cite>
    </blockquote>
  </Panel>
</EditorialPage>
