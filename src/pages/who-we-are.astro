---
import { Picture } from 'astro:assets';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import publicCommunityTree from '../assets/images/public-community-tree.jpg';
import publicVolunteerFood from '../assets/images/public-volunteer-food.jpg';

const sections = [
  { id: 'top', label: 'Who we are' },
  { id: 'model', label: 'How we work' },
  { id: 'practice', label: 'In practice' }
];
---

<EditorialPage
  activePage="who-we-are"
  eyebrow="Who we are"
  title="The people closest to the work lead it."
  lead="A small humanitarian organisation with a clear job: make local work possible, then be honest about how it goes."
  description="Hands Across Humanity works through community groups, local staff, teachers, nurses, volunteers and neighbours."
  image={publicCommunityTree}
  imageAlt="Local community members and leaders gathered together under a tree during a field consultation."
  caption="People who live close to the work should lead it."
  nextHref="/mission/"
  nextLabel="Read our mission"
  sections={sections}
  total={3}
>
  <!-- 02 — Model -->
  <Panel id="model" ground="sand" index={2} total={3} label="How we work" labelledby="model-title" nextId="practice" nextLabel="In practice">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">A small organisation with a clear job</p>
        <h2 class="reveal" style="--i:1" id="model-title">We are not the experts. The people we work with are.</h2>
      </div>
      <p class="lead reveal" style="--i:2">We raise support from people who want to help, and put it to work through people who already live in the places we support.</p>
    </div>

    <!-- Editorial Flat Layout (No cards, sharp edges, pure editorial hairlines) -->
    <div class="model-showcase">
      <div class="model-showcase__content reveal" style="--i:3">
        <blockquote class="model-quote">
          <p>“They know which family was missed, which road is open and what will still be needed in six months.”</p>
        </blockquote>

        <div class="model-editorial-block">
          <div class="model-editorial-block__meta">
            <span class="model-editorial-block__label">Local Leadership</span>
            <span class="model-editorial-block__sep" aria-hidden="true">|</span>
            <span class="model-editorial-block__tag">Grassroots First</span>
          </div>
          <p class="model-editorial-block__lead">
            That includes community groups, local staff, teachers, nurses, volunteers and neighbours who live close to the daily reality.
          </p>
          <p class="model-editorial-block__body">
            Outsiders can bring money, supplies and attention. Our responsibility is to bring those resources without taking over decisions that belong to the community.
          </p>
        </div>
      </div>

      <figure class="model-showcase__media reveal" style="--i:4">
        <div class="model-showcase__image-frame">
          <Picture
            src={publicVolunteerFood}
            widths={[600, 900, 1200]}
            sizes="(min-width: 940px) 46vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={75}
            alt="Local volunteers organizing fresh food and community supplies."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Local groups run the work; we make it possible.</figcaption>
      </figure>
    </div>

    <!-- Trust & Verification Bar -->
    <div class="process-guarantee-bar reveal" style="--i:5; margin-top:var(--space-7);">
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>100% Community-Led Projects</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Independent Financial Audit</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--slate-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span>Direct Field Verification</span>
      </div>
    </div>
  </Panel>

  <!-- 03 — Practice -->
  <Panel id="practice" ground="paper" index={3} total={3} label="In practice" labelledby="practice-title" ctaHref="/mission/" ctaLabel="Read our mission">
    <div class="panel-head">
        <p class="eyebrow reveal">How that shows up</p>
      <h2 class="reveal" style="--i:1" id="practice-title">Three habits, kept in public.</h2>
    </div>
    <!-- 3-Step Action Habits Flow (styled like vision.astro modest-flow) -->
    <div class="modest-flow reveal" style="--i:2">
      <div class="modest-step">
        <span class="modest-step__num">01</span>
        <h3 class="modest-step__title">We listen before we act</h3>
        <p class="modest-step__desc">A plan starts with local knowledge, not a template brought from somewhere else.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">02</span>
        <h3 class="modest-step__title">We work through relationships</h3>
        <p class="modest-step__desc">Trust is built by showing up consistently and keeping promises small enough to keep.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">03</span>
        <h3 class="modest-step__title">We tell the truth plainly</h3>
        <p class="modest-step__desc">We share what happened, what changed and what did not work, without hiding behind jargon.</p>
      </div>
    </div>
    <blockquote class="editorial-quote reveal" style="--i:3; margin-top: var(--space-7);">
      <p class="editorial-quote__text">“Help does not fall on people from above. It reaches sideways.”</p>
      <cite class="editorial-quote__cite">— K’Bình, Community Organizer & Field Partner, Quảng Nam</cite>
    </blockquote>
  </Panel>
</EditorialPage>
