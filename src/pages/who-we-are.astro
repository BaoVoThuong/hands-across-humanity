---
import { Picture } from 'astro:assets';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import h12 from '../assets/images/h12.jpg';
import h15 from '../assets/images/h15.jpg';

const sections = [
  { id: 'top', label: 'Who we are' },
  { id: 'model', label: 'Why it matters' },
  { id: 'practice', label: 'Our model' }
];
---

<EditorialPage
  activePage="who-we-are"
  eyebrow="Who we are"
  title="Why Hands Across Humanity Matters."
  lead="When disaster strikes, the difference between recovery and prolonged hardship often comes down to speed, coordination, and the right supplies in the right hands. Hands Across Humanity exists to close that gap."
  description="We focus on the practical work of collecting, staging, and distributing products that keep people safe, healthy, and able to rebuild—while partnering with businesses that want their resources to reach those who need them most."
  image={h12}
  imageAlt="Dedicated community volunteers standing together behind support center table."
  caption="Closing the gap between crisis and recovery through rapid logistics."
  nextHref="/mission/"
  nextLabel="Read our mission"
  sections={sections}
  total={3}
>
  <!-- 02 — Model & Logistics -->
  <Panel id="model" ground="sand" index={2} total={3} label="Why it matters" labelledby="model-title" nextId="practice" nextLabel="Our model">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">Practical Disaster Logistics</p>
        <h2 class="reveal" style="--i:1" id="model-title">Collecting, staging, and distributing essential supplies when disaster strikes.</h2>
      </div>
      <p class="lead reveal" style="--i:2">We focus on the essential work that keeps people safe, healthy, and able to rebuild—connecting corporate surplus directly to frontline community needs.</p>
    </div>

    <!-- Editorial Showcase Layout -->
    <div class="model-showcase">
      <div class="model-showcase__content reveal" style="--i:3">
        <blockquote class="model-quote">
          <p>“Speed, coordination, and the right supplies in the right hands make the difference between recovery and prolonged hardship.”</p>
        </blockquote>

        <div class="model-editorial-block">
          <div class="model-editorial-block__meta">
            <span class="model-editorial-block__label">Scalable Logistics</span>
            <span class="model-editorial-block__sep" aria-hidden="true">|</span>
            <span class="model-editorial-block__tag">Non-Discriminatory Service</span>
          </div>
          <p class="model-editorial-block__lead">
            Our model is designed for scalability and accountability: clear logistics, volunteer and fleet capacity, transparent partnerships, and a commitment to serving every community without discrimination.
          </p>
          <p class="model-editorial-block__body">
            This approach creates measurable value for donors, corporate partners, and the public—demonstrating that smart, rapid humanitarian logistics can save lives and reduce long-term costs of recovery.
          </p>
        </div>
      </div>

      <figure class="model-showcase__media reveal" style="--i:4">
        <div class="model-showcase__image-frame">
          <Picture
            src={h15}
            widths={[600, 900, 1200]}
            sizes="(min-width: 940px) 46vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={75}
            alt="Dedicated community health volunteers smiling outside the venue."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Practical staging & fleet logistics delivering aid directly where needed.</figcaption>
      </figure>
    </div>

    <!-- Trust & Verification Bar -->
    <div class="process-guarantee-bar reveal" style="--i:5; margin-top:var(--space-7);">
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>100% Non-Discriminatory Service</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Transparent Fleet Logistics & Audit</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--slate-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span>Measurable Recovery Value</span>
      </div>
    </div>
  </Panel>

  <!-- 03 — Practice / Our Model -->
  <Panel id="practice" ground="paper" index={3} total={3} label="Our model" labelledby="practice-title" ctaHref="/mission/" ctaLabel="Read our mission">
    <div class="panel-head">
      <p class="eyebrow reveal">Scalability & Accountability</p>
      <h2 class="reveal" style="--i:1" id="practice-title">Three pillars of our operating model.</h2>
    </div>
    
    <div class="modest-flow reveal" style="--i:2">
      <div class="modest-step">
        <span class="modest-step__num">01</span>
        <h3 class="modest-step__title">Speed & Coordination</h3>
        <p class="modest-step__desc">Collecting, staging, and distributing essential products swiftly to keep people safe and healthy after catastrophe.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">02</span>
        <h3 class="modest-step__title">Fleet & Volunteer Capacity</h3>
        <p class="modest-step__desc">Leveraging dedicated logistics infrastructure and volunteer capacity to deploy aid at scale.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">03</span>
        <h3 class="modest-step__title">Measurable Value</h3>
        <p class="modest-step__desc">Creating transparent, non-discriminatory value for donors, corporate partners, and disaster-affected communities.</p>
      </div>
    </div>
    <blockquote class="editorial-quote reveal" style="--i:3; margin-top: var(--space-7);">
      <p class="editorial-quote__text">“Smart, rapid humanitarian logistics can save lives and reduce long-term costs of recovery.”</p>
      <cite class="editorial-quote__cite">— Hands Across Humanity Operating Principles</cite>
    </blockquote>
  </Panel>
</EditorialPage>
