---
import { Picture } from 'astro:assets';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import { communitySupportWide, indoorRelief } from '../assets/images/eps';

const sections = [
  { id: 'top', label: 'Who we are' },
  { id: 'model', label: 'Why it matters' },
  { id: 'practice', label: 'Our model' }
];

const heroSignals = [
  {
    title: 'People who care',
    text: 'Neighbors, volunteers, businesses, and local leaders working together.',
  },
  {
    title: 'Practical work',
    text: 'Collecting, preparing, and sharing goods people can use.',
  },
  {
    title: 'Local knowledge',
    text: 'Community relationships guide where support goes next.',
  },
];
---

<EditorialPage
  activePage="who-we-are"
  eyebrow="Who we are"
  title="A network built around useful support."
  lead="Hands Across Humanity connects neighbors, volunteers, businesses, and local leaders around practical work that helps communities prepare, respond, and recover."
  description="The network brings together people who have goods to share, time to give, and local knowledge to guide the work."
  image={communitySupportWide}
  imageAlt="Volunteers and community members coordinating support at a distribution event."
  caption="Donated goods prepared for a community distribution event."
  secondaryHref="/what-we-do/"
  secondaryLabel="See the work"
  heroSignals={heroSignals}
  quote="“Good support begins with local knowledge and shared responsibility.”"
  nextHref="/mission/"
  nextLabel="Read our mission"
  sections={sections}
  total={3}
>
  <!-- 02: Model & Community Support -->
  <Panel id="model" ground="sand" index={2} total={3} label="Why it matters" labelledby="model-title" nextId="practice" nextLabel="Our model">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <h2 class="reveal" style="--i:1" id="model-title">Good intentions need a clear path to people.</h2>
      </div>
        <p class="lead reveal" style="--i:2">The work follows a simple path: understand the need, prepare useful goods, and share them through trusted relationships.</p>
    </div>

    <!-- Editorial Showcase Layout -->
    <div class="model-showcase">
      <div class="model-showcase__content reveal" style="--i:3">
        <div class="model-editorial-block">
          <div class="model-editorial-block__meta">
            <span class="model-editorial-block__label">Useful giving</span>
            <span class="model-editorial-block__sep" aria-hidden="true">|</span>
            <span class="model-editorial-block__tag">Community accountability</span>
          </div>
          <p class="model-editorial-block__lead">
            Our model brings together practical goods, dedicated volunteers, trusted partnerships, and a commitment to serving every community without discrimination.
          </p>
        </div>
      </div>

      <figure class="model-showcase__media reveal" style="--i:4">
        <div class="model-showcase__image-frame">
          <Picture
            src={indoorRelief}
            widths={[600, 900, 1200]}
            sizes="(min-width: 940px) 46vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={75}
            alt="Volunteers coordinating direct relief with community members in a public hall."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Volunteers preparing donated goods for a community distribution event.</figcaption>
      </figure>
    </div>

    <!-- Trust & Verification Bar -->
    <div class="process-guarantee-bar reveal" style="--i:5; margin-top:var(--space-7);">
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1 -5.93 -9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>Non-discriminatory service</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Transparent partnerships</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--slate-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span>Practical community value</span>
      </div>
    </div>
  </Panel>

  <!-- 03: Practice / Our Model -->
  <Panel id="practice" ground="paper" index={3} total={3} label="Our model" labelledby="practice-title" ctaHref="/mission/" ctaLabel="Read our mission">
    <div class="panel-head">
      <h2 class="reveal" style="--i:1" id="practice-title">Three habits shape the work.</h2>
    </div>
    
    <div class="modest-flow reveal" style="--i:2">
      <div class="modest-step">
        <span class="modest-step__num">01</span>
        <h3 class="modest-step__title">Listen first</h3>
        <p class="modest-step__desc">Learn what people and local partners need before deciding what support will be useful.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">02</span>
        <h3 class="modest-step__title">Prepare with care</h3>
        <p class="modest-step__desc">Sort, organize, and move donations carefully with the help of dedicated volunteers and partners.</p>
      </div>
      <div class="modest-step">
        <span class="modest-step__num">03</span>
        <h3 class="modest-step__title">Share without discrimination</h3>
        <p class="modest-step__desc">Connect useful goods with children, families, older adults, veterans, and communities with dignity.</p>
      </div>
    </div>
  </Panel>
</EditorialPage>
