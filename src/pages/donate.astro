---
import SiteLayout from '../layouts/SiteLayout.astro';
import DonationPanel from '../components/DonationPanel.astro';
import WaysToHelp from '../components/WaysToHelp.astro';

const title = 'Donate | Hands Across Humanity';
const description = 'Give goods, time, or money to community work with local partners in the Houston area.';
---

<SiteLayout title={title} description={description}>
  <main id="main">
    <section class="donation-page" aria-labelledby="donation-page-title">
      <div class="container">
        <header class="donation-page__heading">
          <div>
            <h1 id="donation-page-title">Choose the support you want to strengthen.</h1>
          </div>
          <p class="donation-section__heading-copy">A gift of money is one way to help. Goods, time, and partnership are the others, listed below.</p>
        </header>
        <DonationPanel compact />
      </div>
    </section>

    <!-- A visitor who can't or won't give money should not leave with nothing. -->
    <section class="donate-ways" aria-labelledby="donate-ways-title">
      <div class="container">
        <h2 id="donate-ways-title">Other ways to help.</h2>
        <WaysToHelp exclude={['money']} />
      </div>
    </section>
  </main>
</SiteLayout>
