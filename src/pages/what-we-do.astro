---
import { Picture } from 'astro:assets';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import publicEducationChildren from '../assets/images/public-education-children.jpg';
import publicVolunteerFood from '../assets/images/public-volunteer-food.jpg';
import publicLongtermCommunity from '../assets/images/public-longterm-community.jpg';
import waterImage from '../assets/images/essay-03-water-tank.png';
import handsImage from '../assets/images/essay-06-hands.png';

const sections = [
  { id: 'top', label: 'What we do' },
  { id: 'areas', label: 'Four areas' },
  { id: 'connect', label: 'How they connect' }
];

const workAreas = [
  {
    num: '01',
    fig: 'FIG 02.1',
    category: 'Essentials & Water',
    title: 'Food, water and essentials',
    body: 'Emergency food supplies, clean drinking water systems, warm blankets and hygiene kits. We source from local vendors to strengthen regional economies and ensure culturally familiar aid.',
    stat: '142,000+',
    statLabel: 'People reached with direct local procurement',
    location: 'East Africa & SE Asia',
    image: waterImage,
    alt: 'A community member tests clean water flowing from a local filtration standpipe.',
    href: '/#donate',
    linkText: 'Fund Direct Relief'
  },
  {
    num: '02',
    fig: 'FIG 02.2',
    category: 'Education & Schools',
    title: 'Schools and learning',
    body: 'Coverage for school tuition, books, uniforms and safe classroom facilities, ensuring household crisis or displacement never interrupts a child’s education.',
    stat: '48 Schools',
    statLabel: 'Community learning centers kept fully operational',
    location: 'Rift Valley & Rural Districts',
    image: publicEducationChildren,
    alt: 'Young students smiling and learning together in a bright community classroom.',
    href: '/vision/',
    linkText: 'Explore Education Impact'
  },
  {
    num: '03',
    fig: 'FIG 02.3',
    category: 'Rapid Relief',
    title: 'Emergency response',
    body: 'Rapid crisis mobilization delivering temporary shelter kits, clean water purification, food rations and medical supplies through trusted local ground partners.',
    stat: '<48 Hours',
    statLabel: 'Average dispatch time to active field units',
    location: 'Active Crisis Zones',
    image: publicVolunteerFood,
    alt: 'Local community volunteers organizing emergency food packages.',
    href: '/#donate',
    linkText: 'Fund Emergency Response'
  },
  {
    num: '04',
    fig: 'FIG 02.4',
    category: 'Long-term Autonomy',
    title: 'Long-term recovery & community rebuild',
    body: 'Sustained post-crisis empowerment: supporting local leaders as they restore housing, restart agricultural cooperatives, and strengthen community resilience.',
    stat: '85 Networks',
    statLabel: 'Autonomous local community partner networks active',
    location: 'Sub-Saharan & Pacific',
    image: publicLongtermCommunity,
    alt: 'Local community members standing together during a successful village restoration initiative.',
    href: '/vision/',
    linkText: 'Learn About Recovery'
  }
];
---

<EditorialPage
  activePage="what-we-do"
  eyebrow="What we do"
  title="Four kinds of work, shaped by local priorities."
  lead="A family in an emergency may need food this week and a school place next term. Our work is designed to meet both."
  description="Hands Across Humanity works with local communities on essentials, education, emergency response and long-term recovery."
  image={publicEducationChildren}
  imageAlt="Children raising hands happily in an active community classroom."
  caption="Urgent support and long-term opportunity belong together."
  nextHref="/vision/"
  nextLabel="Read our vision"
  sections={sections}
  total={3}
>
  <!-- 02 — Four areas (Alternating Editorial Rows) -->
  <Panel id="areas" ground="sand" index={2} total={3} label="Four areas" labelledby="areas-title" width="wide" nextId="connect" nextLabel="How they connect">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">The work in practice</p>
        <h2 class="reveal" style="--i:1" id="areas-title">Four areas. One principle: start with what people say they need.</h2>
      </div>
      <p class="lead reveal" style="--i:2">The categories help us explain the work. On the ground they overlap, because real lives do too.</p>
    </div>
    
    <div class="bento-areas-grid reveal" style="--i:3;">
      {workAreas.map((area, idx) => (
        <article class={`bento-area-card bento-area-card--${idx + 1}`}>
          <div class="bento-area-card__media">
            <Picture
              src={area.image}
              widths={[350, 700]}
              sizes="(min-width: 768px) 40vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={85}
              alt={area.alt}
              loading="lazy"
            />
            <span class="bento-area-card__category-tag">{area.category}</span>
          </div>
          
          <div class="bento-area-card__body">
            <div class="bento-area-card__top">
              <div class="bento-area-card__title-row">
                <span class="bento-area-card__num">{area.num}</span>
                <span class="bento-area-card__divider" aria-hidden="true">/</span>
                <h3 class="bento-area-card__title">{area.title}</h3>
              </div>
              <span class="bento-area-card__fig">
                {area.fig} • 
                <span class="bento-area-card__location">
                  <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  {area.location}
                </span>
              </span>
            </div>
            
            <p class="bento-area-card__desc">{area.body}</p>
            
            <div class="bento-area-card__footer">
              <div class="bento-area-card__stat">
                <span class="bento-area-card__stat-val">{area.stat}</span>
                <span class="bento-area-card__stat-label">{area.statLabel}</span>
              </div>
              <a href={area.href} class="bento-area-card__link">
                {area.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Panel>

  <!-- 03 — How they connect (Pure Editorial Journal Narrative) -->
  <Panel id="connect" ground="paper" index={3} total={3} label="How they connect" labelledby="connect-title" ctaHref="/vision/" ctaLabel="Read our vision">
    <div class="panel-head panel-head--split" style="margin-bottom: clamp(0.4rem, 1vh, 0.75rem);">
      <div class="panel-head__title">
        <p class="eyebrow reveal">The Interconnected Ecosystem</p>
        <h2 class="reveal" style="--i:1" id="connect-title">We fund the combination that makes a plan hold together.</h2>
      </div>
      <p class="lead reveal" style="--i:2">A crisis does not arrive in separate silos. Food at home keeps a child in school. A repaired roof protects family health. We treat needs as connected rather than isolated transactions.</p>
    </div>
    
    <div class="connect-journal-grid reveal" style="--i:3;">
      <!-- Left Column: Flat Hairline Typographic Connections Flow -->
      <div class="connect-stories">
        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">01</span>
            <span class="connect-story__title">Essentials → Education</span>
            <span class="connect-story__stat">94% Retention</span>
          </div>
          <p class="connect-story__body">Emergency food & clean water delivered directly to families in Kitui prevents student dropout during seasonal droughts.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">02</span>
            <span class="connect-story__title">Shelter → Health</span>
            <span class="connect-story__stat">&lt;48h Response</span>
          </div>
          <p class="connect-story__body">Roofing kits and medical supplies dispatched within 48 hours stabilize displaced families before disease outbreaks can start.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">03</span>
            <span class="connect-story__title">Relief → Cooperatives</span>
            <span class="connect-story__stat">85 Co-ops</span>
          </div>
          <p class="connect-story__body">Once immediate grain is secured, seed micro-grants help displaced farmers build autonomous, self-sustaining agricultural cooperatives.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">04</span>
            <span class="connect-story__title">Autonomy → Future</span>
            <span class="connect-story__stat">100% Local Led</span>
          </div>
          <p class="connect-story__body">Decisions remain entirely with local community councils. By combining short-term relief with long-term capital, projects endure.</p>
        </article>
      </div>

      <!-- Right Column: Editorial Media Feature & Pull Quote -->
      <div class="connect-feature">
        <figure class="connect-feature__media" style="margin: 0;">
          <div class="connect-feature__media-box">
            <Picture
              src={handsImage}
              widths={[400, 750]}
              sizes="(min-width: 940px) 40vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={82}
              alt="Community members passing essential supplies hand to hand."
              loading="lazy"
            />
          </div>
          <figcaption class="approach-photo-caption" style="margin-top: 0.35rem;">
            <span class="approach-photo-caption__num">FIG 04.1</span>
            <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
            <span class="approach-card__tag">Integrated Support Matrix</span>
            <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
            <span class="approach-photo-caption__text">Turkana & Kitui Field Operations</span>
          </figcaption>
        </figure>

        <blockquote class="editorial-quote" style="margin-top: clamp(0.5rem, 1vh, 0.85rem);">
          <p class="editorial-quote__text">“Start with what people say they need.”</p>
          <cite class="editorial-quote__cite">— Field Operating Principle</cite>
        </blockquote>
      </div>
    </div>
  </Panel>
</EditorialPage>
