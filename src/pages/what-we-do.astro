---
import { Picture } from 'astro:assets';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import learningImage from '../assets/images/work-schools-learning.png';
import waterImage from '../assets/images/essay-03-water-tank.png';
import roofingImage from '../assets/images/essay-04-roofing-sheets.png';
import heroImage from '../assets/images/hero-connection.png';
import handsImage from '../assets/images/essay-06-hands.png';

const sections = [
  { id: 'top', label: 'What we do' },
  { id: 'areas', label: 'Four areas' },
  { id: 'calculator', label: 'Impact calculator' },
  { id: 'connect', label: 'How they connect' }
];

const workAreas = [
  {
    num: '01',
    fig: 'FIG 02.1',
    category: 'Essentials & Water',
    title: 'Food, water and essentials',
    body: 'Emergency food, clean water, cooking equipment, blankets and hygiene supplies. We buy locally wherever we can.',
    stat: '142,000+',
    statLabel: 'People served with direct local sourcing',
    location: 'East Africa & SE Asia',
    image: waterImage,
    alt: 'A hand tests water flowing from a community standpipe into a clean container.',
    href: '/#donate',
    linkText: 'Fund Emergency Relief'
  },
  {
    num: '02',
    fig: 'FIG 02.2',
    category: 'Education & Schools',
    title: 'Schools and learning',
    body: 'School fees, books, uniforms and safe places to study, so a crisis at home does not end a child’s education.',
    stat: '48 Schools',
    statLabel: 'Partner learning centers kept open',
    location: 'Rift Valley & Rural Districts',
    image: learningImage,
    alt: 'A teacher leans toward children around a table as they work in a bright classroom.',
    href: '/vision/',
    linkText: 'Explore Education Work'
  },
  {
    num: '03',
    fig: 'FIG 02.3',
    category: 'Rapid Relief',
    title: 'Emergency response',
    body: 'When crisis strikes, we move quickly with shelter, water, food and medical supplies through partners already there.',
    stat: '<48 Hours',
    statLabel: 'Average crisis dispatch time to field units',
    location: 'Active Crisis Zones',
    image: heroImage,
    alt: 'Three community members pass a sack from a small truck while working together.',
    href: '/#donate',
    linkText: 'Fund Rapid Dispatch'
  },
  {
    num: '04',
    fig: 'FIG 02.4',
    category: 'Long-term Autonomy',
    title: 'Long-term recovery',
    body: 'The quiet work after headlines move on: repairing homes, restarting small businesses and helping groups run services.',
    stat: '85 Networks',
    statLabel: 'Cooperative local partner initiatives',
    location: 'Sub-Saharan & Pacific',
    image: roofingImage,
    alt: 'Two adults carry corrugated roofing sheets along a repaired road with a child walking nearby.',
    href: '/vision/',
    linkText: 'Explore Recovery Work'
  }
];
---

<EditorialPage
  activePage="what-we-do"
  eyebrow="What we do"
  title="Four kinds of work, shaped by local priorities."
  lead="A family in an emergency may need food this week and a school place next term. Our work is designed to meet both."
  description="Hands Across Humanity works with local communities on essentials, education, emergency response and long-term recovery."
  image={learningImage}
  imageAlt="A teacher leans toward children around a table as they work in a bright classroom."
  caption="Urgent support and long-term opportunity belong together."
  nextHref="/vision/"
  nextLabel="Read our vision"
  sections={sections}
  total={4}
>
  <!-- 02 — Four areas (Editorial 2x2 Grid) -->
  <Panel id="areas" ground="sand" index={2} total={4} label="Four areas" labelledby="areas-title" width="wide" nextId="calculator" nextLabel="Calculate impact">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal"><span class="eyebrow__dot"></span>The work in practice</p>
        <h2 class="reveal" style="--i:1" id="areas-title">Four areas. One principle: start with what people say they need.</h2>
      </div>
      <p class="lead reveal" style="--i:2">The categories help us explain the work. On the ground they overlap, because real lives do too.</p>
    </div>
    
    <div class="editorial-areas-grid reveal" style="--i:3;">
      {workAreas.map((area, idx) => (
        <article class="editorial-area-card">
          <div class="editorial-area-card__media">
            <Picture
              src={area.image}
              widths={[350, 600]}
              sizes="(min-width: 768px) 25vw, 45vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={80}
              alt={area.alt}
              loading="lazy"
            />
          </div>
          <figcaption class="approach-photo-caption">
            <span class="approach-photo-caption__num">{area.fig}</span>
            <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
            <span class="approach-card__tag">{area.category}</span>
            <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
            <span class="approach-photo-caption__text">📍 {area.location}</span>
          </figcaption>
          <div class="editorial-area-card__content">
            <div class="editorial-area-card__header-row">
              <span class="editorial-area-card__num">{area.num}</span>
              <h3 class="editorial-area-card__title">{area.title}</h3>
            </div>
            <p class="editorial-area-card__body">{area.body}</p>
            <div class="editorial-area-card__stat-row">
              <span class="editorial-area-card__stat-val">{area.stat}</span>
              <span class="editorial-area-card__stat-label">{area.statLabel}</span>
            </div>
            <div class="editorial-area-card__action">
              <a href={area.href} class="editorial-area-card__link">
                {area.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Panel>

  <!-- Interactive Impact Allocation Calculator Section (Compact Viewport Fit) -->
  <Panel id="calculator" ground="sand" index={3} total={4} label="Impact Allocation" labelledby="calc-title" width="wide" nextId="connect" nextLabel="How they connect">
    <div class="calculator-card calculator-card--compact">
      <div class="calc-input-col">
        <span class="badge badge--primary" style="align-self: start; margin-bottom: 0.35rem;">
          <span class="badge__dot badge__dot--pulse"></span> Interactive Allocation
        </span>
        <h2 id="calc-title" style="font-family: 'Newsreader Variable', Georgia, serif; font-size: clamp(1.2rem, 1.6vw, 1.5rem); margin-bottom: 0.25rem;">Calculate your impact across our four pillars</h2>
        <p class="lead" style="font-size: 0.875rem; margin-bottom: 0.85rem; line-height: 1.4;">See exactly how your contribution converts into clean water, school supplies, emergency food, and shelter on the ground.</p>
        
        <div class="calc-toggle" role="group" aria-label="Donation frequency" style="margin-bottom: 0.65rem;">
          <button type="button" class="calc-toggle__btn is-active" data-freq="monthly" aria-pressed="true">Monthly Partner</button>
          <button type="button" class="calc-toggle__btn" data-freq="once" aria-pressed="false">One-Time Gift</button>
        </div>

        <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.65rem;" role="group" aria-label="Select donation amount">
          <button type="button" class="calc-preset-btn" data-amount="25">$25</button>
          <button type="button" class="calc-preset-btn is-active" data-amount="50">$50</button>
          <button type="button" class="calc-preset-btn" data-amount="100">$100</button>
          <button type="button" class="calc-preset-btn" data-amount="250">$250</button>
          <button type="button" class="calc-preset-btn" data-amount="500">$500</button>
        </div>

        <p style="font-size: 0.75rem; color: var(--slate-500); font-weight: 500; margin: 0;">
          🔒 <span style="color: var(--emerald); font-weight: 600;">94%</span> directly reaches verified local field initiatives.
        </p>
      </div>

      <div class="calc-result-col" style="background: var(--slate-900); color: var(--fg-on-dark); padding: 1.25rem 1.35rem; border-radius: var(--radius-md); border: 1px solid var(--slate-800); display: flex; flex-direction: column; gap: 0.75rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--slate-800); padding-bottom: 0.5rem;">
          <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--emerald-border);">Your Monthly Impact</span>
          <span id="calc-summary-amount" style="font-family: 'Newsreader Variable', serif; font-size: 1.45rem; font-weight: 700; color: #FFFFFF;">$50 / mo</span>
        </div>

        <ul style="display: grid; gap: 0.45rem; font-size: 0.8125rem; line-height: 1.35; padding: 0; margin: 0; list-style: none;">
          <li style="display: flex; align-items: start; gap: 0.4rem;">
            <span style="color: var(--emerald); font-weight: 700;">✓</span>
            <span id="calc-impact-1">Supplies <strong>2 families</strong> with emergency food & clean water kits monthly.</span>
          </li>
          <li style="display: flex; align-items: start; gap: 0.4rem;">
            <span style="color: var(--emerald); font-weight: 700;">✓</span>
            <span id="calc-impact-2">Keeps <strong>1 child</strong> enrolled in primary school with full supplies.</span>
          </li>
          <li style="display: flex; align-items: start; gap: 0.4rem;">
            <span style="color: var(--emerald); font-weight: 700;">✓</span>
            <span id="calc-impact-3">Funds rapid-deployment emergency medical kits for displacement camps.</span>
          </li>
        </ul>

        <a id="calc-donate-link" href="/#donate" class="btn btn--primary" style="margin-top: 0.25rem; text-align: center; justify-content: center; min-height: 2.35rem; font-size: 0.8125rem;">
          Commit $50 / month <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </Panel>

  <!-- 04 — How they connect -->
  <Panel id="connect" ground="paper" index={4} total={4} label="How they connect" labelledby="connect-title" ctaHref="/vision/" ctaLabel="Read our vision">
    <div class="panel-head">
      <p class="eyebrow reveal"><span class="eyebrow__dot"></span>How the areas connect</p>
      <h2 class="reveal" style="--i:1" id="connect-title">We fund the combination that makes a plan hold together.</h2>
    </div>
    
    <div class="connect-split-grid reveal" style="--i:2">
      <div class="connect-copy">
        <p class="lead" style="font-size: 0.95rem; margin-bottom: 0.75rem; line-height: 1.45;">Keeping a child in school can depend on food at home. Repairing a roof can depend on a local builder having the tools to start again.</p>
        <p style="font-size: 0.875rem; color: var(--slate-600); margin-bottom: 0.75rem; line-height: 1.45;">So we treat needs as connected rather than as separate transactions — and we let the people living with them decide the order.</p>
        <blockquote class="pull-quote pull-quote--card" style="margin-top: 0.5rem;">
          “Start with what people say they need.”
        </blockquote>
      </div>

      <figure class="connect-media-figure" style="margin: 0;">
        <div class="connect-media-box">
          <Picture
            src={handsImage}
            widths={[400, 700]}
            sizes="(min-width: 940px) 35vw, 90vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={80}
            alt="Community hands passing essential supplies hand-to-hand."
            loading="lazy"
          />
        </div>
        <figcaption class="approach-photo-caption" style="margin-top: 0.35rem;">
          <span class="approach-photo-caption__num">FIG 04.1</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-card__tag">Integrated Support</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-photo-caption__text">Direct local action</span>
        </figcaption>
      </figure>
    </div>
  </Panel>
</EditorialPage>

<script>
  function initCalculator() {
    const card = document.querySelector('#calculator');
    if (!card) return;

    const freqBtns = card.querySelectorAll<HTMLButtonElement>('.calc-toggle__btn');
    const amountBtns = card.querySelectorAll<HTMLButtonElement>('.calc-preset-btn');
    const summaryAmount = card.querySelector('#calc-summary-amount');
    const donateLink = card.querySelector<HTMLAnchorElement>('#calc-donate-link');
    const impact1 = card.querySelector('#calc-impact-1');
    const impact2 = card.querySelector('#calc-impact-2');
    const impact3 = card.querySelector('#calc-impact-3');

    let currentFreq = 'monthly';
    let currentAmount = 50;

    const impactData: Record<number, { f1: string; f2: string; f3: string }> = {
      25: {
        f1: 'Supplies <strong>1 family</strong> with emergency food & clean water kits monthly.',
        f2: 'Provides essential textbooks & uniforms for <strong>1 student</strong>.',
        f3: 'Funds emergency hygiene supplies for refugee support centers.'
      },
      50: {
        f1: 'Supplies <strong>2 families</strong> with emergency food & clean water kits monthly.',
        f2: 'Keeps <strong>1 child</strong> enrolled in primary school with full supplies.',
        f3: 'Funds rapid-deployment emergency medical kits for displacement camps.'
      },
      100: {
        f1: 'Provides <strong>4 families</strong> with clean water filtration units & emergency food.',
        f2: 'Funds full annual tuition & meals for <strong>2 students</strong>.',
        f3: 'Builds <strong>10 meters</strong> of clean solar water distribution piping.'
      },
      250: {
        f1: 'Deploys <strong>10 emergency shelter kits</strong> with galvanized roofing sheets.',
        f2: 'Outfits a full primary classroom with wooden desks & learning materials.',
        f3: 'Provides seed & tool grants to <strong>5 women-led farming cooperatives</strong>.'
      },
      500: {
        f1: 'Constructs a community solar water pump distribution station.',
        f2: 'Funds teacher stipends and microgrid solar power for a rural school.',
        f3: 'Sponsors rapid emergency deployment for an entire displaced village.'
      }
    };

    function update() {
      const data = impactData[currentAmount] || impactData[50];
      const freqSuffix = currentFreq === 'monthly' ? ' / mo' : ' one-time';
      
      if (summaryAmount) summaryAmount.textContent = `$${currentAmount}${freqSuffix}`;
      if (donateLink) {
        donateLink.textContent = `Commit $${currentAmount}${freqSuffix}`;
        donateLink.href = `/#donate?amount=${currentAmount}&freq=${currentFreq}`;
      }
      if (impact1) impact1.innerHTML = data.f1;
      if (impact2) impact2.innerHTML = data.f2;
      if (impact3) impact3.innerHTML = data.f3;
    }

    freqBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        freqBtns.forEach(b => { b.classList.remove('is-active'); b.setAttribute('aria-pressed', 'false'); });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        currentFreq = btn.dataset.freq || 'monthly';
        update();
      });
    });

    amountBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        amountBtns.forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        currentAmount = parseInt(btn.dataset.amount || '50', 10);
        update();
      });
    });
  }

  initCalculator();
  document.addEventListener('astro:page-load', initCalculator);
</script>
