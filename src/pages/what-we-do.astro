---
import { Picture } from 'astro:assets';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import {
  childrenOutreach,
  healthSupplies,
  partnerTeam,
  reliefStation,
  communitySupplies,
  educationRelief,
} from '../assets/images/eps';

const sections = [
  { id: 'top', label: 'What we do' },
  { id: 'areas', label: 'Core focus' },
  { id: 'connect', label: 'Ecosystem' }
];

const workAreas = [
  {
    num: '01',
    category: 'Education & family',
    title: 'Support learning and readiness',
    body: 'School kits and child-focused goods help children and families feel prepared, supported, and ready to keep learning.',
    stat: 'Education essentials',
    statLabel: 'School and family support',
    location: 'Schools & community events',
    image: childrenOutreach,
    alt: 'Volunteers sharing educational kits with children and families.',
    href: '/#donate',
    linkText: 'Support education'
  },
  {
    num: '02',
    category: 'Health & household',
    title: 'Share practical essentials',
    body: 'Health, hygiene, wellness, and household goods become immediate support when they are matched with a real need.',
    stat: 'Everyday needs',
    statLabel: 'Health, hygiene, and household supplies',
    location: 'Community distribution events',
    image: healthSupplies,
    alt: 'Health, wellness, and essential supplies arranged for community distribution.',
    href: '/#donate',
    linkText: 'Give useful goods'
  },
  {
    num: '03',
    category: 'Community care',
    title: 'Reach people with dignity',
    body: 'Community distribution brings essential goods closer to children, families, veterans, older adults, and neighbors who need support.',
    stat: 'Direct support',
    statLabel: 'Welcoming, non-discriminatory distribution',
    location: 'Local community hubs',
    image: reliefStation,
    alt: 'Community members receiving essential goods at a relief station.',
    href: '/#donate',
    linkText: 'Support community care'
  },
  {
    num: '04',
    category: 'Business giving',
    title: 'Turn surplus into support',
    body: 'Businesses of every size can help useful products reach people instead of sitting unused when communities are under pressure.',
    stat: 'Shared resources',
    statLabel: 'Corporate and enterprise partnerships',
    location: 'Business partner network',
    image: partnerTeam,
    alt: 'Partner representatives supporting a community relief event.',
    href: '/vision/',
    linkText: 'Partner with us'
  },
  {
    num: '05',
    category: 'Volunteers & partners',
    title: 'Make support possible',
    body: 'Volunteers, nonprofits, houses of worship, and local leaders help turn donations into care that is personal, practical, and trusted.',
    stat: 'People-powered',
    statLabel: 'Volunteer and community partnerships',
    location: 'Houses of worship & civic hubs',
    image: communitySupplies,
    alt: 'Volunteers and community members coordinating essential goods at a relief station.',
    href: '/vision/',
    linkText: 'Join the network'
  }
];
---

<EditorialPage
  activePage="what-we-do"
  eyebrow="What we do"
  title="How donations become community support."
  lead="We collect useful goods, prepare them with care, and share them with people and partners facing urgent need."
  description="Hands Across Humanity brings together donors, volunteers, businesses, houses of worship, nonprofits, and local leaders to turn resources into practical support."
  image={educationRelief}
  imageAlt="Children holding prepared school and relief kits with community volunteers."
  caption="Education essentials prepared for children and families."
  nextHref="/vision/"
  nextLabel="Read our vision"
  sections={sections}
  total={3}
>
  <!-- 02: Core Focus Areas Grid -->
  <Panel id="areas" ground="sand" index={2} total={3} label="Core focus" labelledby="areas-title" nextId="connect" nextLabel="Ecosystem">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">Where support goes</p>
        <h2 class="reveal" style="--i:1" id="areas-title">Five ways your support can help.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Each pathway starts with a clear community need and ends with practical goods reaching people with dignity.</p>
    </div>
    
    <div class="bento-areas-grid reveal" style="--i:3;">
      {workAreas.map((area, idx) => (
        <article class={`bento-area-card bento-area-card--${idx + 1}`}>
          <div class="bento-area-card__media">
            <Picture
              src={area.image}
              widths={[350, 700]}
              sizes="(min-width: 768px) 40vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={85}
              alt={area.alt}
              loading="lazy"
            />
            <span class="bento-area-card__category-tag">{area.category}</span>
          </div>
          
          <div class="bento-area-card__body">
            <div class="bento-area-card__top">
              <div class="bento-area-card__title-row">
                <span class="bento-area-card__num">{area.num}</span>
                <span class="bento-area-card__divider" aria-hidden="true">/</span>
                <h3 class="bento-area-card__title">{area.title}</h3>
              </div>
              <span class="bento-area-card__fig">
                <span class="bento-area-card__location">
                  <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  {area.location}
                </span>
              </span>
            </div>
            
            <p class="bento-area-card__desc">{area.body}</p>
            
            <div class="bento-area-card__footer">
              <div class="bento-area-card__stat">
                <span class="bento-area-card__stat-val">{area.stat}</span>
                <span class="bento-area-card__stat-label">{area.statLabel}</span>
              </div>
              <a href={area.href} class="bento-area-card__link">
                {area.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Panel>

  <!-- 03: Collaborative Ecosystem -->
  <Panel id="connect" ground="paper" index={3} total={3} label="Ecosystem" labelledby="connect-title" ctaHref="/vision/" ctaLabel="Read our vision">
    <div class="panel-head panel-head--split" style="margin-bottom: clamp(0.4rem, 1vh, 0.75rem);">
      <div class="panel-head__title">
        <p class="eyebrow reveal">People make the difference</p>
        <h2 class="reveal" style="--i:1" id="connect-title">Giving works better when people work together.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Businesses, volunteers, nonprofits, houses of worship, and local leaders each bring something essential to the work of helping communities recover.</p>
    </div>
    
    <div class="connect-journal-grid reveal" style="--i:3;">
      <!-- Left Column -->
      <div class="connect-stories">
        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">01</span>
          <span class="connect-story__title">Give useful goods</span>
            <span class="connect-story__stat">Health & education</span>
          </div>
          <p class="connect-story__body">Donated health, hygiene, household, and education supplies give communities something practical to work with.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">02</span>
          <span class="connect-story__title">Prepare donations</span>
            <span class="connect-story__stat">Sort & organize</span>
          </div>
          <p class="connect-story__body">Volunteers sort and organize goods so the right items are ready for the right community partner.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">03</span>
          <span class="connect-story__title">Share with neighbors</span>
            <span class="connect-story__stat">Community events</span>
          </div>
          <p class="connect-story__body">Local distribution events help essential support reach children, families, older adults, veterans, and neighbors with dignity.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">04</span>
          <span class="connect-story__title">Partner for reach</span>
            <span class="connect-story__stat">Shared responsibility</span>
          </div>
          <p class="connect-story__body">Businesses, nonprofits, houses of worship, and local stakeholders help extend reach and build trust without discrimination.</p>
        </article>
      </div>

      <!-- Right Column -->
      <div class="connect-feature">
        <figure class="connect-feature__media" style="margin: 0;">
          <div class="connect-feature__media-box">
            <Picture
              src={communitySupplies}
              widths={[400, 750]}
              sizes="(min-width: 940px) 40vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={82}
              alt="Volunteers and community members coordinating essential goods at a relief station."
              loading="lazy"
            />
          </div>
          <figcaption class="approach-photo-caption" style="margin-top: 0.35rem;">
            <span class="approach-card__tag">People-powered support</span>
            <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
            <span class="approach-photo-caption__text">Community distribution and shared care</span>
          </figcaption>
        </figure>

        <blockquote class="editorial-quote" style="margin-top: clamp(0.5rem, 1vh, 0.85rem);">
          <p class="editorial-quote__text">“Useful support travels further when communities share responsibility for one another.”</p>
          <cite class="editorial-quote__cite">Hands Across Humanity community principle</cite>
        </blockquote>
      </div>
    </div>
  </Panel>
</EditorialPage>
