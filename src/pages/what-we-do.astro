---
import { Picture } from 'astro:assets';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import h1 from '../assets/images/h1.jpg';
import h4 from '../assets/images/h4.jpg';
import h5 from '../assets/images/h5.jpg';
import h8 from '../assets/images/h8.jpg';
import h9 from '../assets/images/h9.jpg';
import h10 from '../assets/images/h10.jpg';
import h12 from '../assets/images/h12.jpg';
import h14 from '../assets/images/h14.jpg';

const sections = [
  { id: 'top', label: 'What we do' },
  { id: 'areas', label: 'Core focus' },
  { id: 'connect', label: 'Ecosystem' }
];

const workAreas = [
  {
    num: '01',
    fig: 'FIG 02.1',
    category: 'Preparedness & Education',
    title: 'Disaster Preparedness',
    body: 'Education and outreach to help families, veterans, older adults, and children prepare for all-hazards events.',
    stat: 'All-Hazards',
    statLabel: 'Community preparedness education & outreach',
    location: 'Regional Community Centers',
    image: h1,
    alt: 'Volunteers conducting disaster preparedness training and education.',
    href: '/#donate',
    linkText: 'Support Preparedness'
  },
  {
    num: '02',
    fig: 'FIG 02.2',
    category: 'Emergency Response',
    title: 'Rapid Response & Distribution',
    body: 'Collecting donated products and supplies and delivering them efficiently to those struggling after disasters or catastrophic events.',
    stat: '24-48h',
    statLabel: 'Rapid emergency fleet distribution dispatch',
    location: 'Disaster Impact Zones',
    image: h14,
    alt: 'Volunteers loading emergency supply boxes onto distribution transport.',
    href: '/#donate',
    linkText: 'Fund Emergency Response'
  },
  {
    num: '03',
    fig: 'FIG 02.3',
    category: 'Rebuilding & Relief',
    title: 'Recovery Support',
    body: 'Assisting individuals and partner organizations in the rebuilding process with targeted goods and services.',
    stat: 'Targeted Aid',
    statLabel: 'Direct rebuilding supplies & recovery services',
    location: 'Rebuilding Communities',
    image: h10,
    alt: 'Volunteers and community members working together on recovery support.',
    href: '/vision/',
    linkText: 'View Recovery Work'
  },
  {
    num: '04',
    fig: 'FIG 02.4',
    category: 'Business Alliances',
    title: 'Partnership Development',
    body: 'Building lasting alliances with small, mid-size, and large businesses to deploy goods and services at scale.',
    stat: 'Scalable',
    statLabel: 'Corporate & enterprise resource partnerships',
    location: 'Corporate Partner Network',
    image: h12,
    alt: 'Business leaders and logistics teams collaborating on relief deployment.',
    href: '/vision/',
    linkText: 'Partner With Us'
  },
  {
    num: '05',
    fig: 'FIG 02.5',
    category: 'Community & Faith',
    title: 'Community & Faith Partnerships',
    body: 'Collaborating with houses of worship and community stakeholders on a non-discriminatory basis to extend reach and trust.',
    stat: 'Non-Discriminatory',
    statLabel: 'Grassroots faith and community stakeholder alliances',
    location: 'Houses of Worship & Civic Hubs',
    image: h5,
    alt: 'Volunteers at a community faith center handing out relief supplies.',
    href: '/vision/',
    linkText: 'Explore Faith Alliances'
  }
];
---

<EditorialPage
  activePage="what-we-do"
  eyebrow="What we do"
  title="Five Core Focus Areas of Practical Action."
  lead="From proactive disaster preparedness to rapid response, recovery support, and scalable business and faith partnerships."
  description="Hands Across Humanity delivers essential relief, rebuilds stability, and builds lasting public-private and community alliances."
  image={h1}
  imageAlt="Volunteers handing out supply kits to smiling community members."
  caption="Preparedness, response, recovery, and strategic alliances."
  nextHref="/vision/"
  nextLabel="Read our vision"
  sections={sections}
  total={3}
>
  <!-- 02 — Core Focus Areas Grid -->
  <Panel id="areas" ground="sand" index={2} total={3} label="Core focus" labelledby="areas-title" width="wide" nextId="connect" nextLabel="Ecosystem">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">Core Focus Areas</p>
        <h2 class="reveal" style="--i:1" id="areas-title">Five pillar areas delivering impact at scale.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Our work connects education, emergency response, recovery, and strategic alliances to protect communities before, during, and after crisis.</p>
    </div>
    
    <div class="bento-areas-grid reveal" style="--i:3;">
      {workAreas.map((area, idx) => (
        <article class={`bento-area-card bento-area-card--${idx + 1}`}>
          <div class="bento-area-card__media">
            <Picture
              src={area.image}
              widths={[350, 700]}
              sizes="(min-width: 768px) 40vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={85}
              alt={area.alt}
              loading="lazy"
            />
            <span class="bento-area-card__category-tag">{area.category}</span>
          </div>
          
          <div class="bento-area-card__body">
            <div class="bento-area-card__top">
              <div class="bento-area-card__title-row">
                <span class="bento-area-card__num">{area.num}</span>
                <span class="bento-area-card__divider" aria-hidden="true">/</span>
                <h3 class="bento-area-card__title">{area.title}</h3>
              </div>
              <span class="bento-area-card__fig">
                {area.fig} • 
                <span class="bento-area-card__location">
                  <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  {area.location}
                </span>
              </span>
            </div>
            
            <p class="bento-area-card__desc">{area.body}</p>
            
            <div class="bento-area-card__footer">
              <div class="bento-area-card__stat">
                <span class="bento-area-card__stat-val">{area.stat}</span>
                <span class="bento-area-card__stat-label">{area.statLabel}</span>
              </div>
              <a href={area.href} class="bento-area-card__link">
                {area.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Panel>

  <!-- 03 — Collaborative Ecosystem -->
  <Panel id="connect" ground="paper" index={3} total={3} label="Ecosystem" labelledby="connect-title" ctaHref="/vision/" ctaLabel="Read our vision">
    <div class="panel-head panel-head--split" style="margin-bottom: clamp(0.4rem, 1vh, 0.75rem);">
      <div class="panel-head__title">
        <p class="eyebrow reveal">The Interconnected Ecosystem</p>
        <h2 class="reveal" style="--i:1" id="connect-title">Connecting preparedness, rapid response, recovery & alliances.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Real crisis response requires a complete ecosystem. Education prepares families, rapid logistics deliver relief, recovery restores stability, and partnerships scale our reach nationwide.</p>
    </div>
    
    <div class="connect-journal-grid reveal" style="--i:3;">
      <!-- Left Column -->
      <div class="connect-stories">
        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">01</span>
            <span class="connect-story__title">Preparedness → Education</span>
            <span class="connect-story__stat">All-Hazards</span>
          </div>
          <p class="connect-story__body">Outreach and training help children, families, veterans, and older adults prepare before catastrophic events strike.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">02</span>
            <span class="connect-story__title">Response → Fleet Distribution</span>
            <span class="connect-story__stat">&lt;48h Response</span>
          </div>
          <p class="connect-story__body">Efficient fleet logistics transport donated products directly to communities struggling after disasters.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">03</span>
            <span class="connect-story__title">Recovery → Rebuilding</span>
            <span class="connect-story__stat">Targeted Aid</span>
          </div>
          <p class="connect-story__body">Targeted goods and services assist individuals and partner organizations throughout long-term recovery.</p>
        </article>

        <article class="connect-story">
          <div class="connect-story__head">
            <span class="connect-story__num">04</span>
            <span class="connect-story__title">Business & Faith Alliances</span>
            <span class="connect-story__stat">Non-Discriminatory</span>
          </div>
          <p class="connect-story__body">Collaborating with businesses of all sizes, houses of worship, and stakeholders on a non-discriminatory basis to extend reach and trust.</p>
        </article>
      </div>

      <!-- Right Column -->
      <div class="connect-feature">
        <figure class="connect-feature__media" style="margin: 0;">
          <div class="connect-feature__media-box">
            <Picture
              src={h4}
              widths={[400, 750]}
              sizes="(min-width: 940px) 40vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={82}
              alt="Hands passing relief and gift items directly at community station."
              loading="lazy"
            />
          </div>
          <figcaption class="approach-photo-caption" style="margin-top: 0.35rem;">
            <span class="approach-photo-caption__num">FIG 04.1</span>
            <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
            <span class="approach-card__tag">Core Focus Matrix</span>
            <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
            <span class="approach-photo-caption__text">Disaster Response & Partnership Network</span>
          </figcaption>
        </figure>

        <blockquote class="editorial-quote" style="margin-top: clamp(0.5rem, 1vh, 0.85rem);">
          <p class="editorial-quote__text">“Collaborating on a non-discriminatory basis to extend reach, trust, and practical relief.”</p>
          <cite class="editorial-quote__cite">— Hands Across Humanity Core Focus Principle</cite>
        </blockquote>
      </div>
    </div>
  </Panel>
</EditorialPage>
