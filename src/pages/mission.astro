---
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import { Picture } from 'astro:assets';
import {
  communityDistribution,
  reliefDistributionWide,
  communityDistributionWide,
  supplyHandoff,
  partnerShowcase,
  healthSupplies,
  indoorRelief,
} from '../assets/images/eps';

const sections = [
  { id: 'top', label: 'Mission' },
  { id: 'approach', label: 'Approach' },
  { id: 'rules', label: 'Three pillars' }
];

const heroSignals = [
  {
    title: 'Who we serve',
    text: 'Children, families, veterans, older adults, and communities facing urgent need.',
  },
  {
    title: 'How support moves',
    text: 'Collected, prepared, and shared through local partners and volunteers.',
  },
  {
    title: 'Why it matters',
    text: 'Faster, more dignified support when everyday life is disrupted.',
  },
];

const ruleCards = [
  {
    title: 'Support starts with people',
    body: 'We collect and share essential supplies with children, families, veterans, older adults, and communities affected by disasters and other urgent situations.',
    image: communityDistribution,
    alt: 'Volunteers coordinating essential goods with community members at a relief event.',
    captionTitle: 'Direct community support',
    captionStat: 'Essential goods',
    href: '/what-we-do/#areas',
    linkText: 'See where support goes'
  },
  {
    title: 'Useful aid, ready when needed',
    body: 'Strategic partnerships, dedicated volunteers, and efficient transport support help essential goods reach people quickly and reliably.',
    image: supplyHandoff,
    alt: 'Volunteers moving boxed supplies on a cart for direct distribution.',
    captionTitle: 'Coordinated supply handoff',
    captionStat: 'Practical response',
    href: '/what-we-do/#connect',
    linkText: 'See how it comes together'
  },
  {
    title: 'Partnerships that multiply care',
    body: 'Businesses, nonprofits, houses of worship, volunteers, and local leaders work together so communities can prepare, respond, and recover with dignity.',
    image: partnerShowcase,
    alt: 'Corporate partners and volunteers gathered behind a relief supply table.',
    captionTitle: 'Community support network',
    captionStat: 'Shared responsibility',
    href: '/vision/',
    linkText: 'Meet our partners'
  }
];
---

<EditorialPage
  activePage="mission"
  eyebrow="Our mission"
  title="Saving lives and restoring hope, one delivery at a time."
  lead="Hands Across Humanity rapidly collects and distributes essential supplies and resources to children, families, veterans, older adults, and communities affected by disasters, all-hazards events, and catastrophic situations."
  description="Through strategic public-private partnerships, a dedicated volunteer network, and efficient transport support, we empower communities to prepare, respond, and recover with dignity and resilience."
  image={reliefDistributionWide}
  imageAlt="Volunteers and community members coordinating relief distribution in a large public hall."
  caption="Saving lives and restoring hope, one delivery at a time."
  secondaryHref="/what-we-do/"
  secondaryLabel="See the work"
  heroSignals={heroSignals}
  quote="“A clear mission turns good intentions into practical support.”"
  nextHref="/what-we-do/"
  nextLabel="See what we do"
  sections={sections}
  total={4}
>
  <!-- 02: Approach -->
  <Panel id="approach" ground="sand" index={2} total={4} label="Approach" labelledby="approach-title" nextId="rules" nextLabel="Three pillars">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow">Approach</p>
        <h2 class="reveal" style="--i:1" id="approach-title">From available goods to useful support.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Partnerships, volunteers, and reliable transport help communities prepare, respond, and recover with dignity.</p>
    </div>
    
    <div class="columns approach-columns reveal" style="--i:3;">
      <article class="approach-card">
        <div class="approach-card__media">
          <Picture
            src={healthSupplies}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={90}
            alt="Health, wellness, and essential supplies arranged for community distribution."
            loading="lazy"
          />
        </div>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Collect useful goods</h3>
          <p class="approach-card__body">Health, hygiene, household, and education goods are gathered around a clear community need.</p>
        </div>
      </article>

      <article class="approach-card">
        <div class="approach-card__media">
          <Picture
            src={communityDistributionWide}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={90}
            alt="Volunteers distributing essential goods to community members at a public support event."
            loading="lazy"
          />
        </div>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Share through trusted relationships</h3>
          <p class="approach-card__body">Volunteers and local partners prepare and share useful support in a welcoming, non-discriminatory, and dignified way.</p>
        </div>
      </article>
    </div>
  </Panel>

  <!-- 03: Rules / Pillars -->
  <Panel id="rules" ground="paper" index={3} total={4} label="Pillars" labelledby="rules-title">
    <div class="panel-head">
      <div class="panel-head__title">
        <p class="eyebrow">Pillars</p>
        <h2 class="reveal" style="--i:1" id="rules-title">Three commitments behind the mission.</h2>
      </div>
    </div>
    
    <div class="principles">
      {ruleCards.map((rule, idx) => (
        <article class="rule-card reveal" style={`--i:${idx + 2}`}>
          <div class="rule-card__media">
            <Picture
              src={rule.image}
              widths={[400, 700]}
              sizes="(min-width: 768px) 33vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={80}
              alt={rule.alt}
              loading="lazy"
            />
          </div>
          <figcaption class="rule-card__doc-caption">
            <span>{rule.captionTitle}</span>
          </figcaption>
          <div class="rule-card__content">
            <h3 class="rule-card__title">{rule.title}</h3>
            <p class="rule-card__body">{rule.body}</p>
            <div class="rule-card__action">
              <a href={rule.href} class="rule-card__link">
                {rule.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </Panel>
  <!-- 04: How the work reaches people -->
  <Panel id="method" ground="sand" index={4} total={4} label="Our method" labelledby="method-title" ctaHref="/what-we-do/" ctaLabel="See what we do">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <h2 class="reveal" style="--i:1" id="method-title">What we hold ourselves to.</h2>
      </div>
        <p class="lead reveal" style="--i:2">Three things stay true of every delivery — whoever receives it, and whoever helped pay for it.</p>
    </div>

    <!-- Editorial Showcase Layout -->
    <div class="model-showcase">
      <div class="model-showcase__content reveal" style="--i:3">
        <div class="model-editorial-block">
          <div class="model-editorial-block__meta">
            <span class="model-editorial-block__label">Useful giving</span>
            <span class="model-editorial-block__sep" aria-hidden="true">|</span>
            <span class="model-editorial-block__tag">Community accountability</span>
          </div>
          <p class="model-editorial-block__lead">
            Our model brings together practical goods, dedicated volunteers, trusted partnerships, and a commitment to serving every community without discrimination.
          </p>
        </div>
      </div>

      <figure class="model-showcase__media reveal" style="--i:4">
        <div class="model-showcase__image-frame">
          <Picture
            src={indoorRelief}
            widths={[600, 900, 1200]}
            sizes="(min-width: 940px) 46vw, 92vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={75}
            alt="Volunteers coordinating direct relief with community members in a public hall."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>Volunteers preparing donated goods for a community distribution event.</figcaption>
      </figure>
    </div>

    <!-- Trust & Verification Bar -->
    <div class="process-guarantee-bar reveal" style="--i:5; margin-top:var(--space-7);">
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1 -5.93 -9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <span>Non-discriminatory service</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        <span>Transparent partnerships</span>
      </div>
      <div class="process-guarantee-divider" aria-hidden="true"></div>
      <div class="process-guarantee-item">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--slate-600)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
        <span>Practical community value</span>
      </div>
    </div>
  </Panel>
</EditorialPage>
