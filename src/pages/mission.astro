---
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import { Picture } from 'astro:assets';
import publicMedicalClinic from '../assets/images/public-medical-clinic.jpg';
import publicPracticalRelief from '../assets/images/public-practical-relief.jpg';
import heroImage from '../assets/images/hero-connection.png';
import waterImage from '../assets/images/essay-03-water-tank.png';
import coopImage from '../assets/images/essay-07-cooperative.png';
import handsImage from '../assets/images/essay-06-hands.png';
import schoolImage from '../assets/images/work-schools-learning.png';
import portraitImage from '../assets/images/who-we-are-portrait.png';

const sections = [
  { id: 'top', label: 'Mission' },
  { id: 'approach', label: 'Approach' },
  { id: 'rules', label: 'Three rules' }
];

const ruleCards = [
  {
    num: '01',
    category: 'Practicality',
    title: 'Useful over impressive',
    body: 'We prioritize immediate practical supplies that families can directly use — like clean water containers, durable blankets, and emergency shelter kits — over grand photo ops.',
    image: publicPracticalRelief,
    alt: 'Direct distribution of essential supplies and clean water containers to local families.',
    captionTitle: 'Kitui Practical Aid Distribution',
    captionStat: '150 families served',
    href: '/what-we-do/#shelter',
    linkText: 'View Emergency Relief'
  },
  {
    num: '02',
    category: 'Autonomy',
    title: 'Local judgement first',
    body: 'People closest to the work know what is safe, possible and still needed.',
    image: coopImage,
    alt: 'Women farmers inspecting yield in cooperative agricultural field.',
    captionTitle: 'Kigali Women’s Cooperative',
    captionStat: '85 farming families',
    href: '/what-we-do/#cooperatives',
    linkText: 'View Local Initiatives'
  },
  {
    num: '03',
    category: 'Commitment',
    title: 'Recovery is part of relief',
    body: 'We do not leave when the headline changes. Repair and recovery take time.',
    image: waterImage,
    alt: 'Solar powered water tank providing clean water filtration in village.',
    captionTitle: 'Turkana Solar Micro-Dam',
    captionStat: '2,100 residents served',
    href: '/what-we-do/#water',
    linkText: 'View Recovery Work'
  }
];
---

<EditorialPage
  activePage="mission"
  eyebrow="Our mission"
  title="Practical help, quickly — with people in control."
  lead="We support people facing hunger, disaster or displacement with the things that make the next day possible — and the next year worth planning for."
  description="Our mission is to make practical humanitarian help available quickly, while keeping decisions with the people affected."
  image={heroImage}
  imageAlt="Community members pass a sack hand to hand as they work together beside a small truck."
  caption="Help reaches people through people who are already there."
  nextHref="/what-we-do/"
  nextLabel="See what we do"
  sections={sections}
  total={3}
>
  <!-- 02 — Approach -->
  <Panel id="approach" ground="sand" index={2} total={3} label="Approach" labelledby="approach-title" nextId="rules" nextLabel="Three rules">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">What we mean by help</p>
        <h2 class="reveal" style="--i:1" id="approach-title">Move at the speed of need. Stay for the work after.</h2>
      </div>
      <p class="lead reveal" style="--i:2">A crisis does not arrive in neat categories. Hunger affects school. A damaged roof affects health. Displacement turns every ordinary task into a negotiation.</p>
    </div>
    
    <div class="columns approach-columns reveal" style="--i:3;">
      <article class="approach-card">
        <div class="photo-manga-grid">
          <div class="photo-manga-grid__main">
            <Picture
              src={publicMedicalClinic}
              widths={[300, 500]}
              sizes="(min-width: 768px) 30vw, 60vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={80}
              alt="Medical professional carrying out rapid community medical consultation."
              loading="lazy"
            />
          </div>
          <div class="photo-manga-grid__sub">
            <div class="photo-manga-grid__cell">
              <Picture
                src={handsImage}
                widths={[200, 350]}
                sizes="(min-width: 768px) 15vw, 30vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                quality={80}
                alt="Community hands passing essential supplies"
                loading="lazy"
              />
            </div>
            <div class="photo-manga-grid__cell">
              <Picture
                src={schoolImage}
                widths={[200, 350]}
                sizes="(min-width: 768px) 15vw, 30vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                quality={80}
                alt="Emergency school classroom"
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <figcaption class="approach-photo-caption">
          <span class="approach-photo-caption__num">FIG 02.1</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-card__tag">Immediate Relief</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-photo-caption__text">Emergency logistics & shelter dispatch</span>
        </figcaption>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Making immediate days safe</h3>
          <p class="approach-card__body">Our first response is immediate stability: clean water, hot food, shelter repair, medical supplies, and safe learning spaces for children.</p>
          <div class="approach-card__stat">
            <span class="approach-card__stat-val">24-48h</span>
            <span class="approach-card__stat-label">Average emergency relief dispatch time to active crisis zones</span>
          </div>
          <div class="approach-card__action">
            <a href="/what-we-do/#emergency" class="approach-card__link">
              Explore Emergency Relief Work <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>

      <article class="approach-card">
        <div class="photo-manga-grid">
          <div class="photo-manga-grid__main">
            <Picture
              src={coopImage}
              widths={[300, 500]}
              sizes="(min-width: 768px) 30vw, 60vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={80}
              alt="Women farmers inspecting agricultural yield in Kigali cooperative."
              loading="lazy"
            />
          </div>
          <div class="photo-manga-grid__sub">
            <div class="photo-manga-grid__cell">
              <Picture
                src={waterImage}
                widths={[200, 350]}
                sizes="(min-width: 768px) 15vw, 30vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                quality={80}
                alt="Solar powered water micro-dam"
                loading="lazy"
              />
            </div>
            <div class="photo-manga-grid__cell">
              <Picture
                src={portraitImage}
                widths={[200, 350]}
                sizes="(min-width: 768px) 15vw, 30vw"
                formats={['avif', 'webp']}
                fallbackFormat="jpeg"
                quality={80}
                alt="Verified local community partner"
                loading="lazy"
              />
            </div>
          </div>
        </div>
        <figcaption class="approach-photo-caption">
          <span class="approach-photo-caption__num">FIG 02.2</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-card__tag approach-card__tag--emerald">Long-Term Autonomy</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-photo-caption__text">Local cooperative leadership & micro-dam</span>
        </figcaption>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Built on local leadership</h3>
          <p class="approach-card__body">Our long-term commitment is preventing dependency. We back local community leaders with self-sustaining projects that endure.</p>
          <div class="approach-card__stat">
            <span class="approach-card__stat-val">100%</span>
            <span class="approach-card__stat-label">Field projects designed & operated by verified local partners</span>
          </div>
          <div class="approach-card__action">
            <a href="/what-we-do/#cooperatives" class="approach-card__link">
              Explore Partner Initiatives <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </Panel>

  <!-- 03 — Rules -->
  <Panel id="rules" ground="paper" index={3} total={3} label="Rules" labelledby="rules-title" ctaHref="/what-we-do/" ctaLabel="See what we do">
    <div class="panel-head">
      <p class="eyebrow reveal">How we decide</p>
      <h2 class="reveal" style="--i:1" id="rules-title">Three rules we hold to.</h2>
    </div>
    
    <div class="principles">
      {ruleCards.map((rule, idx) => (
        <article class="rule-card reveal" style={`--i:${idx + 2}`}>
          <div class="rule-card__media">
            <Picture
              src={rule.image}
              widths={[400, 700]}
              sizes="(min-width: 768px) 33vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={80}
              alt={rule.alt}
              loading="lazy"
            />
          </div>
          <figcaption class="rule-card__doc-caption">
            <span>{rule.captionTitle}</span>
            <span class="rule-card__sep" aria-hidden="true">|</span>
            <span class="rule-card__stat-badge">{rule.captionStat}</span>
          </figcaption>
          <div class="rule-card__content">
            <div class="rule-card__head">
              <span class="rule-card__number">{rule.num}</span>
              <span class="rule-card__category">{rule.category}</span>
            </div>
            <h3 class="rule-card__title">{rule.title}</h3>
            <p class="rule-card__body">{rule.body}</p>
            <div class="rule-card__action">
              <a href={rule.href} class="rule-card__link">
                {rule.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <blockquote class="pull-quote pull-quote--rule reveal" style="--i:5; margin-top: clamp(0.75rem, 2vh, 1.75rem);">
      “The people affected decide what happens next.”
    </blockquote>
  </Panel>
</EditorialPage>


