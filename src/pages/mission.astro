---
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import { Picture } from 'astro:assets';
import h1 from '../assets/images/h1.jpg';
import h3 from '../assets/images/h3.jpg';
import h7 from '../assets/images/h7.jpg';
import h9 from '../assets/images/h9.jpg';
import h10 from '../assets/images/h10.jpg';
import h12 from '../assets/images/h12.jpg';
import h13 from '../assets/images/h13.jpg';
import h14 from '../assets/images/h14.jpg';
import h15 from '../assets/images/h15.jpg';
import publicFood from '../assets/images/public-volunteer-food.jpg';
import publicTools from '../assets/images/public-practical-tools.jpg';

const sections = [
  { id: 'top', label: 'Mission' },
  { id: 'approach', label: 'Approach' },
  { id: 'rules', label: 'Three pillars' }
];

const ruleCards = [
  {
    num: '01',
    category: 'Vulnerable Groups',
    title: 'Children, Families & Veterans',
    body: 'We prioritize rapid assistance for children, families, veterans, older adults, and communities facing catastrophic events and all-hazards disasters.',
    image: publicFood,
    alt: 'Volunteers delivering essential aid packages directly to community families.',
    captionTitle: 'Direct Relief Dispatch',
    captionStat: '450 families served',
    href: '/what-we-do/#shelter',
    linkText: 'View Emergency Relief'
  },
  {
    num: '02',
    category: 'Logistics Fleet',
    title: 'Rapid Supply Logistics',
    body: 'Through an efficient logistics network supported by our fleet, we transport critical aid quickly and reliably to ground zero.',
    image: h14,
    alt: 'Volunteers loading and transporting relief boxes via logistics transport fleet.',
    captionTitle: 'Fleet Distribution Network',
    captionStat: '100% direct delivery',
    href: '/what-we-do/#cooperatives',
    linkText: 'View Fleet Operations'
  },
  {
    num: '03',
    category: 'Partnerships',
    title: 'Public-Private Ecosystem',
    body: 'Strategic public-private partnerships combined with a dedicated volunteer network empower communities to prepare, respond, and recover with dignity.',
    image: publicTools,
    alt: 'Practical support items and essential supplies delivered through community ecosystem.',
    captionTitle: 'Community Support Network',
    captionStat: '1,200 residents served',
    href: '/what-we-do/#water',
    linkText: 'View Partnership Work'
  }
];
---

<EditorialPage
  activePage="mission"
  eyebrow="Our mission"
  title="Saving lives & restoring hope — one delivery at a time."
  lead="Hands Across Humanity is dedicated to rapidly collecting and distributing essential supplies and resources to children, families, veterans, older adults, and communities affected by disasters, all-hazards events, and catastrophic situations."
  description="Through strategic public-private partnerships, a dedicated volunteer network, and efficient logistics supported by our fleet, we empower communities to prepare, respond, and recover with dignity and resilience."
  image={h3}
  imageAlt="Large community fair hall filled with local residents and volunteers."
  caption="Saving lives and restoring hope — one delivery at a time."
  nextHref="/what-we-do/"
  nextLabel="See what we do"
  sections={sections}
  total={3}
>
  <!-- 02 — Approach -->
  <Panel id="approach" ground="sand" index={2} total={3} label="Approach" labelledby="approach-title" nextId="rules" nextLabel="Three pillars">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">How we operate</p>
        <h2 class="reveal" style="--i:1" id="approach-title">Public-Private Partnerships & Rapid Fleet Logistics.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Through strategic partnerships, a dedicated volunteer network, and our fleet logistics, we enable communities to prepare, respond, and recover with dignity.</p>
    </div>
    
    <div class="columns approach-columns reveal" style="--i:3;">
      <article class="approach-card">
        <div class="approach-card__media">
          <Picture
            src={h10}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={90}
            alt="Community health station table stocked with vitamins and medical supplies."
            loading="lazy"
          />
        </div>
        <figcaption class="approach-photo-caption">
          <span class="approach-card__tag">Fleet Logistics</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-photo-caption__text">Rapid collection & essential supply distribution</span>
        </figcaption>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Rapid Collection & Distribution</h3>
          <p class="approach-card__body">Collecting essential resources and delivering them directly to children, families, veterans, and older adults when catastrophe strikes.</p>
          <div class="approach-card__stat">
            <span class="approach-card__stat-val">Rapid Fleet</span>
            <span class="approach-card__stat-label">Efficient distribution network for all-hazards and disaster events</span>
          </div>
          <div class="approach-card__action">
            <a href="/what-we-do/#emergency" class="approach-card__link">
              Explore Emergency Response <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>

      <article class="approach-card">
        <div class="approach-card__media">
          <Picture
            src={h12}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={90}
            alt="Dedicated volunteer team showing heart hand gestures behind support center table."
            loading="lazy"
          />
        </div>
        <figcaption class="approach-photo-caption">
          <span class="approach-card__tag approach-card__tag--emerald">Volunteer & Strategic Network</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-photo-caption__text">Public-private partnerships & grassroots volunteers</span>
        </figcaption>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Empowering Communities to Recover</h3>
          <p class="approach-card__body">Combining public-private alliances with grassroots volunteer dedication to build lasting dignity, resilience, and hope.</p>
          <div class="approach-card__stat">
            <span class="approach-card__stat-val">Collaborative</span>
            <span class="approach-card__stat-label">Uniting corporate partners, volunteers, and local leadership</span>
          </div>
          <div class="approach-card__action">
            <a href="/what-we-do/#cooperatives" class="approach-card__link">
              Explore Volunteer Initiatives <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </Panel>

  <!-- 03 — Rules / Pillars -->
  <Panel id="rules" ground="paper" index={3} total={3} label="Pillars" labelledby="rules-title" ctaHref="/what-we-do/" ctaLabel="See what we do">
    <div class="panel-head">
      <p class="eyebrow reveal">Core commitments</p>
      <h2 class="reveal" style="--i:1" id="rules-title">Three pillars of our mission.</h2>
    </div>
    
    <div class="principles">
      {ruleCards.map((rule, idx) => (
        <article class="rule-card reveal" style={`--i:${idx + 2}`}>
          <div class="rule-card__media">
            <Picture
              src={rule.image}
              widths={[400, 700]}
              sizes="(min-width: 768px) 33vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={80}
              alt={rule.alt}
              loading="lazy"
            />
          </div>
          <figcaption class="rule-card__doc-caption">
            <span>{rule.captionTitle}</span>
            <span class="rule-card__sep" aria-hidden="true">|</span>
            <span class="rule-card__stat-badge">{rule.captionStat}</span>
          </figcaption>
          <div class="rule-card__content">
            <div class="rule-card__head">
              <span class="rule-card__number">{rule.num}</span>
              <span class="rule-card__category">{rule.category}</span>
            </div>
            <h3 class="rule-card__title">{rule.title}</h3>
            <p class="rule-card__body">{rule.body}</p>
            <div class="rule-card__action">
              <a href={rule.href} class="rule-card__link">
                {rule.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <blockquote class="pull-quote pull-quote--rule reveal" style="--i:5; margin-top: clamp(0.75rem, 2vh, 1.75rem);">
      “Empowering communities to prepare, respond, and recover with dignity and resilience — saving lives and restoring hope one delivery at a time.”
    </blockquote>
  </Panel>
</EditorialPage>


