---
import DeferredPicture from '../components/DeferredPicture.astro';
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import DonationMoment from '../components/DonationMoment.astro';
import RecentEvents from '../components/RecentEvents.astro';
import { getEvents } from '../lib/events';
import {
  communityDistribution,
  reliefDistributionWide,
  communityDistributionWide,
  supplyHandoff,
  partnerShowcase,
  healthSupplies,
} from '../assets/images/eps';

/* Mission answers one question — what does Hands Across Humanity exist to do —
   in the order a visitor needs it: the purpose, with who it is for and why it
   is needed in the hero's signal row, then how the work runs, what it holds itself to, and dated proof that it
   is happening. Only then does it ask for support.

   The hero used to open on "Saving lives" and on communities "affected by
   disasters, all-hazards events, and catastrophic situations". Nothing on the
   site shows either: every dated activity is a community event in the Houston
   area. The claims come back when there is a real response to show beside them. */

const { past } = await getEvents();
const recent = past.slice(0, 2);

const sections = [
  { id: 'top', label: 'Mission' },
  { id: 'approach', label: 'How support moves' },
  { id: 'rules', label: 'Commitments' },
  ...(recent.length ? [{ id: 'now', label: 'Recently' }] : []),
];
const total = sections.length;

// Who, why and why-this-way sit in the hero's signal row, where every editorial
// page carries its summary. As a separate section they left the hero a screen
// tall with nothing at its base, followed by a short band that read as an
// afterthought.
const heroSignals = [
  {
    title: 'Who we serve',
    text: 'Children, families, veterans, older adults, and neighbors facing an urgent need.',
  },
  {
    title: 'The need',
    text: 'Useful goods often sit unused while communities nearby are under pressure.',
  },
  {
    title: 'Why this approach',
    text: 'Local partners know what will help, so goods reach the right hands.',
  },
];

// These were "Three pillars" that restated the hero and linked to pages that
// did not deliver what the links promised. They are now the three commitments
// that used to sit on Work, where they answer what the work holds itself to.
const commitments = [
  {
    title: 'Listen first',
    body: 'Learn what people and local partners need before deciding what support will be useful.',
    image: communityDistribution,
    alt: 'Volunteers coordinating essential goods with community members at a community event.',
    caption: 'Volunteers with community members',
  },
  {
    title: 'Prepare with care',
    body: 'Sort, organize, and move goods carefully with volunteers and partners.',
    image: supplyHandoff,
    alt: 'Volunteers moving boxed supplies on a cart for distribution.',
    caption: 'Boxed supplies on the way to distribution',
  },
  {
    title: 'Share without discrimination',
    body: 'Every handoff is welcoming, non-discriminatory, and dignified.',
    image: partnerShowcase,
    alt: 'Partners and volunteers gathered behind a table of supplies.',
    caption: 'Partners and volunteers at a supply table',
  },
];
---

<EditorialPage
  activePage="mission"
  title="Getting useful goods to neighbors, one delivery at a time."
  lead="Hands Across Humanity collects essential supplies and shares them through local partners and volunteers in the Houston area."
  description="Hands Across Humanity collects useful goods and shares them through local partners and volunteers in the Houston area, with children, families, veterans, older adults, and neighbors facing an urgent need."
  image={reliefDistributionWide}
  imageAlt="Volunteers and community members coordinating a distribution in a large public hall."
  caption="Volunteers and neighbors at a community distribution in a public hall."
  heroSignals={heroSignals}
  sections={sections}
  total={total}
>
  <!-- 02: How support moves -->
  <Panel id="approach" ground="paper" index={2} total={total} label="How support moves" labelledby="approach-title" nextId="rules" nextLabel="Commitments">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow">How support moves</p>
        <h2 class="reveal" style="--i:1" id="approach-title">Gather, prepare, share.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Businesses and neighbors gather useful goods, volunteers prepare them, and local partners share them where they are needed.</p>
    </div>

    <div class="columns approach-columns reveal" style="--i:3;">
      <article class="approach-card">
        <div class="approach-card__media">
          <DeferredPicture
            src={healthSupplies}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            quality={90}
            alt="Health, wellness, and essential supplies arranged for community distribution."
          />
        </div>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Gather and prepare</h3>
          <p class="approach-card__body">Health, hygiene, household, and education goods are collected and sorted around a clear community need.</p>
        </div>
      </article>

      <article class="approach-card">
        <div class="approach-card__media">
          <DeferredPicture
            src={communityDistributionWide}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            quality={90}
            alt="Volunteers distributing essential goods to community members at a public support event."
          />
        </div>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Share</h3>
          <p class="approach-card__body">Volunteers and local partners hand goods to the people they are meant for.</p>
        </div>
      </article>
    </div>
    <p class="panel-link reveal" style="--i:4"><a class="rule-card__link" href="/what-we-do/#connect">See how it works in detail <span aria-hidden="true">→</span></a></p>
  </Panel>

  <!-- 03: Commitments -->
  <Panel id="rules" ground="sand" index={3} total={total} label="Commitments" labelledby="rules-title" nextId={recent.length ? 'now' : undefined} nextLabel={recent.length ? 'Recently' : undefined}>
    <div class="panel-head">
      <div class="panel-head__title">
        <p class="eyebrow">Commitments</p>
        <h2 class="reveal" style="--i:1" id="rules-title">What we hold ourselves to.</h2>
      </div>
    </div>

    <div class="principles">
      {commitments.map((rule, idx) => (
        <figure class="rule-card reveal" style={`--i:${idx + 2}`}>
          <div class="rule-card__media">
            <DeferredPicture
              src={rule.image}
              widths={[400, 700]}
              sizes="(min-width: 768px) 33vw, 90vw"
              quality={80}
              alt={rule.alt}
            />
          </div>
          <figcaption class="rule-card__doc-caption">
            <span>{rule.caption}</span>
          </figcaption>
          <div class="rule-card__content">
            <h3 class="rule-card__title">{rule.title}</h3>
            <p class="rule-card__body">{rule.body}</p>
          </div>
        </figure>
      ))}
    </div>
  </Panel>

  <!-- 05: Dated proof, from the events sheet -->
  {recent.length > 0 && (
    <Panel id="now" ground="paper" index={4} total={total} label="Recently" labelledby="now-title">
      <div class="panel-head panel-head--split">
        <div class="panel-head__title">
          <p class="eyebrow">Recently</p>
          <h2 class="reveal" style="--i:1" id="now-title">What it looks like now.</h2>
        </div>
        <p class="lead reveal" style="--i:2">Events we took part in with local partners.</p>
      </div>
      <div class="reveal" style="--i:3">
        <RecentEvents events={recent} />
        <p class="panel-link"><a class="rule-card__link" href="/events/#recent">See all events <span aria-hidden="true">→</span></a></p>
      </div>
    </Panel>
  )}

  <!-- The ask comes last, after the proof. On the rare build with no past
       events it follows the light-blue commitments, so it takes the white ground. -->
  <DonationMoment
    title="Help make the next handoff ready."
    text="A gift helps strengthen the practical work around gathering, preparing, and sharing useful support with local partners."
    ctaLabel="Support the next handoff"
    href="/donate/?focus=community"
    ground={recent.length ? 'tint' : 'paper'}
  />
</EditorialPage>
