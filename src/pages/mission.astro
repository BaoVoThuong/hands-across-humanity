---
import EditorialPage from '../components/EditorialPage.astro';
import Panel from '../components/Panel.astro';
import { Picture } from 'astro:assets';
import {
  communityDistribution,
  reliefDistributionWide,
  communityDistributionWide,
  supplyHandoff,
  partnerShowcase,
  healthSupplies,
} from '../assets/images/eps';

const sections = [
  { id: 'top', label: 'Mission' },
  { id: 'approach', label: 'Approach' },
  { id: 'rules', label: 'Three pillars' }
];

const ruleCards = [
  {
    num: '01',
    category: 'Who we serve',
    title: 'Support starts with people',
    body: 'We collect and share essential supplies with children, families, veterans, older adults, and communities affected by disasters and other urgent situations.',
    image: communityDistribution,
    alt: 'Volunteers coordinating essential goods with community members at a relief event.',
    captionTitle: 'Direct community support',
    captionStat: 'Essential goods',
    href: '/what-we-do/#areas',
    linkText: 'See where support goes'
  },
  {
    num: '02',
    category: 'How we act',
    title: 'Useful aid, ready when needed',
    body: 'Strategic partnerships, dedicated volunteers, and efficient transport support help essential goods reach people quickly and reliably.',
    image: supplyHandoff,
    alt: 'Volunteers moving boxed supplies on a cart for direct distribution.',
    captionTitle: 'Coordinated supply handoff',
    captionStat: 'Practical response',
    href: '/what-we-do/#connect',
    linkText: 'See how it comes together'
  },
  {
    num: '03',
    category: 'Who makes it possible',
    title: 'Partnerships that multiply care',
    body: 'Businesses, nonprofits, houses of worship, volunteers, and local leaders work together so communities can prepare, respond, and recover with dignity.',
    image: partnerShowcase,
    alt: 'Corporate partners and volunteers gathered behind a relief supply table.',
    captionTitle: 'Community support network',
    captionStat: 'Shared responsibility',
    href: '/vision/',
    linkText: 'Meet our partners'
  }
];
---

<EditorialPage
  activePage="mission"
  eyebrow="Our mission"
  title="Saving lives and restoring hope, one delivery at a time."
  lead="Hands Across Humanity rapidly collects and distributes essential supplies and resources to children, families, veterans, older adults, and communities affected by disasters, all-hazards events, and catastrophic situations."
  description="Through strategic public-private partnerships, a dedicated volunteer network, and efficient transport support, we empower communities to prepare, respond, and recover with dignity and resilience."
  image={reliefDistributionWide}
  imageAlt="Volunteers and community members coordinating relief distribution in a large public hall."
  caption="Saving lives and restoring hope, one delivery at a time."
  nextHref="/what-we-do/"
  nextLabel="See what we do"
  sections={sections}
  total={3}
>
  <!-- 02: Approach -->
  <Panel id="approach" ground="sand" index={2} total={3} label="Approach" labelledby="approach-title" nextId="rules" nextLabel="Three pillars">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <p class="eyebrow reveal">How we operate</p>
        <h2 class="reveal" style="--i:1" id="approach-title">From generosity to a response people can feel.</h2>
      </div>
      <p class="lead reveal" style="--i:2">Through strategic partnerships, dedicated volunteers, and reliable transport support, we help communities prepare, respond, and recover with dignity.</p>
    </div>
    
    <div class="columns approach-columns reveal" style="--i:3;">
      <article class="approach-card">
        <div class="approach-card__media">
          <Picture
            src={healthSupplies}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={90}
            alt="Health, wellness, and essential supplies arranged for community distribution."
            loading="lazy"
          />
        </div>
        <figcaption class="approach-photo-caption">
          <span class="approach-card__tag">Practical giving</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-photo-caption__text">Collecting essential goods for community support</span>
        </figcaption>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Collect what communities can use</h3>
          <p class="approach-card__body">We turn useful donations into practical support for children, families, veterans, and older adults when needs become urgent.</p>
          <div class="approach-card__stat">
            <span class="approach-card__stat-val">Essential goods</span>
            <span class="approach-card__stat-label">Health, hygiene, household, and education supplies</span>
          </div>
          <div class="approach-card__action">
            <a href="/what-we-do/#areas" class="approach-card__link">
              Explore practical support <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>

      <article class="approach-card">
        <div class="approach-card__media">
          <Picture
            src={communityDistributionWide}
            widths={[600, 900, 1200]}
            sizes="(min-width: 768px) 45vw, 90vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={90}
            alt="Volunteers distributing essential goods to community members at a public support event."
            loading="lazy"
          />
        </div>
        <figcaption class="approach-photo-caption">
          <span class="approach-card__tag approach-card__tag--emerald">People-powered support</span>
          <span class="approach-photo-caption__sep" aria-hidden="true">|</span>
          <span class="approach-photo-caption__text">Partners and volunteers sharing support locally</span>
        </figcaption>
        <div class="approach-card__content">
          <h3 class="approach-card__title">Share through trusted relationships</h3>
          <p class="approach-card__body">Local partners and volunteers help support reach people in a way that is welcoming, non-discriminatory, and grounded in dignity.</p>
          <div class="approach-card__stat">
            <span class="approach-card__stat-val">Collaborative</span>
            <span class="approach-card__stat-label">Uniting businesses, volunteers, and local leadership</span>
          </div>
          <div class="approach-card__action">
            <a href="/what-we-do/#connect" class="approach-card__link">
              Explore community support <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    </div>
  </Panel>

  <!-- 03: Rules / Pillars -->
  <Panel id="rules" ground="paper" index={3} total={3} label="Pillars" labelledby="rules-title" ctaHref="/what-we-do/" ctaLabel="See what we do">
    <div class="panel-head">
      <p class="eyebrow reveal">Core commitments</p>
      <h2 class="reveal" style="--i:1" id="rules-title">Three commitments behind the mission.</h2>
    </div>
    
    <div class="principles">
      {ruleCards.map((rule, idx) => (
        <article class="rule-card reveal" style={`--i:${idx + 2}`}>
          <div class="rule-card__media">
            <Picture
              src={rule.image}
              widths={[400, 700]}
              sizes="(min-width: 768px) 33vw, 90vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpeg"
              quality={80}
              alt={rule.alt}
              loading="lazy"
            />
          </div>
          <figcaption class="rule-card__doc-caption">
            <span>{rule.captionTitle}</span>
            <span class="rule-card__sep" aria-hidden="true">|</span>
            <span class="rule-card__stat-badge">{rule.captionStat}</span>
          </figcaption>
          <div class="rule-card__content">
            <div class="rule-card__head">
              <span class="rule-card__number">{rule.num}</span>
              <span class="rule-card__category">{rule.category}</span>
            </div>
            <h3 class="rule-card__title">{rule.title}</h3>
            <p class="rule-card__body">{rule.body}</p>
            <div class="rule-card__action">
              <a href={rule.href} class="rule-card__link">
                {rule.linkText} <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <blockquote class="pull-quote pull-quote--rule reveal" style="--i:5; margin-top: clamp(0.75rem, 2vh, 1.75rem);">
      “We empower communities to prepare, respond, and recover with dignity and resilience. Every useful donation helps restore hope.”
    </blockquote>
  </Panel>
</EditorialPage>
