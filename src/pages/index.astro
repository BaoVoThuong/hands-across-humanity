---
import SiteLayout from '../layouts/SiteLayout.astro';
import TrustStrip from '../components/ui/TrustStrip.astro';
import HeroSection from '../components/home/HeroSection.astro';
import StatsBar from '../components/home/StatsBar.astro';
import ImpactCalculator from '../components/home/ImpactCalculator.astro';
import ProjectsGrid from '../components/projects/ProjectsGrid.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import TestimonialSection from '../components/home/TestimonialSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';

import heroImage from '../assets/images/hero-connection.png';
import waterImage from '../assets/images/essay-03-water-tank.png';
import schoolImage from '../assets/images/work-schools-learning.png';
import roofImage from '../assets/images/essay-04-roofing-sheets.png';
import coopImage from '../assets/images/essay-07-cooperative.png';
import portraitImage from '../assets/images/who-we-are-portrait.png';
import handsImage from '../assets/images/essay-06-hands.png';

const description = 'Hands Across Humanity connects global partners and donors directly with sustainable community relief, clean water, education, and emergency response.';

const stats = [
  { val: '142,000+', label: 'People Provided Clean Water' },
  { val: '84', label: 'Active Field Initiatives' },
  { val: '94%', label: 'Direct Program Allocation' },
  { val: '12', label: 'Regional Field Networks' }
];

const projects = [
  {
    id: 'water',
    title: 'Kitui Solar Water Well System',
    category: 'Clean Water',
    location: 'Kitui County, Kenya',
    images: [
      { src: waterImage, alt: 'Villagers gathered around a solar-powered water storage tank in Kenya.' },
      { src: heroImage, alt: 'Community leaders coordinating water tap construction.' },
      { src: handsImage, alt: 'Hands receiving clean running water from new field tap.' }
    ],
    progress: 88,
    raised: '$44,000',
    goal: '$50,000',
    impact: '1,400 daily residents served with pure drinking water.',
    auditPartner: 'East Africa Water & Engineering Board',
    details: 'This project constructs a 120-meter deep solar-powered borehole well, equipped with high-capacity storage tanks, multi-tap distribution stations, and water quality filtration kits. Built and maintained by trained local technicians.'
  },
  {
    id: 'school',
    title: 'Baringo Primary Learning Center',
    category: 'Education',
    location: 'Rift Valley, Kenya',
    images: [
      { src: schoolImage, alt: 'Schoolchildren sitting attentively at desks inside a brightly lit classroom.' },
      { src: portraitImage, alt: 'Local student smiling with new textbook learning materials.' },
      { src: heroImage, alt: 'Community volunteers completing roof construction on rural school.' }
    ],
    progress: 92,
    raised: '$32,200',
    goal: '$35,000',
    impact: '320 children enrolled with new textbooks & solar power.',
    auditPartner: 'Regional Rural Education Directorate',
    details: 'Constructs two permanent brick classrooms, outfits 80 wooden desks, installs solar rooftop microgrids for evening study, and supplies 640 textbooks directly to primary school students.'
  },
  {
    id: 'roof',
    title: 'Emergency Storm Shelters',
    category: 'Emergency Relief',
    location: 'Northern Mindanao, Philippines',
    images: [
      { src: roofImage, alt: 'Community members holding galvanized roofing sheets for storm repairs.' },
      { src: handsImage, alt: 'Relief workers distributing emergency shelter toolkits.' },
      { src: coopImage, alt: 'Reconstructed community center shelter following typhoon recovery.' }
    ],
    progress: 75,
    raised: '$22,500',
    goal: '$30,000',
    impact: '150 displaced families supplied with wind-resistant roofing.',
    auditPartner: 'Mindanao Community Disaster Response Network',
    details: 'Delivers heavy-gauge galvanized iron roofing sheets, timber framing, typhoon anchors, and tool repair kits to families recovering from severe tropical storm damage.'
  },
  {
    id: 'coop',
    title: 'Women’s Agricultural Cooperative',
    category: 'Cooperatives',
    location: 'Kigali District, Rwanda',
    images: [
      { src: coopImage, alt: 'Women farmers holding harvested crops together in a cooperative field.' },
      { src: portraitImage, alt: 'Cooperative leader inspecting organic produce yield.' },
      { src: waterImage, alt: 'Solar drip irrigation system supplying cooperative crops.' }
    ],
    progress: 96,
    raised: '$28,800',
    goal: '$30,000',
    impact: '85 local farming families provided seeds, tools & market access.',
    auditPartner: 'Rwanda Smallholder Farmers Alliance',
    details: 'Provides high-yield drought-resistant seeds, drip irrigation equipment, organic fertilizer, and direct transport logistics to connect women farmers with urban produce markets.'
  },
  {
    id: 'turkana',
    title: 'Turkana Drought Micro-Dam',
    category: 'Clean Water',
    location: 'Turkana County, Kenya',
    images: [
      { src: waterImage, alt: 'Construction of rainwater harvesting dam in arid Turkana.' },
      { src: handsImage, alt: 'Local engineers measuring water table filtration levels.' },
      { src: heroImage, alt: 'Community gathering at newly completed water reservoir.' }
    ],
    progress: 81,
    raised: '$36,500',
    goal: '$45,000',
    impact: '2,100 pastoralists provided reliable water during dry seasons.',
    auditPartner: 'East Africa Water & Engineering Board',
    details: 'Constructs a 45,000-liter masonry sand dam and sand-filter retention wall, capturing seasonal flash rain floods to recharge local aquifers and provide livestock/community water access.'
  },
  {
    id: 'clinic',
    title: 'Mindanao Disaster Health Clinic',
    category: 'Emergency Relief',
    location: 'Surigao del Sur, Philippines',
    images: [
      { src: roofImage, alt: 'Mobile emergency health clinic equipped for tropical storm recovery.' },
      { src: portraitImage, alt: 'Nurse providing pediatric care at field clinic station.' },
      { src: handsImage, alt: 'Medical supplies dispatched directly to island communities.' }
    ],
    progress: 89,
    raised: '$26,700',
    goal: '$30,000',
    impact: '650 emergency patients treated monthly with cold-chain vaccines.',
    auditPartner: 'Mindanao Community Disaster Response Network',
    details: 'Equips a modular solar-powered primary health station with vaccine cold-chain refrigeration, clean birthing kits, and emergency trauma supply kits for typhoon-prone coastal communities.'
  }
];

const processSteps = [
  { num: '01', title: 'Grassroots Identification', text: 'Local community leaders assess urgent ground needs and design tailored infrastructure solutions.' },
  { num: '02', title: 'Direct Field Funding', text: 'Capital transfers directly to registered local partners with zero administrative overhead.' },
  { num: '03', title: 'Community-Led Build', text: 'Local technicians and residents construct facilities, ensuring long-term self-reliance.' },
  { num: '04', title: 'Audited Impact Proof', text: 'Every project publishes verified financial receipts, photo evidence, and metric logs.' }
];

const testimonials = [
  {
    quote: '“Hands Across Humanity provides the fastest, most transparent funding mechanism we have ever worked with. They trust local leaders to know what their communities need.”',
    name: 'Dr. Amina Mwangi',
    role: 'Regional Director',
    organization: 'East Africa Water Trust',
    location: 'Kitui County, Kenya',
    category: 'field-leaders',
    verified: true,
    verifiedText: 'Verified Audit Partner',
    projectId: 'water',
    projectTitle: 'Kitui Solar Water Well System',
    initials: 'AM',
    accentColor: 'var(--primary)'
  },
  {
    quote: '“As a corporate donor, seeing exactly where every dollar goes with verified photo updates and audited receipts gives our foundation complete confidence.”',
    name: 'Marcus Vance',
    role: 'Board Chair',
    organization: 'Global Impact Philanthropy Alliance',
    location: 'Geneva, Switzerland',
    category: 'foundations',
    verified: true,
    verifiedText: 'Audited Funder',
    projectId: 'coop',
    projectTitle: 'Women’s Agricultural Cooperative',
    initials: 'MV',
    accentColor: 'var(--emerald)'
  },
  {
    quote: '“When the flooding destroyed our school roofs, help arrived within 48 hours. Our children were back learning in clean classrooms within two weeks.”',
    name: 'Elena Rostova',
    role: 'Community Relief Director',
    organization: 'Disaster Relief Network',
    location: 'Northern Mindanao, Philippines',
    category: 'field-leaders',
    verified: true,
    verifiedText: 'Verified Field Partner',
    projectId: 'roof',
    projectTitle: 'Emergency Storm Shelters',
    avatar: portraitImage
  }
];

const faqs = [
  {
    category: 'Financials',
    q: 'What percentage of my donation goes directly to ground programs?',
    a: 'Exactly 94% of every dollar donated directly funds ground supplies, engineering equipment, and local partner execution. Only 6% covers administrative audit compliance and payment processing.'
  },
  {
    category: 'Field Vetting',
    q: 'How are local field partners selected and vetted?',
    a: 'We work exclusively with legally registered community non-profits and field cooperatives that have at least 3 years of proven operational history and local governance transparency.'
  },
  {
    category: 'Tax & Compliance',
    q: 'Is my donation tax-deductible and how do I receive receipts?',
    a: 'Yes! Hands Across Humanity is a registered 501(c)(3) public charity. An official tax-deductible receipt with detailed audit serial numbers is emailed instantly upon donation.'
  },
  {
    category: 'Enterprise & Foundations',
    q: 'Can corporate partners or foundations sponsor specific projects?',
    a: 'Absolutely. We offer dedicated co-sponsorship programs for foundations and enterprises, including customized impact dashboards and quarterly field audit reports.'
  },
  {
    category: 'Audit & Accountability',
    q: 'How are field projects audited and verified over time?',
    a: 'Every field project undergoes dual-layer auditing: local registered engineering boards verify construction milestones, and photo/video GPS logs are published directly to our transparent public ledger.'
  },
  {
    category: 'Donor Transparency',
    q: 'Can I track the exact field project my funds were allocated to?',
    a: 'Yes. Donors receive dedicated tracking codes allowing them to view real-time milestone updates, photo proof of completion, and community impact reports for their specific project.'
  }
];
---

<SiteLayout
  title="Hands Across Humanity | Direct & Transparent Humanitarian Action"
  description={description}
>
  <main id="main">
    <div class="hero-fold-group">
      <HeroSection />
      <StatsBar stats={stats} />
      <TrustStrip />
    </div>
    <ImpactCalculator />
    <ProjectsGrid projects={projects} />
    <ProcessSection steps={processSteps} />
    <TestimonialSection testimonials={testimonials} />
    <FaqSection faqs={faqs} />
    <ClosingCTA />
  </main>
</SiteLayout>

