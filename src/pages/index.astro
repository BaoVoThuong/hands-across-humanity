---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ImpactBand from '../components/home/ImpactBand.astro';
import AboutFieldNotes from '../components/home/AboutFieldNotes.astro';
import FaqSection from '../components/home/FaqSection.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';

const description = 'Hands Across Humanity connects donors, volunteers, businesses, and community partners to collect and share essential goods with people facing urgent need.';

const faqs = [
  {
    category: 'Giving',
    q: 'What kind of donations are useful?',
    a: 'We focus on practical health, hygiene, household, and education supplies that can be prepared and shared through trusted community partners.'
  },
  {
    category: 'Community support',
    q: 'Who receives the support?',
    a: 'Children, families, veterans, older adults, and neighbors facing an urgent need. Local partners help us understand what will be useful and where it should go.'
  },
  {
    category: 'Volunteering',
    q: 'How can I help?',
    a: 'Give useful goods, volunteer at a collection or distribution event, or connect us with a business, nonprofit, or community group that wants to contribute.'
  },
  {
    category: 'Accountability',
    q: 'How do you keep donations accountable?',
    a: 'We organize donated goods, work with community partners, and communicate where support is going so the process stays practical, transparent, and non-discriminatory.'
  }
];
---

<SiteLayout
  title="Hands Across Humanity | Direct & Transparent Humanitarian Action"
  description={description}
>
  <main id="main">
    <div class="hero-fold-group">
      <HeroSection />
      <ImpactBand />
    </div>
    <AboutFieldNotes />
    <FaqSection faqs={faqs} />
    <ClosingCTA />
  </main>
</SiteLayout>
