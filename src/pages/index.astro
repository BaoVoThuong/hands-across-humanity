---
import { Picture } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Panel from '../components/Panel.astro';
import heroImage from '../assets/images/hero-connection.png';

const description = 'Hands Across Humanity works with local communities on practical relief, education, emergency response and long-term recovery.';

const sections = [
  { id: 'top', label: 'Start' },
  { id: 'explore', label: 'Explore' },
  { id: 'donate', label: 'Give' }
];

const pages = [
  { href: '/mission/', label: 'Mission', text: 'Practical help, quickly — with people in control.' },
  { href: '/what-we-do/', label: 'What We Do', text: 'Four kinds of work, shaped by local priorities.' },
  { href: '/vision/', label: 'Vision', text: 'Help should move sideways, not downward.' },
  { href: '/who-we-are/', label: 'Who We Are', text: 'The people closest to the work lead it.' }
];
---

<SiteLayout
  title="Hands Across Humanity | Humanitarian Relief and Recovery"
  description={description}
  sections={sections}
>
  <main id="main">
    <!-- 01 — Hero -->
    <section class="panel hero panel--paper" id="top" data-panel aria-labelledby="home-title">
      <div class="hero__grid">
        <div class="hero__copy">
          <p class="eyebrow reveal">Humanitarian relief and community support</p>
          <h1 class="hero__title reveal" style="--i:1" id="home-title">We help people the way we would want to be helped.</h1>
          <p class="hero__lead reveal" style="--i:2">We work with local communities to meet urgent needs — then stay for the slower work of putting life back together.</p>
          <div class="btn-row reveal" style="--i:3">
            <a class="btn btn--donate" href="/#donate">Donate Now<span class="btn__arrow" aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href="/what-we-do/">See the work</a>
          </div>
          <a class="hero__scroll reveal" style="--i:4" href="#explore">
            <i aria-hidden="true"></i>Scroll
          </a>
        </div>
        <figure class="hero__media">
          <Picture
            src={heroImage}
            widths={[720, 1000, 1400, 1672]}
            sizes="(min-width: 880px) 52vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpeg"
            quality={62}
            alt="Community members pass a sack hand to hand as they work together beside a small truck."
            loading="eager"
            fetchpriority="high"
          />
          <figcaption class="hero__caption">Help reaches people through people who are already there.</figcaption>
        </figure>
      </div>
    </section>

    <!-- 02 — Explore -->
    <Panel id="explore" ground="sand" index={2} total={3} label="Explore" labelledby="explore-title" nextId="donate" nextLabel="Why give">
        <div class="panel-head panel-head--split">
          <div class="panel-head__title">
            <p class="eyebrow reveal">Explore the organisation</p>
            <h2 class="reveal" style="--i:1" id="explore-title">Start with the question you have.</h2>
          </div>
          <p class="lead reveal" style="--i:2">Four short pages. Each one answers a single question plainly, with no jargon and no claims we cannot stand behind.</p>
        </div>
        <div class="explore-grid">
          {pages.map((page, index) => (
            <a class="explore-card reveal" style={`--i:${index + 1}`} href={page.href}>
              <span class="explore-card__number">0{index + 1}</span>
              <h3>{page.label}</h3>
              <p>{page.text}</p>
              <span class="explore-card__arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
    </Panel>

    <!-- 03 — Donate -->
    <Panel id="donate" ground="ink" index={3} total={3} label="Why give" labelledby="donate-title" width="narrow">
      <div>
        <p class="eyebrow reveal">Why give</p>
        <h2 class="reveal" style="--i:1" id="donate-title">A small amount, given regularly, is the most useful kind of help.</h2>
        <div class="prose reveal" style="--i:2; margin-top:var(--space-5)">
          <p>Emergencies are loud and short. Recovery is quiet and long. Regular gifts, even small ones, let us plan past next month — and let us promise a family something we can actually keep.</p>
          <p>Give once if that suits you better. Both help.</p>
        </div>
        <div class="btn-row reveal" style="--i:3; margin-top:var(--space-7)">
          <a class="btn btn--donate" href="/#donate">Donate Now<span class="btn__arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/who-we-are/">How we work</a>
        </div>
        <p class="footer-note reveal" style="--i:4; margin-top:var(--space-5)">
          Nothing is collected on this website. Giving will be handled by an external payment provider, connected before launch.
        </p>
      </div>
    </Panel>
  </main>
</SiteLayout>
