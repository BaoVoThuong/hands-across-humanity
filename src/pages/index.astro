---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import TestimonialSection from '../components/home/TestimonialSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';

import h1 from '../assets/images/h1.jpg';
import h2 from '../assets/images/h2.jpg';
import h3 from '../assets/images/h3.jpg';
import h4 from '../assets/images/h4.jpg';
import h5 from '../assets/images/h5.jpg';
import h6 from '../assets/images/h6.jpg';
import h7 from '../assets/images/h7.jpg';
import h8 from '../assets/images/h8.jpg';
import h9 from '../assets/images/h9.jpg';
import h10 from '../assets/images/h10.jpg';
import h11 from '../assets/images/h11.jpg';
import h12 from '../assets/images/h12.jpg';
import h13 from '../assets/images/h13.jpg';
import h14 from '../assets/images/h14.jpg';
import h15 from '../assets/images/h15.jpg';

const description = 'Hands Across Humanity is dedicated to rapidly collecting and distributing essential supplies and resources to children, families, veterans, older adults, and communities affected by disasters.';

const coreFocusCards = [
  {
    id: 'preparedness',
    title: 'Disaster Preparedness',
    category: 'Preparedness',
    location: 'Community & Outreach Centers',
    images: [
      { src: h1, alt: 'Volunteers leading community disaster preparedness and family education sessions.' },
      { src: h2, alt: 'Volunteers sharing outreach materials with community members.' }
    ],
    tag: 'Education & Outreach',
    impact: 'Education and outreach to help families, veterans, older adults, and children prepare for all-hazards events.',
    partner: 'Local Community Stakeholders',
    details: 'Equips vulnerable populations with critical knowledge, preparedness guidance, and resources to navigate catastrophic events and all-hazards situations before crisis strikes.'
  },
  {
    id: 'response',
    title: 'Rapid Response & Distribution',
    category: 'Rapid Aid',
    location: 'Disaster Impact Zones',
    images: [
      { src: h14, alt: 'Volunteers deploying essential supplies via transport fleet.' },
      { src: h10, alt: 'Staging health, wellness, and essential goods for distribution.' },
      { src: h9, alt: 'Outreach booth distributing critical supplies to residents.' }
    ],
    tag: 'Fleet & Volunteer Logistics',
    impact: 'Collecting donated products and supplies and delivering them efficiently to those struggling after disasters or catastrophic events.',
    partner: 'Dedicated Volunteer Network & Logistics Fleet',
    details: 'Mobilizes our transport fleet and volunteer network to stage and deliver donated supplies directly to children, families, veterans, and older adults in disaster-stricken areas.'
  },
  {
    id: 'recovery',
    title: 'Recovery Support',
    category: 'Rebuilding',
    location: 'Affected Communities',
    images: [
      { src: h7, alt: 'Volunteers and community elders reviewing essential goods for rebuilding.' },
      { src: h11, alt: 'Volunteers assisting community members with targeted recovery supplies.' }
    ],
    tag: 'Targeted Goods & Services',
    impact: 'Assisting individuals and partner organizations in the rebuilding process with targeted goods and services.',
    partner: 'Local Stakeholders & Community Alliances',
    details: 'Focuses on long-term stability by providing targeted products, emergency goods, and rebuilding services to help individuals and partner organizations restore their lives.'
  },
  {
    id: 'business',
    title: 'Partnership Development',
    category: 'Public-Private',
    location: 'Corporate & Industry Network',
    images: [
      { src: h12, alt: 'Corporate partners and volunteers collaborating at relief staging area.' },
      { src: h15, alt: 'Partner organization teams supporting distribution logistics.' }
    ],
    tag: 'Scalable Corporate Alliances',
    impact: 'Building lasting alliances with small, mid-size, and large businesses to deploy goods and services at scale.',
    partner: 'Small, Mid-Size & Large Businesses',
    details: 'Turns corporate surplus into vital lifelines by establishing transparent, scalable partnerships with businesses committed to placing resources into the right hands.'
  },
  {
    id: 'faith',
    title: 'Community & Faith Partnerships',
    category: 'Faith & Civic',
    location: 'Houses of Worship & Civic Hubs',
    images: [
      { src: h5, alt: 'Volunteers and faith leaders coordinating community relief items.' },
      { src: h13, alt: 'Community group gathered together for direct non-discriminatory distribution.' }
    ],
    tag: 'Non-Discriminatory Action',
    impact: 'Collaborating with houses of worship and community stakeholders on a non-discriminatory basis to extend reach and trust.',
    partner: 'Houses of Worship & Civic Organizations',
    details: 'Works closely with local faith centers and community leaders to build trust, deepen engagement, and ensure non-discriminatory aid delivery across every neighborhood.'
  }
];

const processSteps = [
  { num: '01', title: 'Strategic Collection & Staging', text: 'Collecting donated products and partnering with businesses of every size to turn surplus into lifelines.' },
  { num: '02', title: 'Rapid Fleet & Volunteer Logistics', text: 'Mobilizing our dedicated transport fleet and volunteer network for swift, efficient disaster response.' },
  { num: '03', title: 'Non-Discriminatory Aid Distribution', text: 'Collaborating with houses of worship and local stakeholders to deliver supplies directly to children, families, seniors & veterans.' },
  { num: '04', title: 'Targeted Recovery Support', text: 'Assisting individuals and partner organizations in long-term rebuilding, reducing long-term costs of recovery.' }
];

const testimonials = [
  {
    quote: '“Partnering with Hands Across Humanity ensures our surplus products and supplies directly reach children, families, veterans, and older adults struggling after catastrophic events.”',
    name: 'Corporate Resource Partner',
    role: 'Public-Private Alliance Representative',
    organization: 'Business & Enterprise Network',
    location: 'Houston & Nationwide',
    category: 'foundations',
    verified: true,
    verifiedText: 'Corporate Alliance',
    projectId: 'business',
    projectTitle: 'Partnership Development',
    initials: 'CP',
    accentColor: 'var(--primary)'
  },
  {
    quote: '“Collaborating on a non-discriminatory basis allows houses of worship and community stakeholders to extend reach, build trust, and deliver direct relief where needed most.”',
    name: 'Community Faith Stakeholder',
    role: 'Faith & Civic Coordinator',
    organization: 'Community & Faith Network',
    location: 'Regional Hubs',
    category: 'field-leaders',
    verified: true,
    verifiedText: 'Faith Partner',
    projectId: 'faith',
    projectTitle: 'Community & Faith Partnerships',
    initials: 'FP',
    accentColor: 'var(--emerald)'
  },
  {
    quote: '“When disaster strikes, speed, coordination, and the right supplies in the right hands make the difference between recovery and prolonged hardship.”',
    name: 'Disaster Relief Logistics Lead',
    role: 'Fleet & Dispatch Coordinator',
    organization: 'Volunteer & Fleet Network',
    location: 'Disaster Impact Zones',
    category: 'field-leaders',
    verified: true,
    verifiedText: 'Logistics Partner',
    projectId: 'response',
    projectTitle: 'Rapid Response Operations',
    avatar: h15
  }
];

const faqs = [
  {
    category: 'Mission & Focus',
    q: 'Who does Hands Across Humanity serve?',
    a: 'We rapidly collect and distribute essential supplies to children, families, veterans, older adults, and communities affected by disasters, all-hazards events, and catastrophic situations.'
  },
  {
    category: 'Logistics & Fleet',
    q: 'How does Hands Across Humanity ensure rapid aid distribution?',
    a: 'Through efficient logistics supported by our dedicated transport fleet and volunteer network, we swiftly stage and deliver donated supplies directly to those in need.'
  },
  {
    category: 'Partnerships',
    q: 'How do businesses and houses of worship collaborate with Hands Across Humanity?',
    a: 'We build lasting alliances with small, mid-size, and large businesses to deploy goods at scale, while collaborating with houses of worship and community stakeholders on a non-discriminatory basis.'
  },
  {
    category: 'Accountability',
    q: 'What principles guide your humanitarian operations?',
    a: 'Our model is built on scalability, transparency, clear logistics, volunteer and fleet capacity, and an unwavering commitment to serving every community without discrimination.'
  }
];
---

<SiteLayout
  title="Hands Across Humanity | Direct & Transparent Humanitarian Action"
  description={description}
>
  <main id="main">
    <div class="hero-fold-group">
      <HeroSection />
    </div>
    <ProcessSection steps={processSteps} />
    <TestimonialSection testimonials={testimonials} />
    <FaqSection faqs={faqs} />
    <ClosingCTA />
  </main>
</SiteLayout>
