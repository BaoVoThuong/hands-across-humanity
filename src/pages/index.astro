  { num: '03', title: 'Non-Discriminatory Aid Distribution', text: 'Collaborating with faith & local stakeholders to deliver supplies directly to children, families, seniors & veterans.' },
  { num: '04', title: 'Transparent Recovery Support', text: 'Assisting in long-term rebuilding with targeted goods, creating measurable value and transparent accountability.' }
];

