---
import SiteLayout from '../layouts/SiteLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ImpactBand from '../components/home/ImpactBand.astro';
import AboutFieldNotes from '../components/home/AboutFieldNotes.astro';
import AboutFocusAreas from '../components/home/AboutFocusAreas.astro';
import AboutNetworkSection from '../components/home/AboutNetworkSection.astro';
import ClosingCTA from '../components/home/ClosingCTA.astro';
import DonationSection from '../components/home/DonationSection.astro';
import { pageOf } from '../lib/pages';

/* The entry page tells the story in the order a first-time visitor needs it:
   who this is, how support moves, proof that it happens, how to take part —
   and only then one place to give. It used to offer nine ways to give before
   showing a single dated activity. */

const description = 'Hands Across Humanity is a community donation network in the Houston area, connecting useful goods, volunteers, businesses, and local partners with people who need practical support.';
---

<SiteLayout
  activePage="about-us"
  title={pageOf('about-us')!.documentTitle}
  description={description}
>
  <main id="main">
    <div class="hero-fold-group">
      <HeroSection />
      <ImpactBand />
    </div>
    <AboutFieldNotes />
    <AboutFocusAreas />
    <AboutNetworkSection />
    <DonationSection />
    <ClosingCTA />
  </main>
</SiteLayout>
