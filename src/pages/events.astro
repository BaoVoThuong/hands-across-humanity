---
import EditorialPage from '../components/EditorialPage.astro';
import type { HeroSignal } from '../components/HeroSignals.astro';
import Panel from '../components/Panel.astro';
import DonationMoment from '../components/DonationMoment.astro';
import UpcomingTable from '../components/events/UpcomingTable.astro';
import JoinDialog from '../components/events/JoinDialog.astro';
import PhotoArchive from '../components/events/PhotoArchive.astro';
import { getEvents, periodLabel } from '../lib/events';
import { CONTACT_EMAIL } from '../lib/pages';
import {
  partnerTeam, volunteersOutdoorEvent, teamThankYou, communityPartnersGroup,
  reliefShipmentLoading, reliefShipmentRamp, reliefPallets, volunteerTeamOutdoor,
  clinicPartners, clinicTeamPortrait, communityHealthBriefing, hopeClinicRecognition,
  immunizationPartners, lionsClubVolunteers,
  communityRecognition, awardCeremonyStage, livingGivingAward, livingGivingAwardPortrait,
  podiumPresentation, communityRecognitionEvent, heritageMonthEvent, tasteOfAfricaGala,
  tasteOfAfricaGalaSpeaker,
  communityRoundtable, communityMeal, communityMealTwo, lionsClubGathering,
  communityOutdoorPartners, communityTeam, partnerPortrait, communityBoothGathering,
} from '../assets/images/eps';

const { upcoming, past } = await getEvents();
const notifyHref = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent('Tell me about the next event')}`;

// The full archive, grouped by what each photograph shows. PhotoArchive shows
// it as filterable thumbnails; the lightbox shows each frame uncropped. Titles
// name what is visible, including any organisation printed on a banner in the
// frame, and nothing that is not.
const fieldArchive = [
  {
    id: 'goods',
    title: 'Getting goods ready',
    photos: [
      { image: reliefShipmentLoading, title: 'Shipment loading',
        alt: 'A worker in a safety vest moving a pallet of boxed supplies into a delivery truck.' },
      { image: reliefShipmentRamp, title: 'At the loading ramp',
        alt: 'Shrink-wrapped pallets of boxed supplies on the lift gate of a delivery truck.' },
      { image: reliefPallets, title: 'Pallets staged',
        alt: 'Shrink-wrapped pallets of boxed supplies staged outside beside a delivery truck.' },
      { image: volunteerTeamOutdoor, title: 'Volunteer team',
        alt: 'A large team of volunteers in yellow shirts beside rows of filled orange bags.' },
    ],
  },
  {
    id: 'health',
    title: 'Health partners',
    photos: [
      { image: clinicTeamPortrait, title: 'Clinic partners',
        alt: 'Volunteers in navy shirts and clinic staff in white coats posing together in a clinic lobby.' },
      { image: clinicPartners, title: 'Clinic visit',
        alt: 'Two partners standing with a physician in a white coat in a clinic hallway.' },
      { image: communityHealthBriefing, title: 'Information session',
        alt: 'Two presenters speaking to a seated audience at a community information session.' },
      { image: hopeClinicRecognition, title: 'Recognition at a clinic',
        alt: 'A man holding a certificate between two women in front of a Hope Clinic banner.' },
      { image: lionsClubVolunteers, title: 'Lions Club volunteers',
        alt: 'Volunteers, including Lions Club members in purple, smiling together at a community event.' },
      { image: immunizationPartners, title: 'Immunization partnership',
        alt: 'Three partners standing in front of an Immunization Partnership event backdrop.' },
    ],
  },
  {
    id: 'recognition',
    title: 'Celebrations and recognition',
    photos: [
      { image: livingGivingAward, title: 'Foundation award',
        alt: 'Partners and a child holding a plaque, gathered in front of Living & Giving Foundation banners.' },
      { image: awardCeremonyStage, title: 'Award presentation',
        alt: 'Five people on a stage, one holding a framed award, at a formal ceremony.' },
      { image: communityRecognition, title: 'Certificate moment',
        alt: 'Four adults standing with a certificate in front of red paper-crane artwork.' },
      { image: podiumPresentation, title: 'Community presentation',
        alt: 'A group holding white envelopes around a speaker at a podium in a hotel meeting room.' },
      { image: communityRecognitionEvent, title: 'Heritage month celebration',
        alt: 'A large group posing in front of a red heritage-month celebration backdrop.' },
      { image: heritageMonthEvent, title: 'Heritage month gathering',
        alt: 'Three people standing in front of a display for Asian American Pacific Islander Heritage Month.' },
      { image: livingGivingAwardPortrait, title: 'Foundation award, closer',
        alt: 'A smaller group with a child holding a plaque in front of Living & Giving Foundation banners.' },
      { image: tasteOfAfricaGala, title: 'Taste of Africa Gala',
        alt: 'Six women, several in African prints, posing before the Taste of Africa Gala backdrop.' },
      { image: tasteOfAfricaGalaSpeaker, title: 'Gala speaker',
        alt: 'A speaker at a podium beside a screen reading Taste of Africa Gala.' },
    ],
  },
  {
    id: 'together',
    title: 'Time together',
    photos: [
      { image: lionsClubGathering, title: 'Partner gathering',
        alt: 'Community partners gathered beneath a Lions Club banner.' },
      { image: communityOutdoorPartners, title: 'Outside the venue',
        alt: 'Two community partners standing together outside a public gathering.' },
      { image: communityRoundtable, title: 'Community roundtable',
        alt: 'A large group of adults seated around a dinner table during a community gathering.' },
      { image: communityMeal, title: 'Community meal',
        alt: 'Community members gathered around a table during a shared meal.' },
      { image: partnerPortrait, title: 'Partner portrait',
        alt: 'Three community partners standing together indoors at a public gathering.' },
      { image: communityMealTwo, title: 'Shared table',
        alt: 'Community members gathered for a meal around a restaurant table.' },
      { image: communityBoothGathering, title: 'Event booth',
        alt: 'A group of adults and children gathered in front of a CW39 Houston event tent in a public hall.' },
      { image: communityTeam, title: 'Community team',
        alt: 'Six community partners standing together at an indoor community event.' },
      { image: communityPartnersGroup, title: 'Partners and families',
        alt: 'Community partners, families and a child holding a toy panda at an indoor gathering.' },
    ],
  },
];

const sections = [
  { id: 'top', label: 'Events' },
  { id: 'upcoming', label: 'Upcoming events' },
  { id: 'field-record', label: 'Field record' }
];

// The signals describe what this page holds. They used to promise
// distribution days and partner drives while the table listed health fairs and
// festivals hosted by partners.
const heroSignals: HeroSignal[] = [
  { icon: 'handshake', title: 'Hosted by partners', text: 'We take part in events run by local partners.' },
  upcoming.length
    ? { icon: 'calendar', title: 'Come and find us', text: 'Upcoming dates and addresses are listed below.' }
    : { icon: 'calendar', title: 'Next dates', text: 'Nothing is scheduled yet. Ask us to tell you when it is.' },
  { icon: 'camera', title: 'Recent work', text: past.length ? `Photographs and activity from ${periodLabel(past)}.` : 'Photographs from recent community work.' }
];
---

<EditorialPage
  activePage="events"
  title="Where the work actually happens."
  lead="Events we take part in with local partners — where to find us next, and what recent work has looked like."
  description="Upcoming community events Hands Across Humanity is taking part in, and a look at recent distribution work."
  heroVariant="mosaic"
  image={partnerTeam}
  gallery={[
    { src: volunteersOutdoorEvent, alt: 'Two volunteers in navy shirts at an outdoor pavilion event.' },
    { src: teamThankYou, alt: 'Four team members behind boxed electronics under a thank-you banner.' },
  ]}
  imageAlt="Three partners, two in yellow shirts, standing together at an outdoor community event."
  caption="Partners at an outdoor community event."
  heroSignals={heroSignals}
  sections={sections}
  total={3}
>
  <!-- 02: Upcoming -->
  <Panel id="upcoming" ground="sand" index={2} total={3} label="Upcoming events"
    labelledby="upcoming-title" nextId="field-record" nextLabel="Field record">
    <div class="panel-head panel-head--split">
      <div class="panel-head__title">
        <h2 class="reveal" style="--i:1" id="upcoming-title">Come and find us.</h2>
      </div>
      <p class="lead reveal" style="--i:2">
        {upcoming.length
          ? 'These events are hosted by community partners and we take part in them. Let us know you are coming and we will look out for you.'
          : 'The events we take part in are hosted by community partners, so dates appear here once a partner confirms them.'}
      </p>
    </div>

    {upcoming.length ? (
      <div class="reveal" style="--i:3">
        <UpcomingTable events={upcoming} />
      </div>
    ) : (
      /* With nothing scheduled, say so plainly and offer the one useful next
         step. Three generic steps used to sit here, so a visitor sent by
         "Upcoming events" never learned the calendar was empty. */
      <div class="events-empty reveal" style="--i:3">
        <div class="events-empty__copy">
          <h3 class="events-empty__title">No upcoming events are scheduled yet.</h3>
          <p class="events-empty__text">
            New dates are added as partners confirm them. Email us and we will tell you
            when the next one is set{past.length ? ` — or see what we did in ${periodLabel(past)}` : ''}.
          </p>
        </div>
        <div class="events-empty__actions">
          <a class="btn btn--primary" href={notifyHref}>
            Tell me about the next event<span class="btn__arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--secondary" href="#field-record">See recent work</a>
        </div>
      </div>
    )}
  </Panel>

  <!-- 03: Field record — also where every "see recent work" link lands -->
  <Panel id="field-record" ground="ink" index={3} total={3} label="Field record"
    labelledby="field-record-title" ctaHref="/vision/" ctaLabel="Read our vision">
    <div class="panel-head panel-head--split field-record__head">
      <div class="panel-head__title">
        <h2 class="reveal" style="--i:1" id="field-record-title">The work is made of many small rooms.</h2>
      </div>
      <p class="lead reveal" style="--i:2">
        The people, partnerships, preparation, and shared time behind each community handoff{past.length ? `, ${periodLabel(past)}` : ''}. Choose a group, or open any photograph to see it whole.
      </p>
    </div>

    <div class="reveal" style="--i:3">
      <PhotoArchive groups={fieldArchive} />
    </div>
  </Panel>

  <!-- The ask follows the evidence it relies on. -->
  <DonationMoment
    title="Help keep community support ready."
    text="A one-time gift or monthly support helps strengthen the work around the events we take part in."
    ctaLabel="Support community activity"
    href="/donate/?focus=community"
  />

  <JoinDialog />
</EditorialPage>
