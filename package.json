{
  "name": "hands-across-humanity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:placeholders": "! grep -rnE '\\[[A-Z][^]]*\\]' dist --include='*.html'",
    "check:empty": "! grep -rnE '<(p|li|dd|dt|figcaption|span|h[1-6])>[[:space:]]*</\\1>' dist --include='*.html'",
    "check:images": "node scripts/check-images.mjs",
    "prelaunch": "npm run build && npm run check:placeholders && npm run check:empty && npm run check:images"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/vercel": "^11.0.22",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.2.5",
    "@stripe/stripe-js": "^10.3.0",
    "astro": "^7.2.4",
    "sharp": "^0.35.3",
    "stripe": "^23.2.0",
    "typescript": "^6.0.3"
  }
}
