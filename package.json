{
  "name": "hands-across-humanity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:placeholders": "! grep -rnE '\\[[A-Z][^]]*\\]' dist --include='*.html'",
    "check:empty": "! grep -rnE '<(p|li|dd|dt|figcaption|span|h[1-6])>[[:space:]]*</\\1>' dist --include='*.html'",
    "prelaunch": "npm run build && npm run check:placeholders && npm run check:empty"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/newsreader": "^5.2.6",
    "@fontsource-variable/public-sans": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.8",
    "astro": "^7.2.4",
    "sharp": "^0.35.3"
  }
}
