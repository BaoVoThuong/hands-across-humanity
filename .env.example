# Apps Script web app that appends sign-ups to the `attendance` tab.
# Deploy → New deployment → Web app → Execute as: Me, Access: Anyone.
# Copy the URL that ends in /exec and paste it here.
#
# Leave this blank and the sign-up form does not render at all; the events
# page shows a contact email instead. A form that cannot submit is worse
# than no form.
PUBLIC_ATTENDANCE_ENDPOINT=

# Stripe API keys (Dashboard → Developers → API keys). Use the test pair
# (sk_test_… / pk_test_…) while testing, the live pair in production.
#
# STRIPE_SECRET_KEY is SERVER ONLY — never prefix it with PUBLIC_.
# PUBLIC_STRIPE_PUBLISHABLE_KEY is meant for the browser: Stripe.js uses it to
# show the payment form embedded on /donate/.
#
# Both are needed. Leave either blank and every donate button opens an email
# instead, and the site says "Ways to give" rather than "Donate now".
# Changing them on Vercel needs a redeploy, because pages are prerendered.
STRIPE_SECRET_KEY=
PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional. Stripe customer-portal login link (Settings → Billing → Customer
# portal → "Login link"), shown to monthly donors on the thank-you page so they
# can update their card or cancel. Blank: they are pointed to email instead.
PUBLIC_STRIPE_PORTAL_URL=

# Dev only. STRIPE_MOCK=1 puts a local placeholder where Stripe's embedded
# form would appear (/api/mock-checkout), so the donate flow can be tested
# without an account.
# Ignored by production builds.
STRIPE_MOCK=
