# Apps Script web app that appends sign-ups to the `attendance` tab.
# Deploy → New deployment → Web app → Execute as: Me, Access: Anyone.
# Copy the URL that ends in /exec and paste it here.
#
# Leave this blank and the sign-up form does not render at all; the events
# page shows a contact email instead. A form that cannot submit is worse
# than no form.
PUBLIC_ATTENDANCE_ENDPOINT=
